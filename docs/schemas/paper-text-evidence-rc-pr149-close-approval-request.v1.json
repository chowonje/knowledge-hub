{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-text-evidence-rc-pr149-close-approval-request.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "scope",
    "inputReports",
    "approvalRequest",
    "pullRequest149",
    "blockerRows",
    "blockers",
    "nextAction",
    "mutationCounters",
    "schemaViolationCount",
    "privatePathLeakRows",
    "reportHash",
    "warnings",
    "schemaErrors"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.text-evidence-rc-pr149-close-approval-request.v1" },
    "status": { "enum": ["ready_for_user_decision", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "pullRequestMutationPerformed",
        "canonicalCheckoutEdited",
        "destructiveCleanupRows",
        "vaultScanRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "externalDownloadRows",
        "mergeRows",
        "cherryPickRows",
        "worktreeDeletionRows"
      ],
      "properties": {
        "writes": { "const": "report_only" },
        "pullRequestMutationPerformed": { "const": false },
        "canonicalCheckoutEdited": { "const": false },
        "destructiveCleanupRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "mergeRows": { "const": 0 },
        "cherryPickRows": { "const": 0 },
        "worktreeDeletionRows": { "const": 0 }
      }
    },
    "inputReports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalActionPreflightReportRef",
        "externalActionPreflightStatus",
        "externalActionPreflightReady"
      ],
      "properties": {
        "externalActionPreflightReportRef": { "const": "text_evidence_rc_external_action_preflight.v1.json" },
        "externalActionPreflightStatus": { "type": "string" },
        "externalActionPreflightReady": { "type": "boolean" }
      }
    },
    "approvalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "targetRef",
        "requiresExplicitUserApproval",
        "userDecisionRequired",
        "executionStatus",
        "recommendedDecision",
        "commandPreview",
        "closeComment",
        "safeToExecuteAfterApproval"
      ],
      "properties": {
        "actionId": { "const": "close_pr149_without_merge" },
        "targetRef": { "const": "github_pr_149" },
        "requiresExplicitUserApproval": { "const": true },
        "userDecisionRequired": { "const": true },
        "executionStatus": { "const": "not_executed" },
        "recommendedDecision": { "const": "approve_close_without_merge" },
        "commandPreview": { "type": "string", "minLength": 1 },
        "closeComment": { "type": "string", "minLength": 1 },
        "safeToExecuteAfterApproval": { "type": "boolean" }
      }
    },
    "pullRequest149": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "isDraft",
        "mergeable",
        "mergeStateStatus",
        "headRefName",
        "baseRefName",
        "expectedHoldState"
      ],
      "properties": {
        "state": { "type": "string" },
        "isDraft": { "type": "boolean" },
        "mergeable": { "type": "string" },
        "mergeStateStatus": { "type": "string" },
        "headRefName": { "type": "string" },
        "baseRefName": { "type": "string" },
        "expectedHoldState": { "type": "boolean" }
      }
    },
    "blockerRows": { "type": "integer", "minimum": 0 },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockerId", "reason"],
        "properties": {
          "blockerId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nextAction": {
      "enum": [
        "await_user_yes_to_close_pr149_without_merge",
        "refresh_external_action_preflight_before_close_request"
      ]
    },
    "mutationCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalPrMutationRows",
        "canonicalCleanupRows",
        "destructiveCleanupRows",
        "canonicalParsedArtifactWriteRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "externalDownloadRows",
        "mergeRows",
        "cherryPickRows",
        "worktreeDeletionRows",
        "runtimeAnswerVisibleExposureRows",
        "strictEvidencePromotionRows"
      ],
      "properties": {
        "externalPrMutationRows": { "const": 0 },
        "canonicalCleanupRows": { "const": 0 },
        "destructiveCleanupRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "mergeRows": { "const": 0 },
        "cherryPickRows": { "const": 0 },
        "worktreeDeletionRows": { "const": 0 },
        "runtimeAnswerVisibleExposureRows": { "const": 0 },
        "strictEvidencePromotionRows": { "const": 0 }
      }
    },
    "schemaViolationCount": { "const": 0 },
    "privatePathLeakRows": { "const": 0 },
    "reportHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "schemaErrors": { "type": "array", "items": { "type": "string" } }
  }
}
