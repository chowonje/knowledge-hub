{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-hub.paper.equation-authority-contract-design.v1",
  "title": "Equation Authority Contract Design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "input",
    "counts",
    "gate",
    "policy",
    "warnings",
    "inputBlockers",
    "rows"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.equation-authority-contract-design.v1" },
    "status": { "type": "string", "enum": ["ok", "blocked"] },
    "generatedAt": { "type": "string" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paperIds",
        "equationAuthorityHashIdentityDesignReportPath",
        "equationAuthorityHashIdentityDesignReportSchema",
        "equationAuthorityHashIdentityDesignReportExists",
        "equationAuthorityHashIdentityDesignReportStrictSchemaValid"
      ],
      "properties": {
        "paperIds": { "type": "array", "items": { "type": "string" } },
        "equationAuthorityHashIdentityDesignReportPath": { "type": "string" },
        "equationAuthorityHashIdentityDesignReportSchema": { "type": "string" },
        "equationAuthorityHashIdentityDesignReportExists": { "type": "boolean" },
        "equationAuthorityHashIdentityDesignReportStrictSchemaValid": { "type": "boolean" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputRows",
        "targetRows",
        "equationAuthorityContractCandidateOnlyRows",
        "blockedMissingDesignIdentityRows",
        "blockedMissingDesignHashRows",
        "blockedMissingSourceHashRows",
        "blockedAmbiguousEquationMatchRows",
        "blockedRasterOnlyEquationRows",
        "heldOutNonContractDesignBlockerRows",
        "blockedInputReportMissingRows",
        "blockedInputSchemaViolationRows",
        "authorityPolicyCreatedRows",
        "equationAuthorityRecordWrittenRows",
        "equationArtifactCreatedRows",
        "strictEvidenceCreatedRows",
        "sourceSpanMutatedRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "parserRoutingChangedRows",
        "answerIntegrationChangedRows",
        "inputBlockerCount",
        "byContractStatus",
        "byInputDesignStatus",
        "byReadinessStatus",
        "byPaper",
        "byEnvironment"
      ],
      "properties": {
        "inputRows": { "type": "integer", "minimum": 0 },
        "targetRows": { "type": "integer", "minimum": 0 },
        "equationAuthorityContractCandidateOnlyRows": { "type": "integer", "minimum": 0 },
        "blockedMissingDesignIdentityRows": { "type": "integer", "minimum": 0 },
        "blockedMissingDesignHashRows": { "type": "integer", "minimum": 0 },
        "blockedMissingSourceHashRows": { "type": "integer", "minimum": 0 },
        "blockedAmbiguousEquationMatchRows": { "type": "integer", "minimum": 0 },
        "blockedRasterOnlyEquationRows": { "type": "integer", "minimum": 0 },
        "heldOutNonContractDesignBlockerRows": { "type": "integer", "minimum": 0 },
        "blockedInputReportMissingRows": { "type": "integer", "minimum": 0 },
        "blockedInputSchemaViolationRows": { "type": "integer", "minimum": 0 },
        "authorityPolicyCreatedRows": { "const": 0 },
        "equationAuthorityRecordWrittenRows": { "const": 0 },
        "equationArtifactCreatedRows": { "const": 0 },
        "strictEvidenceCreatedRows": { "const": 0 },
        "sourceSpanMutatedRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "parserRoutingChangedRows": { "const": 0 },
        "answerIntegrationChangedRows": { "const": 0 },
        "inputBlockerCount": { "type": "integer", "minimum": 0 },
        "byContractStatus": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byInputDesignStatus": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byReadinessStatus": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byPaper": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byEnvironment": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractDesignRows",
        "equationAuthorityRecordContractReady",
        "equationAuthorityRecordWriteReady",
        "equationAuthorityPromotionReady",
        "equationArtifactCreationReady",
        "strictEvidenceReady",
        "sourceSpanMutationReady",
        "parserRoutingReady",
        "answerIntegrationReady",
        "runtimePromotionAllowed",
        "decision",
        "recommendedNextTranche",
        "inputBlockers"
      ],
      "properties": {
        "contractDesignRows": { "type": "boolean" },
        "equationAuthorityRecordContractReady": { "const": false },
        "equationAuthorityRecordWriteReady": { "const": false },
        "equationAuthorityPromotionReady": { "const": false },
        "equationArtifactCreationReady": { "const": false },
        "strictEvidenceReady": { "const": false },
        "sourceSpanMutationReady": { "const": false },
        "parserRoutingReady": { "const": false },
        "answerIntegrationReady": { "const": false },
        "runtimePromotionAllowed": { "const": false },
        "decision": { "type": "string" },
        "recommendedNextTranche": { "type": "string" },
        "inputBlockers": { "type": "array", "items": { "$ref": "#/$defs/inputBlocker" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportOnly",
        "contractOnly",
        "classificationOnly",
        "authorityPolicyCreated",
        "equationAuthorityRecordWritten",
        "equationIdentityPromoted",
        "equationHashPromoted",
        "equationArtifactCreated",
        "strictEvidenceCreated",
        "sourceSpanMutation",
        "databaseMutation",
        "indexMutation",
        "vaultScan",
        "reindexOrReembed",
        "parserRoutingChanged",
        "answerIntegrationChanged",
        "canonicalParsedArtifactsWritten",
        "equationInterpretationAllowed"
      ],
      "properties": {
        "reportOnly": { "const": true },
        "contractOnly": { "const": true },
        "classificationOnly": { "const": true },
        "authorityPolicyCreated": { "const": false },
        "equationAuthorityRecordWritten": { "const": false },
        "equationIdentityPromoted": { "const": false },
        "equationHashPromoted": { "const": false },
        "equationArtifactCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "sourceSpanMutation": { "const": false },
        "databaseMutation": { "const": false },
        "indexMutation": { "const": false },
        "vaultScan": { "const": false },
        "reindexOrReembed": { "const": false },
        "parserRoutingChanged": { "const": false },
        "answerIntegrationChanged": { "const": false },
        "canonicalParsedArtifactsWritten": { "const": false },
        "equationInterpretationAllowed": { "const": false }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "inputBlockers": { "type": "array", "items": { "$ref": "#/$defs/inputBlocker" } },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/contractRow" } }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "equation_authority_contract_candidate_only",
        "blocked_missing_design_identity",
        "blocked_missing_design_hash",
        "blocked_missing_source_hash",
        "blocked_ambiguous_equation_match",
        "blocked_raster_only_equation",
        "held_out_non_contract_design_blocker",
        "blocked_input_report_missing",
        "blocked_input_schema_violation"
      ]
    },
    "inputBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputName", "inputLabel", "path", "contract_status", "detail"],
      "properties": {
        "inputName": { "type": "string" },
        "inputLabel": { "type": "string" },
        "path": { "type": "string" },
        "contract_status": { "$ref": "#/$defs/status" },
        "detail": { "type": "string" }
      }
    },
    "plannedRecordContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractOnly",
        "futureRecordSchema",
        "plannedWriteTarget",
        "storeKind",
        "storeRootTemplate",
        "recordPathTemplate",
        "requiredRecordFields",
        "idempotencyKeyFields",
        "readbackChecks",
        "executorImplemented",
        "rollbackImplemented",
        "runtimeUseAllowed",
        "parserRoutingAllowed",
        "answerIntegrationAllowed",
        "databaseMutationAllowed",
        "vaultScanAllowed"
      ],
      "properties": {
        "contractOnly": { "const": true },
        "futureRecordSchema": { "const": "knowledge-hub.paper.equation-authority-record.v1" },
        "plannedWriteTarget": { "const": "equation_authority_record_candidate_store" },
        "storeKind": { "type": "string" },
        "storeRootTemplate": { "type": "string" },
        "recordPathTemplate": { "type": "string" },
        "requiredRecordFields": { "type": "array", "items": { "type": "string" } },
        "idempotencyKeyFields": { "type": "array", "items": { "type": "string" } },
        "readbackChecks": { "type": "array", "items": { "type": "string" } },
        "executorImplemented": { "const": false },
        "rollbackImplemented": { "const": false },
        "runtimeUseAllowed": { "const": false },
        "parserRoutingAllowed": { "const": false },
        "answerIntegrationAllowed": { "const": false },
        "databaseMutationAllowed": { "const": false },
        "vaultScanAllowed": { "const": false }
      }
    },
    "contractRecordPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "equationAuthorityRecordId",
        "paperId",
        "sourceCandidateId",
        "sourceTexRowId",
        "sourceContentHash",
        "equationIdentityDigestSha256",
        "equationHashSha256",
        "equationTextNormalization",
        "hashSource",
        "readinessAuditRowId",
        "hashIdentityDesignRowId",
        "pdfRegionSnapshot",
        "canonicalAlignmentSnapshot",
        "ambiguitySnapshot",
        "provenanceTrace",
        "authorityState",
        "runtimeVisible",
        "answerIntegrationVisible",
        "equationArtifactCreated",
        "strictEvidenceCreated",
        "idempotencyKey",
        "writePolicy"
      ],
      "properties": {
        "schema": { "const": "knowledge-hub.paper.equation-authority-record.v1" },
        "equationAuthorityRecordId": { "type": "string" },
        "paperId": { "type": "string" },
        "sourceCandidateId": { "type": "string" },
        "sourceTexRowId": { "type": "string" },
        "sourceContentHash": { "type": "string" },
        "equationIdentityDigestSha256": { "type": "string" },
        "equationHashSha256": { "type": "string" },
        "equationTextNormalization": { "type": "string" },
        "hashSource": { "type": "string" },
        "readinessAuditRowId": { "type": "string" },
        "hashIdentityDesignRowId": { "type": "string" },
        "pdfRegionSnapshot": { "type": "object" },
        "canonicalAlignmentSnapshot": { "type": "object" },
        "ambiguitySnapshot": { "type": "object" },
        "provenanceTrace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hashIdentityDesignRowId", "readinessAuditRowId", "sourceCandidateId"],
          "properties": {
            "hashIdentityDesignRowId": { "type": "string" },
            "readinessAuditRowId": { "type": "string" },
            "sourceCandidateId": { "type": "string" }
          }
        },
        "authorityState": { "const": "contract_design_candidate_only" },
        "runtimeVisible": { "const": false },
        "answerIntegrationVisible": { "const": false },
        "equationArtifactCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "idempotencyKey": { "type": "string" },
        "writePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recordWrite",
            "equationArtifactCreation",
            "strictEvidenceCreation",
            "sourceSpanMutation",
            "runtimeVisibility",
            "answerIntegrationVisibility"
          ],
          "properties": {
            "recordWrite": { "const": false },
            "equationArtifactCreation": { "const": false },
            "strictEvidenceCreation": { "const": false },
            "sourceSpanMutation": { "const": false },
            "runtimeVisibility": { "const": false },
            "answerIntegrationVisibility": { "const": false }
          }
        }
      }
    },
    "contractRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_row_id",
        "candidate_type",
        "hash_identity_design_row_id",
        "readiness_audit_row_id",
        "paper_id",
        "source_candidate_id",
        "source_file",
        "equation_environment",
        "input_design_status",
        "readiness_status",
        "sourceContentHash",
        "equation_identity",
        "proposed_identity_design",
        "proposed_hash_design",
        "pdf_region_signal",
        "canonical_text_alignment",
        "surrounding_context",
        "ambiguity",
        "raster_image_only_blocker",
        "planned_record_contract",
        "contract_record_preview",
        "contract_status",
        "blockers",
        "recommended_action",
        "authorityPolicyCreated",
        "equationAuthorityRecordWritten",
        "equationArtifactCreated",
        "strictEvidenceCreated",
        "sourceSpanMutated",
        "databaseMutation",
        "indexMutation",
        "reindexOrReembed",
        "vaultScan",
        "parserRoutingChanged",
        "answerIntegrationChanged"
      ],
      "properties": {
        "contract_row_id": { "type": "string" },
        "candidate_type": { "const": "equation_authority_contract_design" },
        "hash_identity_design_row_id": { "type": "string" },
        "readiness_audit_row_id": { "type": "string" },
        "paper_id": { "type": "string" },
        "source_candidate_id": { "type": "string" },
        "source_file": { "type": "string" },
        "equation_environment": { "type": "string" },
        "input_design_status": { "type": "string" },
        "readiness_status": { "type": "string" },
        "sourceContentHash": { "type": "string" },
        "equation_identity": { "type": "object" },
        "proposed_identity_design": { "type": "object" },
        "proposed_hash_design": { "type": "object" },
        "pdf_region_signal": { "type": "object" },
        "canonical_text_alignment": { "type": "object" },
        "surrounding_context": { "type": "object" },
        "ambiguity": { "type": "object" },
        "raster_image_only_blocker": { "type": "boolean" },
        "planned_record_contract": { "$ref": "#/$defs/plannedRecordContract" },
        "contract_record_preview": { "$ref": "#/$defs/contractRecordPreview" },
        "contract_status": { "$ref": "#/$defs/status" },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "recommended_action": { "type": "string" },
        "authorityPolicyCreated": { "const": false },
        "equationAuthorityRecordWritten": { "const": false },
        "equationArtifactCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "sourceSpanMutated": { "const": false },
        "databaseMutation": { "const": false },
        "indexMutation": { "const": false },
        "reindexOrReembed": { "const": false },
        "vaultScan": { "const": false },
        "parserRoutingChanged": { "const": false },
        "answerIntegrationChanged": { "const": false }
      }
    }
  }
}
