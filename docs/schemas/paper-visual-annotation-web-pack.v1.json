{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-visual-annotation-web-pack.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "packId",
    "sourceReport",
    "scope",
    "selectionPolicy",
    "prompt",
    "counts",
    "packRowsDetail",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.visual-annotation-web-pack.v1" },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["ready_for_manual_web_vlm_calibration", "blocked"] },
    "nextRecommendedTranche": { "const": "visual_annotation_web_pack_manual_calibration" },
    "packId": { "type": "string", "minLength": 1 },
    "sourceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "reportRef", "candidateRows"],
      "properties": {
        "schema": { "const": "knowledge-hub.paper.visual-layout-candidate-list-report.v1" },
        "status": { "enum": ["ready", "blocked"] },
        "reportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
        "candidateRows": { "type": "integer", "minimum": 0 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "apiCalls",
        "modelCalls",
        "webModelCalls",
        "vectorIndexing",
        "strictEvidencePromotionRows",
        "runtimeAnswerVisibleExposureRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "externalDownloadRows",
        "answerabilityGateBypassRows",
        "cropWriteRows",
        "canonicalParsedArtifactWriteRows"
      ],
      "properties": {
        "writes": { "const": "report_only" },
        "apiCalls": { "const": false },
        "modelCalls": { "const": false },
        "webModelCalls": { "const": false },
        "vectorIndexing": { "const": false },
        "strictEvidencePromotionRows": { "const": 0 },
        "runtimeAnswerVisibleExposureRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "answerabilityGateBypassRows": { "const": 0 },
        "cropWriteRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 }
      }
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packUse",
        "maxCandidateRows",
        "preferredPaperIds",
        "includedCandidateTypes",
        "excludedCandidateTypes",
        "cropPolicy",
        "imageAttachmentPolicy",
        "rationale"
      ],
      "properties": {
        "packUse": { "const": "manual_web_vlm_retrieval_hint_calibration" },
        "maxCandidateRows": { "type": "integer", "minimum": 1 },
        "preferredPaperIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "includedCandidateTypes": {
          "type": "array",
          "items": {
            "enum": [
              "figure_caption_region",
              "table_region",
              "equation_region",
              "layout_region",
              "image_region"
            ]
          }
        },
        "excludedCandidateTypes": {
          "type": "array",
          "items": {
            "enum": [
              "figure_caption_region",
              "table_region",
              "equation_region",
              "layout_region",
              "image_region"
            ]
          }
        },
        "cropPolicy": { "const": "planned_ref_only_no_crop_write" },
        "imageAttachmentPolicy": { "const": "manual_page_or_crop_attachment_only" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetSurface", "modelGuidance", "systemPrompt", "userPrompt", "outputShape"],
      "properties": {
        "targetSurface": { "const": "manual_web_vlm_calibration" },
        "modelGuidance": { "type": "string", "minLength": 1 },
        "systemPrompt": { "type": "string", "minLength": 1 },
        "userPrompt": { "type": "string", "minLength": 1 },
        "outputShape": {
          "type": "object",
          "additionalProperties": true,
          "required": ["schema", "rows"],
          "properties": {
            "schema": { "const": "knowledge-hub.paper.visual-annotation-web-output.v1" },
            "rows": { "type": "array" }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCandidateRows",
        "eligibleCandidateRows",
        "selectedCandidateRows",
        "selectedPaperRows",
        "excludedCandidateRows",
        "figureCandidateRows",
        "tableCandidateRows",
        "equationCandidateRows",
        "layoutCandidateRows",
        "imageCandidateRows",
        "blockedRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "properties": {
        "sourceCandidateRows": { "type": "integer", "minimum": 0 },
        "eligibleCandidateRows": { "type": "integer", "minimum": 0 },
        "selectedCandidateRows": { "type": "integer", "minimum": 0 },
        "selectedPaperRows": { "type": "integer", "minimum": 0 },
        "excludedCandidateRows": { "type": "integer", "minimum": 0 },
        "figureCandidateRows": { "type": "integer", "minimum": 0 },
        "tableCandidateRows": { "type": "integer", "minimum": 0 },
        "equationCandidateRows": { "type": "integer", "minimum": 0 },
        "layoutCandidateRows": { "type": "integer", "minimum": 0 },
        "imageCandidateRows": { "type": "integer", "minimum": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "privatePathLeakRows": { "const": 0 },
        "schemaViolationCount": { "const": 0 }
      }
    },
    "packRowsDetail": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "packCandidateId",
          "sourceCandidateId",
          "paperId",
          "paperRef",
          "sourceContentHash",
          "page",
          "bbox",
          "candidateType",
          "priority",
          "annotationTask",
          "webInput",
          "textContext",
          "visualContext",
          "retrievalHintPlan",
          "expectedOutputContract",
          "provenance",
          "blockerReason"
        ],
        "properties": {
          "schema": { "const": "knowledge-hub.paper.visual-annotation-web-pack-row.v1" },
          "packCandidateId": { "type": "string", "pattern": "^visual-annotation-web-pack:" },
          "sourceCandidateId": { "type": "string", "pattern": "^visual-layout:" },
          "paperId": { "type": "string", "minLength": 1 },
          "paperRef": { "type": "string", "pattern": "^papers_dir/[^/].*" },
          "sourceContentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "page": { "type": "integer", "minimum": 1 },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "candidateType": {
            "enum": [
              "figure_caption_region",
              "table_region",
              "equation_region",
              "layout_region",
              "image_region"
            ]
          },
          "priority": { "type": "integer", "minimum": 1 },
          "annotationTask": {
            "enum": [
              "describe_figure_caption_region_for_retrieval",
              "describe_table_region_for_retrieval",
              "describe_equation_region_for_retrieval",
              "describe_layout_region_for_retrieval",
              "describe_image_region_for_retrieval"
            ]
          },
          "webInput": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "copyPasteContext",
              "attachmentInstruction",
              "plannedAttachmentRef",
              "pageImageRequired"
            ],
            "properties": {
              "copyPasteContext": { "type": "string", "minLength": 1 },
              "attachmentInstruction": { "type": "string", "minLength": 1 },
              "plannedAttachmentRef": { "type": "string", "pattern": "^papers_dir/visual_layout_planned_crops/" },
              "pageImageRequired": { "type": "boolean" }
            }
          },
          "textContext": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nearbyText", "captionText", "headingPath"],
            "properties": {
              "nearbyText": { "type": "string" },
              "captionText": { "type": "string" },
              "headingPath": { "type": "array", "items": { "type": "string" } }
            }
          },
          "visualContext": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cropRef", "imageHash", "pageImageRequired"],
            "properties": {
              "cropRef": { "type": "string", "pattern": "^papers_dir/visual_layout_planned_crops/" },
              "imageHash": {
                "anyOf": [
                  { "const": "" },
                  { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                ]
              },
              "pageImageRequired": { "type": "boolean" }
            }
          },
          "retrievalHintPlan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetDerivedTextField",
              "allowedUse",
              "strictEvidence",
              "citationGrade",
              "answerableWithoutTextEvidence"
            ],
            "properties": {
              "targetDerivedTextField": { "const": "derivedTextForRetrieval" },
              "allowedUse": { "const": "retrieval_hint_only" },
              "strictEvidence": { "const": false },
              "citationGrade": { "const": false },
              "answerableWithoutTextEvidence": { "const": false }
            }
          },
          "expectedOutputContract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "requiredFields",
              "allowedUse",
              "strictEvidence",
              "citationGrade",
              "answerableWithoutTextEvidence"
            ],
            "properties": {
              "schema": { "const": "knowledge-hub.paper.visual-annotation-web-output-row.v1" },
              "requiredFields": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "allowedUse": { "const": "retrieval_hint_only" },
              "strictEvidence": { "const": false },
              "citationGrade": { "const": false },
              "answerableWithoutTextEvidence": { "const": false }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceReportSchema",
              "sourceCandidateId",
              "sourceContentHash",
              "page",
              "bbox",
              "extractionMethod"
            ],
            "properties": {
              "sourceReportSchema": { "const": "knowledge-hub.paper.visual-layout-candidate-list-report.v1" },
              "sourceCandidateId": { "type": "string", "pattern": "^visual-layout:" },
              "sourceContentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "page": { "type": "integer", "minimum": 1 },
              "bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "number" }
              },
              "extractionMethod": { "type": "string", "minLength": 1 }
            }
          },
          "blockerReason": { "const": "" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
