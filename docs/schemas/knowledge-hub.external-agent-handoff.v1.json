{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-hub.external-agent-handoff.v1",
  "type": "object",
  "required": [
    "agentKind",
    "mutationsAllowed",
    "khubCommandsAllowed",
    "vaultAccess",
    "importSteps"
  ],
  "properties": {
    "schema": {
      "const": "knowledge-hub.external-agent-handoff.v1"
    },
    "handoffId": {
      "type": "string",
      "minLength": 1
    },
    "agentKind": {
      "type": "string",
      "enum": ["external"]
    },
    "agentName": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifactRoot": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["report_only", "import_manifest_ready", "local_only"]
    },
    "mutationsAllowed": {
      "type": "boolean"
    },
    "khubCommandsAllowed": {
      "type": "object",
      "required": ["allowed", "commands"],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "vaultAccess": {
      "type": "object",
      "required": ["allowed", "paths"],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "knowledgeHubRepoRef": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sanitizedInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "classification", "purpose"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "classification": {
            "type": "string",
            "enum": ["public", "sanitized", "local_only"]
          },
          "purpose": { "type": "string" },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["report", "candidate_json", "csv", "import_manifest", "archive", "other"]
          },
          "schema": { "type": "string" },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "privacyGuards": {
      "type": "object",
      "properties": {
        "rawLocalInputExcluded": { "type": "boolean" },
        "privatePathExposureAllowed": { "type": "boolean" },
        "externalPrivateSourceRows": {
          "type": "integer",
          "minimum": 0
        },
        "vaultScanRows": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "importSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stepId",
          "description",
          "status",
          "command",
          "requiresOperatorApproval"
        ],
        "properties": {
          "stepId": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["proposed", "blocked", "completed", "failed", "skipped"]
          },
          "command": { "type": "string" },
          "requiresOperatorApproval": { "type": "boolean" },
          "error": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "operatorNotes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
