        "baselineExpectedMismatchRows",
        "baselineSourceFixtureMatchRows",
        "baselineSourceFixtureMismatchRows",
        "suppliedAnswerRows",
        "suppliedCitationRows",
        "syntheticStrictEvidenceRefRows",
        "answerGeneratedRows",
        "answerQualityScoreComputedRows",
        "scoreComputedRows",
        "llmCallRows",
        "judgeModelCallRows",
        "answerPathInvokedRows",
        "searchIndexQueriedRows",
        "databaseMutationRows",
        "indexMutationRows",
