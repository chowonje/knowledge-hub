        "reportOnly": { "const": true },
        "baselineOnly": { "const": true },
        "deterministicGraderBaselineOnly": { "const": true },
        "suppliedFixtureOnly": { "const": true },
        "syntheticStrictEvidenceRefsOnly": { "const": true },
        "strictEvidenceReadOnly": { "const": true },
        "deterministicBaselineVerdictRun": { "const": true },
