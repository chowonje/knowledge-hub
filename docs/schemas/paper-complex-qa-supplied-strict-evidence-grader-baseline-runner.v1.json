      "type": "object",
      "required": ["name", "version", "mode", "purpose", "nextRecommendedTranche"],
      "properties": {
        "name": { "const": "complex-qa-supplied-strict-evidence-grader-baseline-runner" },
        "version": { "type": "string" },
        "mode": { "const": "report_only_deterministic_grader_baseline" },
        "purpose": { "type": "string" },
        "nextRecommendedTranche": {
          "const": "complex QA real strict-evidence availability bridge audit"
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "required": [
        "syntheticFixtureReport",
        "syntheticFixtureReportSchema",
        "syntheticFixtureStatus",
        "syntheticFixtureRows",
        "syntheticFixtureExpectationMismatchRows"
      ],
      "properties": {
