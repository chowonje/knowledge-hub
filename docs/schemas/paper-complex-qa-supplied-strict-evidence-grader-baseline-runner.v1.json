        "inputFixtureRows": { "type": "integer", "minimum": 0 },
        "baselineGradeRows": { "type": "integer", "minimum": 0 },
        "baselineVerdictComputedRows": { "type": "integer", "minimum": 0 },
        "baselinePassRows": { "type": "integer", "minimum": 0 },
        "baselineFailRows": { "type": "integer", "minimum": 0 },
        "baselineBlockedRows": { "type": "integer", "minimum": 0 },
        "expectedPassRows": { "type": "integer", "minimum": 0 },
        "expectedFailRows": { "type": "integer", "minimum": 0 },
        "expectedBlockedRows": { "type": "integer", "minimum": 0 },
        "baselineExpectedMatchRows": { "type": "integer", "minimum": 0 },
        "baselineExpectedMismatchRows": { "const": 0 },
        "baselineSourceFixtureMatchRows": { "type": "integer", "minimum": 0 },
        "baselineSourceFixtureMismatchRows": { "const": 0 },
        "suppliedAnswerRows": { "type": "integer", "minimum": 0 },
        "suppliedCitationRows": { "type": "integer", "minimum": 0 },
        "syntheticStrictEvidenceRefRows": { "type": "integer", "minimum": 0 },
        "answerGeneratedRows": { "const": 0 },
        "answerQualityScoreComputedRows": { "const": 0 },
        "scoreComputedRows": { "const": 0 },
        "llmCallRows": { "const": 0 },
        "judgeModelCallRows": { "const": 0 },
        "answerPathInvokedRows": { "const": 0 },
        "searchIndexQueriedRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "runtimeEvidenceCreatedRows": { "const": 0 },
        "citationEvidenceCreatedRows": { "const": 0 },
        "strictEvidenceCreatedRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "schemaViolationCount": { "const": 0 },
        "baselineExpectedMatchRate": { "const": 1.0 },
        "baselineSourceFixtureMatchRate": { "const": 1.0 },
