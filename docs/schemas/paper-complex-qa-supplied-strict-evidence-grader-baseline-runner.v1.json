          "fixtureId": { "type": "string", "minLength": 1 },
          "questionId": { "type": "string", "minLength": 1 },
          "paperIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "questionCategory": {
            "type": "string",
            "enum": [
              "table_numeric_qa",
              "equation_citation_qa",
              "figure_caption_qa",
              "method_comparison_qa",
              "limitation_qa",
              "appendix_table_lookup_qa"
            ]
          },
          "expectedEvidenceType": {
            "type": "string",
            "enum": [
              "table_cell_numeric",
              "equation_source_span",
              "figure_caption_source_span",
              "cross_paper_method_spans",
              "limitation_section_span",
              "appendix_table_cell"
            ]
          },
          "answerabilityExpectation": {
            "type": "string",
            "enum": [
              "answerable",
              "expected_no_answer",
              "blocked_until_structured_evidence"
            ]
          },
          "fixtureKind": {
            "type": "string",
            "enum": [
              "synthetic_good_strict_evidence_answer",
              "synthetic_unsupported_claim",
              "synthetic_missing_citation",
              "synthetic_missing_strict_evidence",
              "synthetic_expected_no_answer_answered"
            ]
          },
          "sourceFixtureVerdict": { "type": "string", "enum": ["pass", "fail", "blocked"] },
          "expectedFixtureVerdict": { "type": "string", "enum": ["pass", "fail", "blocked"] },
          "baselineGraderVerdict": { "type": "string", "enum": ["pass", "fail", "blocked"] },
          "baselineVerdictMatchedExpected": { "const": true },
          "baselineVerdictMatchedSourceFixture": { "const": true },
          "baselineChecksApplied": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "categorySpecificChecksObserved": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "requiredGraderInputsObserved": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "syntheticStrictEvidenceRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "syntheticStrictEvidenceRefCount": { "type": "integer", "minimum": 0 },
          "suppliedAnswerPresent": { "type": "boolean" },
          "suppliedCitationCount": { "type": "integer", "minimum": 0 },
          "triggeredHardFailRules": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "baselineFailureReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "baselineGradeContract": {
            "type": "object",
            "required": [
              "baselineVerdictComputed",
              "realAnswerQualityScoreComputed",
              "requiresStrictEvidenceRefs",
              "requiresCitationCoverageForSuppliedClaims",
              "requiresExpectedNoAnswerGuard",
              "requiresNoTriggeredHardFailRulesForPass"
            ],
            "properties": {
              "baselineVerdictComputed": { "const": true },
              "realAnswerQualityScoreComputed": { "const": false },
              "requiresStrictEvidenceRefs": { "const": true },
              "requiresCitationCoverageForSuppliedClaims": { "const": true },
              "requiresExpectedNoAnswerGuard": { "const": true },
              "requiresNoTriggeredHardFailRulesForPass": { "const": true }
            },
            "additionalProperties": true
          },
          "riskNotes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "answerGenerated": { "const": false },
          "answerQualityScoreComputed": { "const": false },
          "scoreComputed": { "const": false },
          "llmCall": { "const": false },
          "judgeModelCall": { "const": false },
          "answerPathInvoked": { "const": false },
          "searchIndexQueried": { "const": false },
          "databaseMutation": { "const": false },
          "indexMutation": { "const": false },
          "reindexOrReembed": { "const": false },
          "vaultScan": { "const": false },
          "runtimeEvidenceCreated": { "const": false },
          "citationEvidenceCreated": { "const": false },
          "strictEvidenceCreated": { "const": false }
        },
        "additionalProperties": true
      }
    },
    "reportPaths": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": true
}
