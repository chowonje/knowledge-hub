        "citationEvidenceCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "parserRoutingChanged": { "const": false },
        "canonicalParsedArtifactsWritten": { "const": false }
      },
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "semanticViolations": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fixtureId",
          "questionId",
          "paperIds",
          "questionCategory",
          "expectedEvidenceType",
          "answerabilityExpectation",
          "fixtureKind",
          "sourceFixtureVerdict",
