{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-visual-retrieval-hint-candidate-store-expansion-review.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "sourceDryRunReport",
    "scope",
    "reviewPolicy",
    "counts",
    "reviewRowsDetail",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "knowledge-hub.paper.visual-retrieval-hint-candidate-store-expansion-review.v1"
    },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": [
        "ready_for_visual_retrieval_hint_candidate_store_expansion_human_product_review",
        "blocked"
      ]
    },
    "nextRecommendedTranche": {
      "const": "visual_retrieval_hint_candidate_store_expansion_human_product_decision_record"
    },
    "sourceDryRunReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "reportRef",
        "dryRunRows",
        "blockedRows",
        "candidateStoreWriteRows"
      ],
      "properties": {
        "schema": {
          "const": "knowledge-hub.paper.visual-retrieval-hint-candidate-store-expansion-dry-run.v1"
        },
        "status": { "enum": ["ready", "blocked"] },
        "reportRef": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^/" }
        },
        "dryRunRows": { "type": "integer", "minimum": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "const": 0 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "apiCalls",
        "modelCalls",
        "webModelCalls",
        "sourceDryRunRows",
        "reviewRowsProjected",
        "humanApprovalRows",
        "candidateStoreWriteRows",
        "vectorIndexing",
        "indexEligibleRows",
        "strictEvidencePromotionRows",
        "runtimeAnswerVisibleExposureRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "externalDownloadRows",
        "answerabilityGateBypassRows",
        "cropWriteRows",
        "pageImageWriteRows",
        "canonicalParsedArtifactWriteRows"
      ],
      "properties": {
        "writes": { "const": "report_only" },
        "apiCalls": { "const": false },
        "modelCalls": { "const": false },
        "webModelCalls": { "const": false },
        "sourceDryRunRows": { "type": "integer", "minimum": 0 },
        "reviewRowsProjected": { "type": "integer", "minimum": 0 },
        "humanApprovalRows": { "const": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "vectorIndexing": { "const": false },
        "indexEligibleRows": { "const": 0 },
        "strictEvidencePromotionRows": { "const": 0 },
        "runtimeAnswerVisibleExposureRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "answerabilityGateBypassRows": { "const": 0 },
        "cropWriteRows": { "const": 0 },
        "pageImageWriteRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 }
      }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewType",
        "plannedStoreRef",
        "actualApproval",
        "applyAllowedByThisReport",
        "requiresHumanProductDecisionRecord",
        "allowedHumanDecisions",
        "reviewQuestion"
      ],
      "properties": {
        "reviewType": { "const": "human_product_review_gate" },
        "plannedStoreRef": {
          "const": "papers_dir/visual_retrieval_hints/visual_retrieval_hint_candidates.v1.jsonl"
        },
        "actualApproval": { "const": false },
        "applyAllowedByThisReport": { "const": false },
        "requiresHumanProductDecisionRecord": { "const": true },
        "allowedHumanDecisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "approve_store_candidate_only",
              "hold_pending_more_context",
              "reject_visual_hint_candidate",
              "request_recrop_or_reannotation"
            ]
          }
        },
        "reviewQuestion": { "type": "string", "minLength": 1 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDryRunRows",
        "reviewRows",
        "reviewReadyRows",
        "humanDecisionRows",
        "applyReadyRows",
        "candidateStoreWriteRows",
        "policyViolationRows",
        "duplicateHintCandidateIdRows",
        "duplicateSourceCandidateIdRows",
        "blockedRows",
        "indexEligibleRows",
        "runtimeVisibleRows",
        "strictEvidenceRows",
        "citationGradeRows",
        "answerableWithoutTextEvidenceRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "properties": {
        "sourceDryRunRows": { "type": "integer", "minimum": 0 },
        "reviewRows": { "type": "integer", "minimum": 0 },
        "reviewReadyRows": { "type": "integer", "minimum": 0 },
        "humanDecisionRows": { "const": 0 },
        "applyReadyRows": { "const": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "policyViolationRows": { "type": "integer", "minimum": 0 },
        "duplicateHintCandidateIdRows": { "type": "integer", "minimum": 0 },
        "duplicateSourceCandidateIdRows": { "type": "integer", "minimum": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "indexEligibleRows": { "const": 0 },
        "runtimeVisibleRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeRows": { "const": 0 },
        "answerableWithoutTextEvidenceRows": { "const": 0 },
        "privatePathLeakRows": { "type": "integer", "minimum": 0 },
        "schemaViolationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "reviewRowsDetail": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewRow" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "reviewRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "reviewRowId",
        "hintCandidateId",
        "sourceCandidateId",
        "paperId",
        "paperRef",
        "sourceContentHash",
        "page",
        "bbox",
        "candidateType",
        "plannedStoreRef",
        "idempotencyKey",
        "plannedJsonlRecordSha256",
        "derivedTextForRetrievalSnippet",
        "visibleTextSnippet",
        "retrievalKeywordCount",
        "reviewStatus",
        "defaultHumanDecision",
        "allowedHumanDecisions",
        "checks",
        "policySummary",
        "provenance",
        "blockerReason"
      ],
      "properties": {
        "schema": {
          "const": "knowledge-hub.paper.visual-retrieval-hint-candidate-store-expansion-review-row.v1"
        },
        "reviewRowId": {
          "type": "string",
          "pattern": "^visual-retrieval-hint-expansion-review:"
        },
        "hintCandidateId": {
          "type": "string",
          "pattern": "^visual-retrieval-hint:"
        },
        "sourceCandidateId": {
          "type": "string",
          "pattern": "^visual-layout:"
        },
        "paperId": { "type": "string", "minLength": 1 },
        "paperRef": {
          "type": "string",
          "pattern": "^papers_dir/[^/].*"
        },
        "sourceContentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "page": { "type": "integer", "minimum": 1 },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "candidateType": {
          "enum": [
            "figure_caption_region",
            "table_region",
            "equation_region",
            "layout_region",
            "image_region"
          ]
        },
        "plannedStoreRef": {
          "const": "papers_dir/visual_retrieval_hints/visual_retrieval_hint_candidates.v1.jsonl"
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^visual-retrieval-hint-idempotency:"
        },
        "plannedJsonlRecordSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "derivedTextForRetrievalSnippet": { "type": "string", "minLength": 1 },
        "visibleTextSnippet": { "type": "string", "minLength": 1 },
        "retrievalKeywordCount": { "type": "integer", "minimum": 0 },
        "reviewStatus": {
          "enum": ["ready_for_human_product_review", "blocked"]
        },
        "defaultHumanDecision": {
          "const": "hold_pending_human_product_review"
        },
        "allowedHumanDecisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "approve_store_candidate_only",
              "hold_pending_more_context",
              "reject_visual_hint_candidate",
              "request_recrop_or_reannotation"
            ]
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "policySummary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedUse",
            "strictEvidence",
            "citationGrade",
            "answerableWithoutTextEvidence",
            "runtimeVisible",
            "indexEligible",
            "applyAllowedByThisReport"
          ],
          "properties": {
            "allowedUse": { "const": "retrieval_hint_only" },
            "strictEvidence": { "const": false },
            "citationGrade": { "const": false },
            "answerableWithoutTextEvidence": { "const": false },
            "runtimeVisible": { "const": false },
            "indexEligible": { "const": false },
            "applyAllowedByThisReport": { "const": false }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceDryRunReportSchema",
            "sourceDryRunReportRef",
            "hintCandidateId",
            "sourceCandidateId",
            "sourceContentHash",
            "page",
            "bbox",
            "extractionMethod"
          ],
          "properties": {
            "sourceDryRunReportSchema": {
              "const": "knowledge-hub.paper.visual-retrieval-hint-candidate-store-expansion-dry-run.v1"
            },
            "sourceDryRunReportRef": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "^/" }
            },
            "hintCandidateId": {
              "type": "string",
              "pattern": "^visual-retrieval-hint:"
            },
            "sourceCandidateId": {
              "type": "string",
              "pattern": "^visual-layout:"
            },
            "sourceContentHash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "page": { "type": "integer", "minimum": 1 },
            "bbox": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "type": "number" }
            },
            "extractionMethod": {
              "const": "visual_retrieval_hint_candidate_store_expansion_review_v1"
            }
          }
        },
        "blockerReason": { "type": "string" }
      }
    }
  }
}
