{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-limited-visual-retrieval-hint-production-vector-db-search-quality-eval.v1.json",
  "title": "Limited Visual Retrieval Hint Production Vector DB Search Quality Eval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "sourceProductionVectorApplyExecutorReport",
    "sourceLayoutCandidateReport",
    "input",
    "policy",
    "method",
    "counts",
    "qualityGate",
    "queryRowsDetail",
    "sourceBlockers",
    "technicalBlockers",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "knowledge-hub.paper.limited-visual-retrieval-hint-production-vector-db-search-quality-eval.v1"
    },
    "status": {
      "enum": ["ready", "needs_review", "blocked"]
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "ready_for_limited_visual_retrieval_hint_runtime_candidate_discovery_route_design",
        "keep_in_production_vector_dry_run_pending_search_quality_review",
        "blocked"
      ]
    },
    "nextRecommendedTranche": {
      "type": "string",
      "minLength": 1
    },
    "sourceProductionVectorApplyExecutorReport": {
      "$ref": "#/$defs/sourceSummary"
    },
    "sourceLayoutCandidateReport": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "status", "reportRef", "candidateRows", "loaded"],
      "properties": {
        "schema": {
          "const": "knowledge-hub.paper.visual-layout-candidate-list-report.v1"
        },
        "status": {
          "type": "string"
        },
        "reportRef": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^/"
          }
        },
        "candidateRows": {
          "type": "integer",
          "minimum": 0
        },
        "loaded": {
          "const": true
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "evalOnly",
        "candidateDiscoveryOnly",
        "candidateStoreWrite",
        "embeddingCalls",
        "vectorIndexWrite",
        "productionVectorIndexWrite",
        "operationalSearchIndexQuery",
        "runtimeVisible",
        "strictEvidence",
        "citationGrade",
        "answerableWithoutTextEvidence"
      ],
      "properties": {
        "evalOnly": {
          "const": true
        },
        "candidateDiscoveryOnly": {
          "const": true
        },
        "candidateStoreWrite": {
          "const": false
        },
        "embeddingCalls": {
          "const": false
        },
        "vectorIndexWrite": {
          "const": false
        },
        "productionVectorIndexWrite": {
          "const": false
        },
        "operationalSearchIndexQuery": {
          "const": false
        },
        "runtimeVisible": {
          "const": false
        },
        "strictEvidence": {
          "const": false
        },
        "citationGrade": {
          "const": false
        },
        "answerableWithoutTextEvidence": {
          "const": false
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "description"],
      "properties": {
        "name": {
          "const": "visual_retrieval_hint_production_vector_db_search_quality_eval_v1"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "qualityGate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["passed", "thresholds", "observed"],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": true
        },
        "observed": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "queryRowsDetail": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "schema",
          "rowId",
          "queryKind",
          "query",
          "hintCandidateId",
          "sourceCandidateId",
          "vectorDocumentId",
          "textOnly",
          "productionVector",
          "hybrid",
          "rankDelta",
          "blocked"
        ],
        "properties": {
          "schema": {
            "const": "knowledge-hub.paper.limited-visual-retrieval-hint-production-vector-db-search-quality-query-row.v1"
          },
          "rowId": {
            "type": "string",
            "minLength": 1
          },
          "queryKind": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "hintCandidateId": {
            "type": "string",
            "minLength": 1
          },
          "sourceCandidateId": {
            "type": "string",
            "minLength": 1
          },
          "vectorDocumentId": {
            "type": "string",
            "minLength": 1
          },
          "textOnly": {
            "$ref": "#/$defs/searchResult"
          },
          "productionVector": {
            "$ref": "#/$defs/searchResult"
          },
          "hybrid": {
            "$ref": "#/$defs/searchResult"
          },
          "rankDelta": {
            "type": "integer"
          },
          "blocked": {
            "type": "boolean"
          }
        }
      }
    },
    "sourceBlockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technicalBlockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sourceSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "status", "decision", "reportRef"],
      "properties": {
        "schema": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "reportRef": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^/"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "layoutCandidateRows",
        "sourceProductionVectorRecordRows",
        "matchedProductionVectorRecordRows",
        "queryRows",
        "textOnlyHitAt5Rows",
        "productionVectorHitAt5Rows",
        "hybridHitAt5Rows",
        "hybridHitAt5LiftRows",
        "rankRegressedRows",
        "candidateStoreWriteRows",
        "embeddingCallRows",
        "vectorIndexWriteRows",
        "productionVectorIndexWriteRows",
        "databaseMutationRows",
        "indexMutationRows",
        "operationalSearchIndexQueryRows",
        "runtimeVisibleRows",
        "strictEvidenceRows",
        "citationGradeRows",
        "answerableWithoutTextEvidenceRows",
        "blockedRows",
        "policyViolationRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "properties": {
        "layoutCandidateRows": {
          "type": "integer",
          "minimum": 0
        },
        "sourceProductionVectorRecordRows": {
          "type": "integer",
          "minimum": 0
        },
        "matchedProductionVectorRecordRows": {
          "type": "integer",
          "minimum": 0
        },
        "queryRows": {
          "type": "integer",
          "minimum": 0
        },
        "textOnlyHitAt5Rows": {
          "type": "integer",
          "minimum": 0
        },
        "productionVectorHitAt5Rows": {
          "type": "integer",
          "minimum": 0
        },
        "hybridHitAt5Rows": {
          "type": "integer",
          "minimum": 0
        },
        "hybridHitAt5LiftRows": {
          "type": "integer",
          "minimum": 0
        },
        "rankRegressedRows": {
          "type": "integer",
          "minimum": 0
        },
        "candidateStoreWriteRows": {
          "const": 0
        },
        "embeddingCallRows": {
          "const": 0
        },
        "vectorIndexWriteRows": {
          "const": 0
        },
        "productionVectorIndexWriteRows": {
          "const": 0
        },
        "databaseMutationRows": {
          "const": 0
        },
        "indexMutationRows": {
          "const": 0
        },
        "operationalSearchIndexQueryRows": {
          "const": 0
        },
        "runtimeVisibleRows": {
          "const": 0
        },
        "strictEvidenceRows": {
          "const": 0
        },
        "citationGradeRows": {
          "const": 0
        },
        "answerableWithoutTextEvidenceRows": {
          "const": 0
        },
        "blockedRows": {
          "type": "integer",
          "minimum": 0
        },
        "policyViolationRows": {
          "type": "integer",
          "minimum": 0
        },
        "privatePathLeakRows": {
          "type": "integer",
          "minimum": 0
        },
        "schemaViolationCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "searchResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["score", "hitAt1", "hitAt5", "hitAt10"],
      "properties": {
        "rank": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "score": {
          "type": "number"
        },
        "hitAt1": {
          "type": "boolean"
        },
        "hitAt5": {
          "type": "boolean"
        },
        "hitAt10": {
          "type": "boolean"
        }
      }
    }
  }
}
