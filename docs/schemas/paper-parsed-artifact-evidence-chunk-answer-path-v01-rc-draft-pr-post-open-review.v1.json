{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-hub.paper.parsed-artifact-evidence-chunk-answer-path-v01-rc-draft-pr-post-open-review.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "inputs",
    "policy",
    "postOpenReviewDecision",
    "counts",
    "gate",
    "githubPr",
    "checkRows",
    "ciCheckRows",
    "staleArtifactRows",
    "nextActionRows",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "checkRow": {
      "type": "object",
      "required": ["checkId", "status", "blockers"],
      "additionalProperties": false,
      "properties": {
        "checkId": { "type": "string" },
        "status": { "enum": ["pass", "fail"] },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ciCheckRow": {
      "type": "object",
      "required": ["name", "workflowName", "status", "conclusion"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "workflowName": { "type": "string" },
        "status": { "type": "string" },
        "conclusion": { "type": "string" }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "knowledge-hub.paper.parsed-artifact-evidence-chunk-answer-path-v01-rc-draft-pr-post-open-review.v1"
    },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string" },
    "decision": {
      "enum": [
        "knowledge_hub_v01_rc_draft_pr_post_open_review_ready",
        "knowledge_hub_v01_rc_draft_pr_post_open_review_blocked"
      ]
    },
    "nextRecommendedTranche": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": [
        "releasePackageHandoffReportRef",
        "publicDefaultPromotionGateReportRef",
        "releaseNotesReviewReportRef",
        "prNumber",
        "branchName",
        "baseBranch",
        "headShortSha",
        "originMainShortSha",
        "remoteMainShortSha",
        "remoteBranchShortSha"
      ],
      "additionalProperties": false,
      "properties": {
        "releasePackageHandoffReportRef": { "type": "string" },
        "publicDefaultPromotionGateReportRef": { "type": "string" },
        "releaseNotesReviewReportRef": { "type": "string" },
        "prNumber": { "type": "integer" },
        "branchName": { "type": "string" },
        "baseBranch": { "type": "string" },
        "headShortSha": { "type": "string" },
        "originMainShortSha": { "type": "string" },
        "remoteMainShortSha": { "type": "string" },
        "remoteBranchShortSha": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "reportOnly",
        "gitReadOnly",
        "githubReadOnly",
        "githubMutationAllowed",
        "markReadyAllowed",
        "mergeAllowed",
        "branchDeletionAllowed",
        "releaseTagAllowed",
        "packagePublishAllowed",
        "publicDefaultPromotionAllowed",
        "readyForGeneralRelease",
        "rawGithubPayloadPersisted"
      ],
      "additionalProperties": false,
      "properties": {
        "reportOnly": { "const": true },
        "gitReadOnly": { "const": true },
        "githubReadOnly": { "const": true },
        "githubMutationAllowed": { "const": false },
        "markReadyAllowed": { "const": false },
        "mergeAllowed": { "const": false },
        "branchDeletionAllowed": { "const": false },
        "releaseTagAllowed": { "const": false },
        "packagePublishAllowed": { "const": false },
        "publicDefaultPromotionAllowed": { "const": false },
        "readyForGeneralRelease": { "const": false },
        "rawGithubPayloadPersisted": { "const": false }
      }
    },
    "postOpenReviewDecision": {
      "type": "object",
      "required": [
        "draftPrPostOpenReview",
        "publicDefaultDecision",
        "defaultSurfaceDecision",
        "mergeDecision",
        "releaseTagDecision",
        "nextGate"
      ],
      "additionalProperties": false,
      "properties": {
        "draftPrPostOpenReview": { "enum": ["ready_for_human_review_not_merge", "blocked"] },
        "publicDefaultDecision": { "const": "hold_public_default_promotion" },
        "defaultSurfaceDecision": { "const": "do_not_enable_default_ask_or_default_mcp" },
        "mergeDecision": { "const": "not_ready_for_merge_in_this_tranche" },
        "releaseTagDecision": { "const": "not_ready_for_release_tag" },
        "nextGate": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "postOpenReviewRows",
        "githubPrLookupRows",
        "openPrRows",
        "draftPrRows",
        "baseMainRows",
        "headBranchMatchRows",
        "mergeStateCleanRows",
        "ciCheckRows",
        "ciCheckSuccessRows",
        "branchAheadCommitRows",
        "branchBehindCommitRows",
        "currentDirtyRows",
        "currentBlockingDirtyRows",
        "remoteBranchRows",
        "releasePackageHandoffReadyRows",
        "releaseNotesReadyRows",
        "publicDefaultPromotionGateReadyRows",
        "publicDefaultPromotionReadyRows",
        "publicDefaultPromotionHeldRows",
        "readyForHumanReviewRows",
        "readyForMergeRows",
        "readyForReleaseTagRows",
        "generalRcReadyRows",
        "corpusScaleClaimProvenRows",
        "stalePrePrHandoffRows",
        "blockedRows",
        "candidateStoreWriteRows",
        "sourceSpanCreatedRows",
        "strictEvidenceRows",
        "citationGradeEvidenceRows",
        "runtimeEvidenceRows",
        "parserExecutionRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "canonicalParsedArtifactWriteRows",
        "vaultScanRows",
        "externalDownloadRows",
        "publicCliFlagRows",
        "defaultOnRows",
        "externalLlmCallRows",
        "modelApiCallRows",
        "judgeModelCallRows",
        "pushRows",
        "githubPrMutationRows",
        "mergeRows",
        "branchDeletionRows",
        "releaseTagRows",
        "packagePublishRows",
        "rawGithubPayloadPersistedRows",
        "defaultMcpToolRows",
        "defaultKhubAskRouteRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "additionalProperties": false,
      "properties": {
        "postOpenReviewRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "githubPrLookupRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "openPrRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "draftPrRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "baseMainRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "headBranchMatchRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "mergeStateCleanRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "ciCheckRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "ciCheckSuccessRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "branchAheadCommitRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "branchBehindCommitRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "currentDirtyRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "currentBlockingDirtyRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "remoteBranchRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "releasePackageHandoffReadyRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "releaseNotesReadyRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "publicDefaultPromotionGateReadyRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "publicDefaultPromotionReadyRows": { "const": 0 },
        "publicDefaultPromotionHeldRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "readyForHumanReviewRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "readyForMergeRows": { "const": 0 },
        "readyForReleaseTagRows": { "const": 0 },
        "generalRcReadyRows": { "const": 0 },
        "corpusScaleClaimProvenRows": { "const": 0 },
        "stalePrePrHandoffRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "blockedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "candidateStoreWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeEvidenceRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "parserExecutionRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "publicCliFlagRows": { "const": 0 },
        "defaultOnRows": { "const": 0 },
        "externalLlmCallRows": { "const": 0 },
        "modelApiCallRows": { "const": 0 },
        "judgeModelCallRows": { "const": 0 },
        "pushRows": { "const": 0 },
        "githubPrMutationRows": { "const": 0 },
        "mergeRows": { "const": 0 },
        "branchDeletionRows": { "const": 0 },
        "releaseTagRows": { "const": 0 },
        "packagePublishRows": { "const": 0 },
        "rawGithubPayloadPersistedRows": { "const": 0 },
        "defaultMcpToolRows": { "const": 0 },
        "defaultKhubAskRouteRows": { "const": 0 },
        "privatePathLeakRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "schemaViolationCount": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "postOpenReviewReady",
        "releasePackageHandoffReady",
        "releaseNotesReviewReady",
        "publicDefaultPromotionGateReady",
        "currentBranchReady",
        "githubPrStateReady",
        "ciChecksGreen",
        "readyForHumanReview",
        "readyForMerge",
        "publicDefaultPromotionAllowed",
        "generalRcReady",
        "semanticViolations"
      ],
      "additionalProperties": false,
      "properties": {
        "postOpenReviewReady": { "type": "boolean" },
        "releasePackageHandoffReady": { "type": "boolean" },
        "releaseNotesReviewReady": { "type": "boolean" },
        "publicDefaultPromotionGateReady": { "type": "boolean" },
        "currentBranchReady": { "type": "boolean" },
        "githubPrStateReady": { "type": "boolean" },
        "ciChecksGreen": { "type": "boolean" },
        "readyForHumanReview": { "type": "boolean" },
        "readyForMerge": { "const": false },
        "publicDefaultPromotionAllowed": { "const": false },
        "generalRcReady": { "const": false },
        "semanticViolations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "githubPr": {
      "type": "object",
      "required": [
        "number",
        "title",
        "url",
        "state",
        "isDraft",
        "mergeStateStatus",
        "baseRefName",
        "headRefName"
      ],
      "additionalProperties": false,
      "properties": {
        "number": { "type": "integer" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "state": { "type": "string" },
        "isDraft": { "type": "boolean" },
        "mergeStateStatus": { "type": "string" },
        "baseRefName": { "type": "string" },
        "headRefName": { "type": "string" }
      }
    },
    "checkRows": { "type": "array", "items": { "$ref": "#/$defs/checkRow" } },
    "ciCheckRows": { "type": "array", "items": { "$ref": "#/$defs/ciCheckRow" } },
    "staleArtifactRows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifactRef", "staleReason", "historicalStatus", "historicalOpenPrRows", "currentAuthority"],
        "additionalProperties": false,
        "properties": {
          "artifactRef": { "type": "string" },
          "staleReason": { "type": "string" },
          "historicalStatus": { "type": "string" },
          "historicalOpenPrRows": { "type": "integer" },
          "currentAuthority": { "type": "string" }
        }
      }
    },
    "nextActionRows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actionId", "requiresExplicitApproval", "summary"],
        "additionalProperties": false,
        "properties": {
          "actionId": { "type": "string" },
          "requiresExplicitApproval": { "type": "boolean" },
          "summary": { "type": "string" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
