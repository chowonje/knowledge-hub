{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-limited-visual-retrieval-hint-candidate-store-apply-design.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "sourceSearchEvalReport",
    "sourceDryRunReports",
    "scope",
    "policy",
    "counts",
    "typeSummary",
    "applyDesignRowsDetail",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "knowledge-hub.paper.limited-visual-retrieval-hint-candidate-store-apply-design.v1"
    },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": ["ready_for_limited_visual_retrieval_hint_candidate_store_apply_review", "blocked"]
    },
    "nextRecommendedTranche": {
      "const": "limited_visual_retrieval_hint_candidate_store_apply_review"
    },
    "sourceSearchEvalReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "decision",
        "reportRef",
        "inputHintRows",
        "queryRows",
        "augmentedHitAt5Rows",
        "rankRegressedRows",
        "blockedRows",
        "candidateStoreWriteRows"
      ],
      "properties": {
        "schema": { "const": "knowledge-hub.paper.visual-retrieval-hint-search-eval.v1" },
        "status": { "enum": ["ready", "blocked"] },
        "decision": {
          "enum": ["ready_for_limited_visual_retrieval_hint_candidate_store_apply_design", "blocked"]
        },
        "reportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
        "inputHintRows": { "type": "integer", "minimum": 0 },
        "queryRows": { "type": "integer", "minimum": 0 },
        "augmentedHitAt5Rows": { "type": "integer", "minimum": 0 },
        "rankRegressedRows": { "type": "integer", "minimum": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "const": 0 }
      }
    },
    "sourceDryRunReports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "status",
          "reportRef",
          "dryRunRows",
          "plannedWriteRows",
          "blockedRows",
          "candidateStoreWriteRows"
        ],
        "properties": {
          "schema": {
            "enum": [
              "knowledge-hub.paper.visual-retrieval-hint-candidate-store-dry-run.v1",
              "knowledge-hub.paper.visual-retrieval-hint-candidate-store-expansion-dry-run.v1"
            ]
          },
          "status": { "enum": ["ready", "blocked"] },
          "reportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
          "dryRunRows": { "type": "integer", "minimum": 0 },
          "plannedWriteRows": { "type": "integer", "minimum": 0 },
          "blockedRows": { "type": "integer", "minimum": 0 },
          "candidateStoreWriteRows": { "const": 0 }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "apiCalls",
        "modelCalls",
        "webModelCalls",
        "applyDesignRows",
        "candidateStoreWriteRows",
        "vectorIndexing",
        "indexEligibleRows",
        "runtimeVisibleRows",
        "strictEvidencePromotionRows",
        "runtimeAnswerVisibleExposureRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "externalDownloadRows",
        "answerabilityGateBypassRows",
        "operationalSearchIndexQueryRows",
        "answerGenerationRows",
        "candidateStoreApplyExecutorRows"
      ],
      "properties": {
        "writes": { "const": "report_only" },
        "apiCalls": { "const": false },
        "modelCalls": { "const": false },
        "webModelCalls": { "const": false },
        "applyDesignRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "vectorIndexing": { "const": false },
        "indexEligibleRows": { "const": 0 },
        "runtimeVisibleRows": { "const": 0 },
        "strictEvidencePromotionRows": { "const": 0 },
        "runtimeAnswerVisibleExposureRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "answerabilityGateBypassRows": { "const": 0 },
        "operationalSearchIndexQueryRows": { "const": 0 },
        "answerGenerationRows": { "const": 0 },
        "candidateStoreApplyExecutorRows": { "const": 0 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plannedStoreRef",
        "designKind",
        "actualStoreWrite",
        "candidateStoreWriteAuthorizedByThisReport",
        "requiresSeparateApplyExecutor",
        "requiresSeparateIndexingGate",
        "allowedUse",
        "strictEvidence",
        "citationGrade",
        "answerableWithoutTextEvidence",
        "runtimeVisible",
        "indexEligible"
      ],
      "properties": {
        "plannedStoreRef": {
          "const": "papers_dir/visual_retrieval_hints/visual_retrieval_hint_candidates.v1.jsonl"
        },
        "designKind": { "const": "limited_candidate_store_apply_design_only" },
        "actualStoreWrite": { "const": false },
        "candidateStoreWriteAuthorizedByThisReport": { "const": false },
        "requiresSeparateApplyExecutor": { "const": true },
        "requiresSeparateIndexingGate": { "const": true },
        "allowedUse": { "const": "retrieval_hint_only" },
        "strictEvidence": { "const": false },
        "citationGrade": { "const": false },
        "answerableWithoutTextEvidence": { "const": false },
        "runtimeVisible": { "const": false },
        "indexEligible": { "const": false }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSearchQueryRows",
        "sourceDryRunReportRows",
        "sourceDryRunRows",
        "inputHintRows",
        "applyDesignRows",
        "limitedApplyDesignCandidateRows",
        "plannedSeparateApplyWriteRows",
        "candidateStoreWriteRows",
        "jsonlSerializableRows",
        "searchGatePassedRows",
        "dryRunMatchedRows",
        "duplicateHintCandidateIdRows",
        "blockedRows",
        "indexEligibleRows",
        "runtimeVisibleRows",
        "strictEvidenceRows",
        "citationGradeRows",
        "answerableWithoutTextEvidenceRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "properties": {
        "sourceSearchQueryRows": { "type": "integer", "minimum": 0 },
        "sourceDryRunReportRows": { "type": "integer", "minimum": 0 },
        "sourceDryRunRows": { "type": "integer", "minimum": 0 },
        "inputHintRows": { "type": "integer", "minimum": 0 },
        "applyDesignRows": { "type": "integer", "minimum": 0 },
        "limitedApplyDesignCandidateRows": { "type": "integer", "minimum": 0 },
        "plannedSeparateApplyWriteRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "jsonlSerializableRows": { "type": "integer", "minimum": 0 },
        "searchGatePassedRows": { "type": "integer", "minimum": 0 },
        "dryRunMatchedRows": { "type": "integer", "minimum": 0 },
        "duplicateHintCandidateIdRows": { "type": "integer", "minimum": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "indexEligibleRows": { "const": 0 },
        "runtimeVisibleRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeRows": { "const": 0 },
        "answerableWithoutTextEvidenceRows": { "const": 0 },
        "privatePathLeakRows": { "const": 0 },
        "schemaViolationCount": { "const": 0 }
      }
    },
    "typeSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateType",
          "applyDesignRows",
          "limitedApplyDesignCandidateRows",
          "improvedQueryRows",
          "strongLiftQueryRows",
          "blockedRows"
        ],
        "properties": {
          "candidateType": {
            "enum": ["figure_caption_region", "table_region", "equation_region", "layout_region", "image_region"]
          },
          "applyDesignRows": { "type": "integer", "minimum": 0 },
          "limitedApplyDesignCandidateRows": { "type": "integer", "minimum": 0 },
          "improvedQueryRows": { "type": "integer", "minimum": 0 },
          "strongLiftQueryRows": { "type": "integer", "minimum": 0 },
          "blockedRows": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "applyDesignRowsDetail": {
      "type": "array",
      "items": { "$ref": "#/$defs/applyDesignRow" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceBlockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "applyDesignRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "applyDesignRowId",
        "hintCandidateId",
        "sourceCandidateId",
        "paperId",
        "paperRef",
        "sourceContentHash",
        "page",
        "bbox",
        "candidateType",
        "sourceDryRunReportRef",
        "sourceDryRunRowId",
        "plannedStoreRef",
        "idempotencyKey",
        "plannedJsonlRecordSha256",
        "recordPreview",
        "searchEvalSummary",
        "applyPlan",
        "policy",
        "blockerReason"
      ],
      "properties": {
        "schema": {
          "const": "knowledge-hub.paper.limited-visual-retrieval-hint-candidate-store-apply-design-row.v1"
        },
        "applyDesignRowId": {
          "type": "string",
          "pattern": "^limited-visual-retrieval-hint-apply-design:"
        },
        "hintCandidateId": { "type": "string", "pattern": "^visual-retrieval-hint:" },
        "sourceCandidateId": { "type": "string", "pattern": "^visual-layout:" },
        "paperId": { "type": "string", "minLength": 1 },
        "paperRef": { "type": "string", "pattern": "^papers_dir/[^/].*" },
        "sourceContentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "page": { "type": "integer", "minimum": 1 },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "candidateType": {
          "enum": ["figure_caption_region", "table_region", "equation_region", "layout_region", "image_region"]
        },
        "sourceDryRunReportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
        "sourceDryRunRowId": { "type": "string", "minLength": 1 },
        "plannedStoreRef": {
          "const": "papers_dir/visual_retrieval_hints/visual_retrieval_hint_candidates.v1.jsonl"
        },
        "idempotencyKey": { "type": "string", "pattern": "^visual-retrieval-hint-idempotency:" },
        "plannedJsonlRecordSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "recordPreview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "derivedTextForRetrievalPreview",
            "visibleTextPreview",
            "retrievalKeywords",
            "limitations"
          ],
          "properties": {
            "derivedTextForRetrievalPreview": { "type": "string", "minLength": 1 },
            "visibleTextPreview": { "type": "string" },
            "retrievalKeywords": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "limitations": { "type": "string" }
          }
        },
        "searchEvalSummary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceSearchEvalQueryRowIds",
            "queryRows",
            "textOnlyBestRank",
            "visualHintAugmentedBestRank",
            "augmentedHitAt5Rows",
            "improvedQueryRows",
            "regressedQueryRows",
            "strongLiftQueryRows",
            "blockedQueryRows",
            "passesLimitedApplySearchGate"
          ],
          "properties": {
            "sourceSearchEvalQueryRowIds": {
              "type": "array",
              "items": { "type": "string", "pattern": "^visual-retrieval-hint-search-query:" }
            },
            "queryRows": { "type": "integer", "minimum": 0 },
            "textOnlyBestRank": { "type": ["integer", "null"], "minimum": 1 },
            "visualHintAugmentedBestRank": { "type": ["integer", "null"], "minimum": 1 },
            "augmentedHitAt5Rows": { "type": "integer", "minimum": 0 },
            "improvedQueryRows": { "type": "integer", "minimum": 0 },
            "regressedQueryRows": { "type": "integer", "minimum": 0 },
            "strongLiftQueryRows": { "type": "integer", "minimum": 0 },
            "blockedQueryRows": { "type": "integer", "minimum": 0 },
            "passesLimitedApplySearchGate": { "type": "boolean" }
          }
        },
        "applyPlan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "limitedApplyDesignCandidate",
            "wouldWriteOnSeparateExplicitApply",
            "applyAllowedByThisReport",
            "candidateStoreWrite",
            "requiresSeparateApplyExecutor",
            "requiresSeparateIndexingGate",
            "writeModeIfLaterApproved"
          ],
          "properties": {
            "limitedApplyDesignCandidate": { "type": "boolean" },
            "wouldWriteOnSeparateExplicitApply": { "type": "boolean" },
            "applyAllowedByThisReport": { "const": false },
            "candidateStoreWrite": { "const": false },
            "requiresSeparateApplyExecutor": { "const": true },
            "requiresSeparateIndexingGate": { "const": true },
            "writeModeIfLaterApproved": {
              "const": "append_jsonl_to_visual_retrieval_hint_candidate_store"
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedUse",
            "strictEvidence",
            "citationGrade",
            "answerableWithoutTextEvidence",
            "runtimeVisible",
            "indexEligible"
          ],
          "properties": {
            "allowedUse": { "const": "retrieval_hint_only" },
            "strictEvidence": { "const": false },
            "citationGrade": { "const": false },
            "answerableWithoutTextEvidence": { "const": false },
            "runtimeVisible": { "const": false },
            "indexEligible": { "const": false }
          }
        },
        "blockerReason": { "type": "string" }
      }
    }
  }
}
