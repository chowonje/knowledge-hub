      "properties": {
        "sourceContentHash": { "$ref": "#/$defs/authorityRequirement" },
        "pageLocatorBasis": { "$ref": "#/$defs/authorityRequirement" },
        "tableLocatorBasis": { "$ref": "#/$defs/authorityRequirement" },
        "captionLocatorBasis": { "$ref": "#/$defs/authorityRequirement" },
        "equationLocatorBasis": { "$ref": "#/$defs/authorityRequirement" },
        "deterministicIdentityKeyBasis": { "$ref": "#/$defs/authorityRequirement" }
      },
      "additionalProperties": true
    },
    "authorityRequirement": {
      "type": "object",
      "required": ["required", "basis", "materializedInThisDesign", "mustBeVerifiedByDryRun"],
      "properties": {
        "required": { "type": ["boolean", "string"] },
        "basis": { "type": "string" },
        "components": { "type": "array", "items": { "type": "string" } },
        "materializedInThisDesign": { "const": false },
        "mustBeVerifiedByDryRun": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "expectedArtifactShape": {
      "type": "object",
      "required": [
        "artifactKind",
        "writeTarget",
        "canonicalParsedArtifactOverwrite",
        "parserRoutingChange",
        "sourceSpanCreated",
        "strictEvidenceCreated",
        "citationEvidenceCreated",
        "runtimeEvidenceCreated",
        "contains",
        "repairComponents",
        "mustNotContain"
      ],
      "properties": {
        "artifactKind": { "type": "string" },
        "writeTarget": { "type": "string" },
        "canonicalParsedArtifactOverwrite": { "const": false },
        "parserRoutingChange": { "const": false },
        "sourceSpanCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "citationEvidenceCreated": { "const": false },
        "runtimeEvidenceCreated": { "const": false },
        "contains": { "type": "array", "items": { "type": "string" } },
        "repairComponents": { "type": "array", "items": { "type": "string" } },
        "mustNotContain": { "type": "array", "items": { "type": "string" } }
