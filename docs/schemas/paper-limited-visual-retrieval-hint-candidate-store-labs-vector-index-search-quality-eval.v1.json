    "productValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productQuestion", "userScenario", "decision", "scenarioResults"],
      "properties": {
        "productQuestion": { "type": "string", "minLength": 1 },
        "userScenario": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "scenarioResults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenario", "status", "evidence"],
            "properties": {
              "scenario": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pass", "partial", "fail", "unknown"] },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "typeSummary": {
      "type": "array",
      "items": { "$ref": "#/$defs/typeSummaryRow" }
    },
