  "$defs": {
    "candidateType": {
      "enum": ["figure_caption_region", "table_region", "equation_region", "layout_region", "image_region"]
    },
    "typeSummaryRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateType",
        "queryRows",
        "textOnlyHitAt5Rows",
        "labsVectorHitAt5Rows",
        "hybridHitAt5Rows",
        "improvedRows",
        "regressedRows"
      ],
      "properties": {
        "candidateType": { "$ref": "#/$defs/candidateType" },
        "queryRows": { "type": "integer", "minimum": 0 },
        "textOnlyHitAt5Rows": { "type": "integer", "minimum": 0 },
        "labsVectorHitAt5Rows": { "type": "integer", "minimum": 0 },
        "hybridHitAt5Rows": { "type": "integer", "minimum": 0 },
        "improvedRows": { "type": "integer", "minimum": 0 },
        "regressedRows": { "type": "integer", "minimum": 0 }
      }
    },
    "vectorContractRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractRowId",
        "vectorDocumentId",
        "hintCandidateId",
        "sourceCandidateId",
        "paperId",
        "candidateType",
        "recordMatched",
        "contractBlockers",
        "checks"
      ],
      "properties": {
        "contractRowId": { "type": "string", "pattern": "^limited-visual-retrieval-hint-labs-vector-search-quality-contract:" },
        "vectorDocumentId": { "type": "string", "pattern": "^visual-retrieval-hint-vector-doc:" },
        "hintCandidateId": { "type": "string", "pattern": "^visual-retrieval-hint:" },
        "sourceCandidateId": { "type": "string", "pattern": "^visual-layout:" },
        "paperId": { "type": "string", "minLength": 1 },
        "candidateType": { "$ref": "#/$defs/candidateType" },
        "recordMatched": { "type": "boolean" },
        "contractBlockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "checks": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "queryRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "queryRowId",
        "queryKind",
        "query",
        "targetVectorDocumentId",
        "hintCandidateId",
        "sourceCandidateId",
        "paperId",
        "paperRef",
        "sourceContentHash",
        "page",
        "bbox",
        "candidateType",
        "embeddingTextHash",
        "textOnlyResult",
        "labsVectorResult",
        "hybridResult",
        "comparison",
        "policy",
        "blockerReason"
      ],
      "properties": {
        "schema": {
          "const": "knowledge-hub.paper.limited-visual-retrieval-hint-candidate-store-labs-vector-index-search-quality-query-row.v1"
        },
        "queryRowId": {
          "type": "string",
          "pattern": "^limited-visual-retrieval-hint-labs-vector-search-quality-query:"
        },
        "queryKind": { "enum": ["keyword_lookup", "natural_lookup"] },
        "query": { "type": "string", "minLength": 1 },
        "targetVectorDocumentId": { "type": "string", "pattern": "^visual-retrieval-hint-vector-doc:" },
        "hintCandidateId": { "type": "string", "pattern": "^visual-retrieval-hint:" },
        "sourceCandidateId": { "type": "string", "pattern": "^visual-layout:" },
        "paperId": { "type": "string", "minLength": 1 },
        "paperRef": { "type": "string", "pattern": "^papers_dir/[^/].*" },
        "sourceContentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "page": { "type": "integer", "minimum": 1 },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "candidateType": { "$ref": "#/$defs/candidateType" },
        "embeddingTextHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "textOnlyResult": { "$ref": "#/$defs/searchResult" },
        "labsVectorResult": { "$ref": "#/$defs/searchResult" },
        "hybridResult": { "$ref": "#/$defs/searchResult" },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["textToHybridRankDelta", "improved", "regressed", "unchanged", "liftBucket"],
          "properties": {
            "textToHybridRankDelta": { "type": "integer" },
            "improved": { "type": "boolean" },
            "regressed": { "type": "boolean" },
            "unchanged": { "type": "boolean" },
            "liftBucket": { "enum": ["strong_lift", "moderate_lift", "no_lift", "regression", "blocked"] }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedUse",
            "strictEvidence",
            "citationGrade",
            "answerableWithoutTextEvidence",
            "runtimeVisible",
            "indexEligible"
          ],
          "properties": {
            "allowedUse": { "const": "retrieval_hint_search_quality_eval_only" },
            "strictEvidence": { "const": false },
            "citationGrade": { "const": false },
            "answerableWithoutTextEvidence": { "const": false },
            "runtimeVisible": { "const": false },
            "indexEligible": { "const": false }
          }
        },
        "blockerReason": { "type": "string" }
      }
    },
    "searchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "score", "hitAt1", "hitAt5", "hitAt10"],
      "properties": {
        "rank": { "type": ["integer", "null"], "minimum": 1 },
        "score": { "type": "number" },
        "hitAt1": { "type": "boolean" },
        "hitAt5": { "type": "boolean" },
        "hitAt10": { "type": "boolean" }
      }
    }
  }
}
