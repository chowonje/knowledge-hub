    "qualityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "checks", "thresholds", "observed"],
      "properties": {
        "passed": { "type": "boolean" },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actualLabsIndexRead",
            "allSourceUpsertRowsMatched",
            "allSourceCandidatesCoveredByTextBaseline",
            "queryRowsPresent",
            "labsHitAt5MeetsThreshold",
            "hybridHitAt5ImprovesTextOnly",
            "hybridMrrImprovesTextOnly",
            "noHybridRankRegressions"
          ],
          "properties": {
            "actualLabsIndexRead": { "type": "boolean" },
            "allSourceUpsertRowsMatched": { "type": "boolean" },
            "allSourceCandidatesCoveredByTextBaseline": { "type": "boolean" },
            "queryRowsPresent": { "type": "boolean" },
            "labsHitAt5MeetsThreshold": { "type": "boolean" },
            "hybridHitAt5ImprovesTextOnly": { "type": "boolean" },
            "hybridMrrImprovesTextOnly": { "type": "boolean" },
            "noHybridRankRegressions": { "type": "boolean" }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minLabsHitAt5Rows", "minHybridHitAt5LiftRows"],
          "properties": {
            "minLabsHitAt5Rows": { "type": "integer", "minimum": 0 },
            "minHybridHitAt5LiftRows": { "type": "integer", "minimum": 0 }
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "textOnlyHitAt5Rows",
            "sourceCandidateRowsCoveredByTextBaseline",
            "sourceCandidateRowsMissingFromTextBaseline",
            "labsVectorHitAt5Rows",
            "hybridHitAt5Rows",
            "hybridHitAt5LiftRows",
            "textOnlyMrr",
            "labsVectorMrr",
            "hybridMrr"
          ],
          "properties": {
            "textOnlyHitAt5Rows": { "type": "integer", "minimum": 0 },
            "sourceCandidateRowsCoveredByTextBaseline": { "type": "integer", "minimum": 0 },
            "sourceCandidateRowsMissingFromTextBaseline": { "type": "integer", "minimum": 0 },
            "labsVectorHitAt5Rows": { "type": "integer", "minimum": 0 },
            "hybridHitAt5Rows": { "type": "integer", "minimum": 0 },
            "hybridHitAt5LiftRows": { "type": "integer" },
            "textOnlyMrr": { "type": "number", "minimum": 0 },
            "labsVectorMrr": { "type": "number", "minimum": 0 },
            "hybridMrr": { "type": "number", "minimum": 0 }
          }
        }
      }
