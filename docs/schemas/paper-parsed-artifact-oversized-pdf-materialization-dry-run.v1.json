{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-hub.paper.parsed-artifact-oversized-pdf-materialization-dry-run.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "generatedAt",
    "report",
    "baseline",
    "inputSourceRecoveryFeasibility",
    "candidatePool",
    "selectedCandidatePaperIds",
    "selectedCandidates",
    "blockedCandidates",
    "dryRunMaterializationReadiness",
    "expectedCoverageChangeIfApplied",
    "nextRecommendedTranche",
    "mutationPolicy",
    "mutationCounters",
    "dryRunMaterialization",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "knowledge-hub.paper.parsed-artifact-oversized-pdf-materialization-dry-run.v1"
    },
    "status": {
      "type": "string",
      "enum": ["ready", "blocked"]
    },
    "generatedAt": { "type": "string" },
    "report": {
      "type": "object",
      "required": [
        "name",
        "baseMaxSourcePdfBytes",
        "policyMaxSourcePdfBytes",
        "limit",
        "selectionRule",
        "nonScope"
      ],
      "properties": {
        "name": { "type": "string" },
        "baseMaxSourcePdfBytes": { "type": "integer", "minimum": 0 },
        "policyMaxSourcePdfBytes": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 0 },
        "selectionRule": { "type": "string" },
        "nonScope": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "baseline": {
      "type": "object",
      "required": ["scannedPapers", "reportedPapers", "degradedPapers", "missingParsedArtifacts"],
      "properties": {
        "scannedPapers": { "type": "integer", "minimum": 0 },
        "reportedPapers": { "type": "integer", "minimum": 0 },
        "degradedPapers": { "type": "integer", "minimum": 0 },
        "missingParsedArtifacts": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "inputSourceRecoveryFeasibility": {
      "type": "object",
      "required": [
        "status",
        "sourceBlockerSnapshot",
        "oversizedPolicySummary",
        "sourceMissingRecoverySummary",
        "textSourcePolicySummary"
      ],
      "properties": {
        "status": { "type": "string" },
        "sourceBlockerSnapshot": { "type": "object" },
        "oversizedPolicySummary": { "type": "object" },
        "sourceMissingRecoverySummary": { "type": "object" },
        "textSourcePolicySummary": { "type": "object" }
      },
      "additionalProperties": true
    },
    "candidatePool": {
      "type": "object",
      "required": [
        "inputRows",
        "sourcePdfOversizedRows",
        "oversizedSmallPolicyCandidateRows",
        "selectedDryRunRows",
        "blockedRows",
        "blockerTaxonomy"
      ],
      "properties": {
        "inputRows": { "type": "integer", "minimum": 0 },
        "sourcePdfOversizedRows": { "type": "integer", "minimum": 0 },
        "oversizedSmallPolicyCandidateRows": { "type": "integer", "minimum": 0 },
        "selectedDryRunRows": { "type": "integer", "minimum": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "blockerTaxonomy": {
          "type": "array",
          "items": { "$ref": "#/$defs/counterItem" }
        }
      },
      "additionalProperties": true
    },
    "selectedCandidatePaperIds": { "type": "array", "items": { "type": "string" } },
    "selectedCandidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateRow" }
    },
    "blockedCandidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/blockedRow" }
    },
    "dryRunMaterializationReadiness": {
      "type": "object",
      "required": [
        "ready",
        "status",
        "counts",
        "allSelectedPlanned",
        "schemaValidation",
        "applySkippedReason"
      ],
      "properties": {
        "ready": { "type": "boolean" },
        "status": { "type": "string" },
        "counts": { "type": "object" },
        "allSelectedPlanned": { "type": "boolean" },
        "schemaValidation": {
          "type": "object",
          "required": ["ok", "errors"],
          "properties": {
            "ok": { "type": "boolean" },
            "errors": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "applySkippedReason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "expectedCoverageChangeIfApplied": {
      "type": "object",
      "required": [
        "missingParsedArtifactsBefore",
        "expectedMissingParsedArtifactsReduction",
        "expectedMissingParsedArtifactsAfter"
      ],
      "properties": {
        "missingParsedArtifactsBefore": { "type": "integer", "minimum": 0 },
        "expectedMissingParsedArtifactsReduction": { "type": "integer", "minimum": 0 },
        "expectedMissingParsedArtifactsAfter": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "nextRecommendedTranche": {
      "type": "object",
      "required": ["name", "candidateCount", "paperIds", "rationale"],
      "properties": {
        "name": { "type": "string" },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "paperIds": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" }
      },
      "additionalProperties": true
    },
    "mutationPolicy": { "type": "object" },
    "mutationCounters": { "type": "object" },
    "dryRunMaterialization": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "counterItem": {
      "type": "object",
      "required": ["reason", "count"],
      "properties": {
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "sourceArtifact": {
      "type": "object",
      "required": ["kind", "exists", "isFile", "sizeBytes", "path"],
      "properties": {
        "kind": { "type": "string" },
        "exists": { "type": "boolean" },
        "isFile": { "type": "boolean" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" }
      },
      "additionalProperties": true
    },
    "candidateRow": {
      "type": "object",
      "required": [
        "paperId",
        "paperTitle",
        "sourceArtifact",
        "sizeBytes",
        "oversizedPolicyStatus",
        "dryRunStatus",
        "plannedAction"
      ],
      "properties": {
        "paperId": { "type": "string" },
        "paperTitle": { "type": "string" },
        "sourceArtifact": { "$ref": "#/$defs/sourceArtifact" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "oversizedPolicyStatus": { "type": "string" },
        "dryRunStatus": { "type": "string" },
        "plannedAction": { "type": "string" }
      },
      "additionalProperties": true
    },
    "blockedRow": {
      "type": "object",
      "required": [
        "paperId",
        "paperTitle",
        "sourceArtifact",
        "sizeBytes",
        "oversizedPolicyStatus",
        "blockedReason",
        "recommendedAction"
      ],
      "properties": {
        "paperId": { "type": "string" },
        "paperTitle": { "type": "string" },
        "sourceArtifact": { "$ref": "#/$defs/sourceArtifact" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "oversizedPolicyStatus": { "type": "string" },
        "blockedReason": { "type": "string" },
        "recommendedAction": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
