        "branchAheadCommitRows": { "type": "integer", "minimum": 0 },
        "branchBehindCommitRows": { "type": "integer", "minimum": 0 },
        "changedFileRows": { "type": "integer", "minimum": 0 },
        "commitRows": { "type": "integer", "minimum": 0 },
        "worktreeDirtyRows": { "type": "integer", "minimum": 0 },
        "selfReviewDirtyRows": { "type": "integer", "minimum": 0 },
        "blockingDirtyRows": { "type": "integer", "minimum": 0 },
