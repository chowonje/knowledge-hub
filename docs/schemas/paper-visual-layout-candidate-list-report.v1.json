{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-visual-layout-candidate-list-report.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "scope",
    "counts",
    "candidateRowsDetail",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.visual-layout-candidate-list-report.v1" },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["ready_for_visual_annotation_request_pack_design", "blocked"] },
    "nextRecommendedTranche": { "const": "visual_annotation_request_pack_design" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "modelCalls",
        "vectorIndexing",
        "strictEvidencePromotionRows",
        "runtimeAnswerVisibleExposureRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "externalDownloadRows",
        "answerabilityGateBypassRows",
        "cropWriteRows",
        "canonicalParsedArtifactWriteRows"
      ],
      "properties": {
        "writes": { "const": "report_only" },
        "modelCalls": { "const": false },
        "vectorIndexing": { "const": false },
        "strictEvidencePromotionRows": { "const": 0 },
        "runtimeAnswerVisibleExposureRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "answerabilityGateBypassRows": { "const": 0 },
        "cropWriteRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputPaperRows",
        "candidateRows",
        "figureCandidateRows",
        "tableCandidateRows",
        "equationCandidateRows",
        "layoutCandidateRows",
        "imageCandidateRows",
        "blockedRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "properties": {
        "inputPaperRows": { "type": "integer", "minimum": 0 },
        "candidateRows": { "type": "integer", "minimum": 0 },
        "figureCandidateRows": { "type": "integer", "minimum": 0 },
        "tableCandidateRows": { "type": "integer", "minimum": 0 },
        "equationCandidateRows": { "type": "integer", "minimum": 0 },
        "layoutCandidateRows": { "type": "integer", "minimum": 0 },
        "imageCandidateRows": { "type": "integer", "minimum": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "privatePathLeakRows": { "const": 0 },
        "schemaViolationCount": { "const": 0 }
      }
    },
    "candidateRowsDetail": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "candidateId",
          "paperId",
          "paperRef",
          "sourceContentHash",
          "page",
          "bbox",
          "candidateType",
          "textContext",
          "visualContext",
          "retrievalHintPlan",
          "provenance",
          "blockerReason"
        ],
        "properties": {
          "schema": { "const": "knowledge-hub.paper.visual-layout-candidate-row.v1" },
          "candidateId": { "type": "string", "pattern": "^visual-layout:" },
          "paperId": { "type": "string", "minLength": 1 },
          "paperRef": { "type": "string", "pattern": "^papers_dir/[^/].*" },
          "sourceContentHash": {
            "anyOf": [
              { "const": "" },
              { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            ]
          },
          "page": { "type": "integer", "minimum": 0 },
          "bbox": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 0,
                "maxItems": 0
              },
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "number" }
              }
            ]
          },
          "candidateType": {
            "enum": [
              "figure_caption_region",
              "table_region",
              "equation_region",
              "layout_region",
              "image_region"
            ]
          },
          "textContext": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nearbyText", "captionText", "headingPath"],
            "properties": {
              "nearbyText": { "type": "string" },
              "captionText": { "type": "string" },
              "headingPath": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "visualContext": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cropRef", "imageHash", "pageImageRequired"],
            "properties": {
              "cropRef": { "type": "string", "pattern": "^papers_dir/visual_layout_planned_crops/" },
              "imageHash": {
                "anyOf": [
                  { "const": "" },
                  { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                ]
              },
              "pageImageRequired": { "type": "boolean" }
            }
          },
          "retrievalHintPlan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetDerivedTextField",
              "allowedUse",
              "strictEvidence",
              "citationGrade",
              "answerableWithoutTextEvidence"
            ],
            "properties": {
              "targetDerivedTextField": { "const": "derivedTextForRetrieval" },
              "allowedUse": { "const": "retrieval_hint_only" },
              "strictEvidence": { "const": false },
              "citationGrade": { "const": false },
              "answerableWithoutTextEvidence": { "const": false }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": true,
            "required": ["sourceContentHash", "page", "bbox", "extractionMethod"],
            "properties": {
              "sourceContentHash": {
                "anyOf": [
                  { "const": "" },
                  { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                ]
              },
              "page": { "type": "integer", "minimum": 0 },
              "bbox": {
                "anyOf": [
                  {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 0
                  },
                  {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": { "type": "number" }
                  }
                ]
              },
              "extractionMethod": { "type": "string", "minLength": 1 }
            }
          },
          "blockerReason": { "type": "string" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
