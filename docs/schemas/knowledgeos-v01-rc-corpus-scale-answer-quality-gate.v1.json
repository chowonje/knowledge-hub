{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-hub.product.knowledgeos-v01-rc-corpus-scale-answer-quality-gate.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "inputs",
    "qualityGateDecision",
    "counts",
    "gate",
    "qualityAxisRows",
    "checkRows",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "checkRow": {
      "type": "object",
      "required": ["checkId", "status", "blockers"],
      "additionalProperties": false,
      "properties": {
        "checkId": { "type": "string" },
        "status": { "enum": ["pass", "fail"] },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "axisRow": {
      "type": "object",
      "required": ["axisId", "status", "required", "observedRows", "blockers"],
      "additionalProperties": false,
      "properties": {
        "axisId": { "type": "string" },
        "status": { "enum": ["pass", "fail", "blocked"] },
        "required": { "type": "string" },
        "observedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "properties": {
    "schema": { "const": "knowledge-hub.product.knowledgeos-v01-rc-corpus-scale-answer-quality-gate.v1" },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string" },
    "decision": {
      "enum": [
        "knowledgeos_v01_rc_corpus_scale_answer_quality_gate_ready",
        "knowledgeos_v01_rc_corpus_scale_answer_quality_gate_held",
        "knowledgeos_v01_rc_corpus_scale_answer_quality_gate_blocked"
      ]
    },
    "nextRecommendedTranche": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["postMergeReportRef", "seedSource", "noAnswerReportRef", "labsQualityReportRef"],
      "additionalProperties": false,
      "properties": {
        "postMergeReportRef": { "type": "string" },
        "seedSource": { "const": "complex_qa_seed_pack_20_paper_50_question" },
        "noAnswerReportRef": { "type": "string" },
        "labsQualityReportRef": { "type": "string" }
      }
    },
    "qualityGateDecision": {
      "type": "object",
      "required": ["corpusScaleGate", "publicDefaultDecision", "generalRcDecision", "nextGate", "gateBlockers"],
      "additionalProperties": false,
      "properties": {
        "corpusScaleGate": { "enum": ["green", "held", "blocked"] },
        "publicDefaultDecision": { "const": "hold_public_default_promotion" },
        "generalRcDecision": { "const": "blocked_pending_corpus_scale_answer_quality" },
        "nextGate": { "type": "string" },
        "gateBlockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "corpusScaleAnswerQualityGateRows",
        "seedPaperRows",
        "seedQuestionRows",
        "abstainBaselineRows",
        "abstainNoAnswerPassRows",
        "abstainNoAnswerExpectedRows",
        "defaultOffNoAnswerPassRows",
        "labsQualityInputRows",
        "labsQualityPassRows",
        "structuredEvidenceComparisonRows",
        "strictEvidenceAvailableRows",
        "plannedAnswerQualityDryRunRows",
        "liveAnswerExecutionRows",
        "answerQualityMeasuredRows",
        "qualityAxisRows",
        "qualityAxisPassRows",
        "qualityAxisBlockedRows",
        "corpusScaleAnswerQualityGateGreenRows",
        "corpusScaleAnswerQualityGateHeldRows",
        "publicDefaultPromotionReadyRows",
        "publicDefaultPromotionHeldRows",
        "generalRcReadyRows",
        "blockedRows",
        "candidateStoreWriteRows",
        "sourceSpanCreatedRows",
        "strictEvidenceRows",
        "citationGradeEvidenceRows",
        "runtimeEvidenceRows",
        "parserExecutionRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "canonicalParsedArtifactWriteRows",
        "vaultScanRows",
        "externalDownloadRows",
        "publicCliFlagRows",
        "defaultOnRows",
        "externalLlmCallRows",
        "modelApiCallRows",
        "judgeModelCallRows",
        "answerGeneratedRows",
        "answerQualityScoreComputedRows",
        "answerPathInvokedRows",
        "llmCallRows",
        "githubPrMutationRows",
        "mergeRows",
        "branchDeletionRows",
        "releaseTagRows",
        "packagePublishRows",
        "rawPayloadPersistedRows",
        "defaultMcpToolRows",
        "defaultKhubAskRouteRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "additionalProperties": false,
      "properties": {
        "corpusScaleAnswerQualityGateRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "seedPaperRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "seedQuestionRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "abstainBaselineRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "abstainNoAnswerPassRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "abstainNoAnswerExpectedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "defaultOffNoAnswerPassRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "labsQualityInputRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "labsQualityPassRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "structuredEvidenceComparisonRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "strictEvidenceAvailableRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "plannedAnswerQualityDryRunRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "liveAnswerExecutionRows": { "const": 0 },
        "answerQualityMeasuredRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "qualityAxisRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "qualityAxisPassRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "qualityAxisBlockedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "corpusScaleAnswerQualityGateGreenRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "corpusScaleAnswerQualityGateHeldRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "publicDefaultPromotionReadyRows": { "const": 0 },
        "publicDefaultPromotionHeldRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "generalRcReadyRows": { "const": 0 },
        "blockedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "candidateStoreWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeEvidenceRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "parserExecutionRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "publicCliFlagRows": { "const": 0 },
        "defaultOnRows": { "const": 0 },
        "externalLlmCallRows": { "const": 0 },
        "modelApiCallRows": { "const": 0 },
        "judgeModelCallRows": { "const": 0 },
        "answerGeneratedRows": { "const": 0 },
        "answerQualityScoreComputedRows": { "const": 0 },
        "answerPathInvokedRows": { "const": 0 },
        "llmCallRows": { "const": 0 },
        "githubPrMutationRows": { "const": 0 },
        "mergeRows": { "const": 0 },
        "branchDeletionRows": { "const": 0 },
        "releaseTagRows": { "const": 0 },
        "packagePublishRows": { "const": 0 },
        "rawPayloadPersistedRows": { "const": 0 },
        "defaultMcpToolRows": { "const": 0 },
        "defaultKhubAskRouteRows": { "const": 0 },
        "privatePathLeakRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "schemaViolationCount": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "reportReady",
        "corpusScaleAnswerQualityGateGreen",
        "seedBreadthReady",
        "noAnswerSafetyReady",
        "strictEvidenceReadyRowsMeetThreshold",
        "liveAnswerQualityMeasured",
        "publicDefaultPromotionAllowed",
        "generalRcReady",
        "semanticViolations"
      ],
      "additionalProperties": false,
      "properties": {
        "reportReady": { "type": "boolean" },
        "corpusScaleAnswerQualityGateGreen": { "type": "boolean" },
        "seedBreadthReady": { "type": "boolean" },
        "noAnswerSafetyReady": { "type": "boolean" },
        "strictEvidenceReadyRowsMeetThreshold": { "type": "boolean" },
        "liveAnswerQualityMeasured": { "type": "boolean" },
        "publicDefaultPromotionAllowed": { "const": false },
        "generalRcReady": { "const": false },
        "semanticViolations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "qualityAxisRows": { "type": "array", "items": { "$ref": "#/$defs/axisRow" } },
    "checkRows": { "type": "array", "items": { "$ref": "#/$defs/checkRow" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
