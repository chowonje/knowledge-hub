{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-hub.paper.evidence-chunk-answer-preview.result.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "mode",
    "question",
    "paperIds",
    "sourceType",
    "retrievalMode",
    "alpha",
    "topK",
    "allowExternal",
    "queryPlan",
    "answer",
    "answerable",
    "adapterDiagnostics",
    "evidencePacketSummary",
    "evidencePacketContractSummary",
    "citations",
    "sources",
    "warnings",
    "safety"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "knowledge-hub.paper.evidence-chunk-answer-preview.result.v1" },
    "status": { "enum": ["ok", "no_evidence"] },
    "mode": { "const": "labs_opt_in_preview" },
    "question": { "type": "string" },
    "paperIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "sourceType": { "const": "paper" },
    "retrievalMode": { "enum": ["semantic", "keyword", "hybrid"] },
    "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
    "topK": { "type": "integer", "minimum": 1 },
    "allowExternal": { "const": false },
    "queryPlan": {
      "type": "object",
      "required": [
        "family",
        "parsed_artifact_evidence_chunk_adapter",
        "parsedArtifactEvidenceChunkAdapter",
        "resolvedPaperIds"
      ],
      "additionalProperties": false,
      "properties": {
        "family": { "const": "paper_lookup" },
        "parsed_artifact_evidence_chunk_adapter": { "const": "runtime_v1" },
        "parsedArtifactEvidenceChunkAdapter": { "const": "runtime_v1" },
        "resolvedPaperIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "answer": { "type": "string" },
    "answerable": { "type": "boolean" },
    "adapterDiagnostics": { "type": "object", "additionalProperties": true },
    "evidencePacketSummary": {
      "type": "object",
      "required": [
        "answerable",
        "selectedEvidenceCount",
        "citationCount",
        "adapterStatus",
        "adapterRowsAdded",
        "adapterCandidateRowsConsidered"
      ],
      "additionalProperties": false,
      "properties": {
        "answerable": { "type": "boolean" },
        "selectedEvidenceCount": { "type": "integer", "minimum": 0 },
        "citationCount": { "type": "integer", "minimum": 0 },
        "adapterStatus": { "type": "string" },
        "adapterRowsAdded": { "type": "integer", "minimum": 0 },
        "adapterCandidateRowsConsidered": { "type": "integer", "minimum": 0 }
      }
    },
    "evidencePacketContractSummary": {
      "type": "object",
      "required": ["answerable", "spanRows"],
      "additionalProperties": false,
      "properties": {
        "answerable": { "type": "boolean" },
        "spanRows": { "type": "integer", "minimum": 0 }
      }
    },
    "citations": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "sources": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "safety": {
      "type": "object",
      "required": [
        "labsOnly",
        "publicKhubAskChanged",
        "defaultMcpAskChanged",
        "explicitPaperIdsRequired",
        "sourceTypeForced",
        "externalModelCallsAllowed"
      ],
      "additionalProperties": false,
      "properties": {
        "labsOnly": { "const": true },
        "publicKhubAskChanged": { "const": false },
        "defaultMcpAskChanged": { "const": false },
        "explicitPaperIdsRequired": { "const": true },
        "sourceTypeForced": { "const": "paper" },
        "externalModelCallsAllowed": { "const": false }
      }
    }
  }
}
