{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-hub.paper.structured-evidence-vertical-slice-implementation.v1",
  "type": "object",
  "required": [
    "schema",
    "generatedAt",
    "runId",
    "apply",
    "scopeNote",
    "inputs",
    "policy",
    "minimalEvidenceTypes",
    "deferredEvidenceTypes",
    "papers",
    "counts"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.structured-evidence-vertical-slice-implementation.v1" },
    "generatedAt": { "type": "string" },
    "runId": { "type": "string" },
    "apply": { "type": "boolean" },
    "scopeNote": { "type": "string" },
    "inputs": { "type": "object", "additionalProperties": true },
    "policy": {
      "type": "object",
      "required": [
        "runtimeAnswerIntegration",
        "complexQaEval",
        "manifestMutation",
        "tableEquationParser",
        "citationGradePromotion",
        "runtimeEvidencePromotion",
        "sourceContentHashAuthority"
      ],
      "properties": {
        "runtimeAnswerIntegration": { "const": false },
        "complexQaEval": { "const": false },
        "manifestMutation": { "const": false },
        "tableEquationParser": { "const": false },
        "citationGradePromotion": { "const": false },
        "runtimeEvidencePromotion": { "const": false },
        "sourceContentHashAuthority": { "type": "string" }
      },
      "additionalProperties": true
    },
    "minimalEvidenceTypes": { "type": "array", "items": { "type": "string" } },
    "deferredEvidenceTypes": { "type": "array", "items": { "type": "string" } },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "status"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "mode": { "type": "string" },
          "status": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "counts": {
      "type": "object",
      "required": ["paperRows"],
      "properties": {
        "paperRows": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "schemaValidation": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
