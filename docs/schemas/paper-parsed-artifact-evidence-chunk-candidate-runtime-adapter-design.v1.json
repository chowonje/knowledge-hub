      "type": "object",
      "additionalProperties": false,
      "required": [
        "readyForRuntimeAdapterDryRun",
        "readyForRuntimeApply",
        "runtimeCodeChangeAllowed",
        "candidateStoreWriteAllowed",
        "sourceSpanCreationAllowed",
        "runtimeVisibilityAllowed",
        "evidencePromotionAllowed",
        "answerVisibleAllowed",
        "answerableAllowed",
        "schemaViolations"
      ],
      "properties": {
        "readyForRuntimeAdapterDryRun": { "type": "boolean" },
        "readyForRuntimeApply": { "const": false },
        "runtimeCodeChangeAllowed": { "const": false },
        "candidateStoreWriteAllowed": { "const": false },
        "sourceSpanCreationAllowed": { "const": false },
        "runtimeVisibilityAllowed": { "const": false },
        "evidencePromotionAllowed": { "const": false },
        "answerVisibleAllowed": { "const": false },
        "answerableAllowed": { "const": false },
        "schemaViolations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
