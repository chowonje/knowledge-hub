        "adapterMode": { "const": "opt_in_runtime_design" },
        "integrationBoundary": {
          "const": "knowledge_hub.ai.evidence_assembly.EvidenceAssemblyService.assemble"
        },
        "insertionPoint": { "type": "string", "minLength": 1 },
        "activationPolicy": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "sourceTypeRequired",
            "queryPlanOptInKeys",
            "queryPlanOptInValue",
            "resolvedPaperIdsRequired",
            "fallbackToAllPapersAllowed",
            "defaultEnabled"
          ],
          "properties": {
            "sourceTypeRequired": { "const": "paper" },
            "queryPlanOptInKeys": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 2
            },
            "queryPlanOptInValue": { "const": "runtime_v1" },
            "resolvedPaperIdsRequired": { "const": true },
            "fallbackToAllPapersAllowed": { "const": false },
            "defaultEnabled": { "const": false }
          }
        },
        "selectionPolicy": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "maxRowsPerResolvedPaper",
            "maxRowsTotal",
            "allowedArtifactTypes",
            "requiresSourceContentHash",
            "requiresCharsLocator",
            "requiresSnippetHash",
            "requiresExcerptReadback"
          ],
          "properties": {
            "maxRowsPerResolvedPaper": { "const": 2 },
            "maxRowsTotal": { "const": 4 },
            "allowedArtifactTypes": {
              "type": "array",
              "items": { "enum": ["paragraph", "section"] },
              "minItems": 2
            },
            "requiresSourceContentHash": { "const": true },
            "requiresCharsLocator": { "const": true },
            "requiresSnippetHash": { "const": true },
            "requiresExcerptReadback": { "const": true }
          }
        },
        "candidateStoreRead": { "type": "object" },
        "futureEvidenceItemShape": { "type": "object" },
        "futureDiagnosticsShape": { "type": "object" },
        "answerabilityPolicy": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "currentTrancheAnswerabilityAllowed",
            "futureAdapterMayAffectAnswerabilityOnlyAfterDryRunAndImplementationGate",
            "legacyRetrievalBypassAllowed"
          ],
          "properties": {
            "currentTrancheAnswerabilityAllowed": { "const": false },
            "futureAdapterMayAffectAnswerabilityOnlyAfterDryRunAndImplementationGate": { "const": true },
            "legacyRetrievalBypassAllowed": { "const": false }
          }
        }
      }
