        "answerIntegrationChanged",
        "databaseMutation",
        "vaultScan",
        "reindexOrReembed",
        "parserExecution",
        "canonicalParsedArtifactsWritten",
        "futureRuntimeAdapterRequired",
        "nextGateRequiredBeforeRuntimeUse"
