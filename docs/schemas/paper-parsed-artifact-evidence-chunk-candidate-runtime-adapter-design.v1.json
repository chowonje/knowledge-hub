        "nextRecommendedTranche": { "type": "string", "minLength": 1 },
        "reportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
        "inputRows": { "type": "integer", "minimum": 0 },
        "contractReviewReadyRows": { "type": "integer", "minimum": 0 },
        "runtimeAdapterDesignCandidateRows": { "type": "integer", "minimum": 0 },
        "answerableRows": { "const": 0 },
        "blockedRows": { "const": 0 },
        "privatePathLeakRows": { "const": 0 },
