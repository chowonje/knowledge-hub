      "properties": {
        "reportOnly": { "const": true },
        "runtimeAdapterDesignOnly": { "const": true },
        "runtimeCodeChanged": { "const": false },
        "evidenceAssemblyChanged": { "const": false },
        "candidateStoreReadOnlyPlanned": { "const": true },
