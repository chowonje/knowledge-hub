        "inputRows": { "type": "integer", "minimum": 0 },
        "contractReadyInputRows": { "type": "integer", "minimum": 0 },
        "runtimeAdapterDesignReadyRows": { "type": "integer", "minimum": 0 },
        "futureAdapterCandidateRows": { "type": "integer", "minimum": 0 },
        "plannedCandidateStoreReadRows": { "type": "integer", "minimum": 0 },
        "plannedEvidenceItemShapeRows": { "type": "integer", "minimum": 0 },
        "plannedDiagnosticsRows": { "type": "integer", "minimum": 0 },
        "answerableRows": { "const": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "blockedInputSchemaViolationRows": { "type": "integer", "minimum": 0 },
        "blockedContractNotReadyRows": { "type": "integer", "minimum": 0 },
        "blockedMissingRequiredFieldRows": { "type": "integer", "minimum": 0 },
        "blockedInvalidLocatorRows": { "type": "integer", "minimum": 0 },
        "blockedPolicyQuarantineRows": { "type": "integer", "minimum": 0 },
        "blockedPrivatePathRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "answerVisibleRows": { "const": 0 },
        "answerGenerationRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "parserExecutionRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "privatePathLeakRows": { "type": "integer", "minimum": 0 },
        "schemaViolationCount": { "type": "integer", "minimum": 0 },
        "byArtifactType": { "type": "object" },
        "byAdapterDesignStatus": { "type": "object" }
      }
    },
