{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-parsed-artifact-evidence-chunk-candidate-runtime-adapter-design.v1.json",
  "title": "Parsed Artifact Evidence Chunk Candidate Runtime Adapter Design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "sourceRuntimeContractReview",
    "policy",
    "adapterDesign",
    "counts",
    "gate",
    "rows",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "knowledge-hub.paper.parsed-artifact-evidence-chunk-candidate-runtime-adapter-design.v1"
    },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": [
        "parsed_artifact_evidence_chunk_candidate_runtime_adapter_design_ready",
        "blocked"
      ]
    },
    "nextRecommendedTranche": { "type": "string", "minLength": 1 },
    "sourceRuntimeContractReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "decision",
        "nextRecommendedTranche",
        "reportRef",
        "inputRows",
        "contractReviewReadyRows",
        "runtimeAdapterDesignCandidateRows",
        "answerableRows",
        "blockedRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "properties": {
        "schema": {
          "const": "knowledge-hub.paper.parsed-artifact-evidence-chunk-candidate-runtime-contract-review.v1"
        },
        "status": { "enum": ["ready", "blocked"] },
        "decision": {
          "enum": [
            "parsed_artifact_evidence_chunk_candidate_runtime_contract_review_ready",
