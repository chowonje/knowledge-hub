          "adapterDesignReady": { "type": "boolean" },
          "futureAdapterCandidate": { "type": "boolean" },
          "futureCandidateStoreReadRequired": { "type": "boolean" },
          "futureRuntimeEvidenceAllowed": { "const": false },
          "futureAnswerVisibleAllowed": { "const": false },
          "futureAnswerabilityAllowed": { "const": false },
          "candidateOnly": { "const": true },
          "strictEvidence": { "const": false },
          "citationGrade": { "const": false },
          "runtimeEvidence": { "const": false },
          "answerVisible": { "const": false },
          "answerable": { "const": false },
          "plannedAdapterInputs": { "type": "object" },
          "plannedEvidenceItemShape": { "type": "object" },
          "plannedDiagnosticsShape": { "type": "object" },
          "checks": { "type": "object" }
        }
