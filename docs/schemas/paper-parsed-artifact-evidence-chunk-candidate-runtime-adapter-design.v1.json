    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapterDesignRowId",
          "sourceContractReviewRowId",
          "candidateRecordId",
          "sourceCandidateRowId",
          "paperId",
          "artifactType",
          "sourceRef",
          "sourceContentHash",
          "spanLocator",
          "charStart",
          "charEnd",
          "snippetHash",
          "candidateStoreRef",
          "adapterDesignStatus",
          "adapterDesignBlockers",
          "adapterDesignReady",
          "futureAdapterCandidate",
          "futureCandidateStoreReadRequired",
          "futureRuntimeEvidenceAllowed",
          "futureAnswerVisibleAllowed",
          "futureAnswerabilityAllowed",
          "candidateOnly",
          "strictEvidence",
          "citationGrade",
          "runtimeEvidence",
          "answerVisible",
          "answerable",
          "plannedAdapterInputs",
          "plannedEvidenceItemShape",
          "plannedDiagnosticsShape",
          "checks"
        ],
        "properties": {
          "adapterDesignRowId": { "type": "string", "minLength": 1 },
          "sourceContractReviewRowId": { "type": "string", "minLength": 1 },
          "candidateRecordId": { "type": "string", "minLength": 1 },
          "sourceCandidateRowId": { "type": "string" },
          "paperId": { "type": "string", "minLength": 1 },
          "artifactType": { "enum": ["paragraph", "section", ""] },
          "sourceRef": { "type": "string", "not": { "pattern": "^/" } },
          "sourceContentHash": { "type": "string" },
          "spanLocator": { "type": "string" },
          "charStart": { "type": "integer", "minimum": 0 },
          "charEnd": { "type": "integer", "minimum": 0 },
          "snippetHash": { "type": "string" },
          "candidateStoreRef": { "type": "string", "not": { "pattern": "^/" } },
          "adapterDesignStatus": { "type": "string", "minLength": 1 },
          "adapterDesignBlockers": {
            "type": "array",
            "items": { "type": "string" }
