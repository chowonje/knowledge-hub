{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-hub.paper.equation-authority-record-executor-dry-run.v1",
  "title": "Equation Authority Record Executor Dry Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "input",
    "counts",
    "dryRunOnlyPolicyMatrix",
    "gate",
    "policy",
    "warnings",
    "rows"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.equation-authority-record-executor-dry-run.v1" },
    "status": { "type": "string", "enum": ["ok", "blocked"] },
    "generatedAt": { "type": "string" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equationAuthorityRecordContractReportPath",
        "equationAuthorityRecordContractReportSchema",
        "equationAuthorityRecordContractReportStatus",
        "requestedPaperIds",
        "runId",
        "expectedInputRows",
        "expectedPlannedEquationAuthorityRecordRows"
      ],
      "properties": {
        "equationAuthorityRecordContractReportPath": { "type": "string" },
        "equationAuthorityRecordContractReportSchema": { "type": "string" },
        "equationAuthorityRecordContractReportStatus": { "type": "string" },
        "requestedPaperIds": { "type": "array", "items": { "type": "string" } },
        "runId": { "type": "string" },
        "expectedInputRows": { "type": "integer", "minimum": 0 },
        "expectedPlannedEquationAuthorityRecordRows": { "type": "integer", "minimum": 0 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputRows",
        "plannedEquationAuthorityRecordRows",
        "dryRunReadyEquationAuthorityRecordOnlyRows",
        "blockedContractNotReadyRows",
        "blockedRecordContractStatusNotCandidateRows",
        "blockedMissingEquationAuthorityRecordPreviewRows",
        "blockedMissingEquationAuthorityRecordIdRows",
        "blockedMissingSourceContentHashRows",
        "blockedMissingEquationIdentityDigestRows",
        "blockedMissingEquationHashRows",
        "blockedPlannedRecordSchemaViolationRows",
        "blockedPlannedRecordSemanticViolationRows",
        "blockedInputSchemaViolationRows",
        "equationAuthorityRecordWriteRows",
        "authorityPolicyCreatedRows",
        "equationIdentityPromotedRows",
        "equationHashPromotedRows",
        "equationArtifactCreatedRows",
        "strictEvidenceCreatedRows",
        "sourceSpanMutatedRows",
        "runtimeVisibleRows",
        "answerIntegrationVisibleRows",
        "parserRoutingChangedRows",
        "answerIntegrationChangedRows",
        "databaseMutationRows",
        "indexMutationRows",
        "canonicalParsedArtifactWriteRows",
        "manifestWriteRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "schemaViolationCount",
        "byPaperId",
        "byEnvironment",
        "byDryRunStatus",
        "byRecommendedAction"
      ],
      "properties": {
        "inputRows": { "type": "integer", "minimum": 0 },
        "plannedEquationAuthorityRecordRows": { "type": "integer", "minimum": 0 },
        "dryRunReadyEquationAuthorityRecordOnlyRows": { "type": "integer", "minimum": 0 },
        "blockedContractNotReadyRows": { "type": "integer", "minimum": 0 },
        "blockedRecordContractStatusNotCandidateRows": { "type": "integer", "minimum": 0 },
        "blockedMissingEquationAuthorityRecordPreviewRows": { "type": "integer", "minimum": 0 },
        "blockedMissingEquationAuthorityRecordIdRows": { "type": "integer", "minimum": 0 },
        "blockedMissingSourceContentHashRows": { "type": "integer", "minimum": 0 },
        "blockedMissingEquationIdentityDigestRows": { "type": "integer", "minimum": 0 },
        "blockedMissingEquationHashRows": { "type": "integer", "minimum": 0 },
        "blockedPlannedRecordSchemaViolationRows": { "type": "integer", "minimum": 0 },
        "blockedPlannedRecordSemanticViolationRows": { "type": "integer", "minimum": 0 },
        "blockedInputSchemaViolationRows": { "type": "integer", "minimum": 0 },
        "equationAuthorityRecordWriteRows": { "const": 0 },
        "authorityPolicyCreatedRows": { "const": 0 },
        "equationIdentityPromotedRows": { "const": 0 },
        "equationHashPromotedRows": { "const": 0 },
        "equationArtifactCreatedRows": { "const": 0 },
        "strictEvidenceCreatedRows": { "const": 0 },
        "sourceSpanMutatedRows": { "const": 0 },
        "runtimeVisibleRows": { "const": 0 },
        "answerIntegrationVisibleRows": { "const": 0 },
        "parserRoutingChangedRows": { "const": 0 },
        "answerIntegrationChangedRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "manifestWriteRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "schemaViolationCount": { "type": "integer", "minimum": 0 },
        "byPaperId": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byEnvironment": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byDryRunStatus": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byRecommendedAction": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "dryRunOnlyPolicyMatrix": { "$ref": "#/$defs/noMutationPolicyMatrix" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readyForEquationAuthorityRecordExecutorDryRun",
        "readyForEquationAuthorityRecordExecutorApply",
        "equationAuthorityRecordWriteAllowed",
        "authorityPolicyMutationAllowed",
        "equationArtifactCreationReady",
        "strictEvidenceReady",
        "sourceSpanMutationReady",
        "runtimeVisibleAllowed",
        "parserRoutingReady",
        "answerIntegrationReady",
        "runManifestWriteAllowed",
        "runtimeMutationAllowed",
        "schemaViolations",
        "decision",
        "recommendedNextTranche"
      ],
      "properties": {
        "readyForEquationAuthorityRecordExecutorDryRun": { "type": "boolean" },
        "readyForEquationAuthorityRecordExecutorApply": { "const": false },
        "equationAuthorityRecordWriteAllowed": { "const": false },
        "authorityPolicyMutationAllowed": { "const": false },
        "equationArtifactCreationReady": { "const": false },
        "strictEvidenceReady": { "const": false },
        "sourceSpanMutationReady": { "const": false },
        "runtimeVisibleAllowed": { "const": false },
        "parserRoutingReady": { "const": false },
        "answerIntegrationReady": { "const": false },
        "runManifestWriteAllowed": { "const": false },
        "runtimeMutationAllowed": { "const": false },
        "schemaViolations": { "type": "array", "items": { "type": "string" } },
        "decision": {
          "type": "string",
          "enum": [
            "equation_authority_record_executor_dry_run_ready",
            "equation_authority_record_executor_dry_run_blocked"
          ]
        },
        "recommendedNextTranche": { "type": "string" }
      }
    },
    "policy": {
      "allOf": [
        {
          "type": "object",
          "required": ["reportOnly", "dryRunOnly"],
          "properties": {
            "reportOnly": { "const": true },
            "dryRunOnly": { "const": true }
          }
        },
        { "$ref": "#/$defs/noMutationPolicyMatrix" }
      ]
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/dryRunRow" }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "dry_run_ready_equation_authority_record_only",
        "blocked_contract_not_ready",
        "blocked_record_contract_status_not_candidate",
        "blocked_missing_equation_authority_record_preview",
        "blocked_missing_equation_authority_record_id",
        "blocked_missing_source_content_hash",
        "blocked_missing_equation_identity_digest",
        "blocked_missing_equation_hash",
        "blocked_planned_record_schema_violation",
        "blocked_planned_record_semantic_violation",
        "blocked_input_schema_violation"
      ]
    },
    "noMutationPolicyMatrix": {
      "type": "object",
      "required": [
        "plannedWriteTarget",
        "writeEnabled",
        "equationAuthorityRecordWrite",
        "authorityPolicyCreated",
        "equationIdentityPromoted",
        "equationHashPromoted",
        "equationArtifactCreated",
        "strictEvidenceCreated",
        "sourceSpanMutation",
        "runtimeVisible",
