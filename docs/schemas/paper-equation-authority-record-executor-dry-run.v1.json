        "plannedWriteTarget": { "const": "equation_authority_record_candidate_store" },
        "writeEnabled": { "const": false },
        "equationAuthorityRecordWrite": { "const": false },
        "authorityPolicyCreated": { "const": false },
        "equationIdentityPromoted": { "const": false },
        "equationHashPromoted": { "const": false },
        "equationArtifactCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "sourceSpanMutation": { "const": false },
        "runtimeVisible": { "const": false },
        "answerIntegrationVisible": { "const": false },
        "parserRoutingChanged": { "const": false },
        "answerIntegrationChanged": { "const": false },
        "databaseMutation": { "const": false },
        "indexMutation": { "const": false },
        "vaultScan": { "const": false },
        "reindexOrReembed": { "const": false },
        "canonicalParsedArtifactsWritten": { "const": false },
        "manifestWrite": { "const": false }
      },
      "additionalProperties": true
    },
    "dryRunRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dry_run_row_id",
        "record_contract_row_id",
        "contract_design_row_id",
        "hash_identity_design_row_id",
        "readiness_audit_row_id",
        "paper_id",
        "source_candidate_id",
        "source_file",
        "equation_environment",
        "input_record_contract_status",
        "input_contract_status",
        "input_design_status",
        "readiness_status",
        "dry_run_status",
        "dry_run_blockers",
        "dryRunReadyEquationAuthorityRecordOnly",
        "plannedExecutorKey",
        "plannedWriteTarget",
        "plannedContractVersion",
        "plannedAuthorityDecision",
        "plannedAuthorityState",
        "plannedEquationAuthorityRecord",
        "equationAuthorityRecordWrite",
        "authorityPolicyCreated",
        "equationIdentityPromoted",
        "equationHashPromoted",
        "equationArtifactCreated",
        "strictEvidenceCreated",
        "sourceSpanMutated",
        "runtimeVisible",
        "answerIntegrationVisible",
        "parserRoutingChanged",
        "answerIntegrationChanged",
        "databaseMutation",
        "indexMutation",
        "vaultScan",
        "reindexOrReembed",
        "canonicalParsedArtifactsWritten",
        "manifestWrite",
        "policyMatrix",
        "recommended_action"
      ],
      "properties": {
        "dry_run_row_id": { "type": "string" },
        "record_contract_row_id": { "type": "string" },
        "contract_design_row_id": { "type": "string" },
        "hash_identity_design_row_id": { "type": "string" },
        "readiness_audit_row_id": { "type": "string" },
        "paper_id": { "type": "string" },
        "source_candidate_id": { "type": "string" },
        "source_file": { "type": "string" },
        "equation_environment": { "type": "string" },
        "input_record_contract_status": { "type": "string" },
        "input_contract_status": { "type": "string" },
        "input_design_status": { "type": "string" },
        "readiness_status": { "type": "string" },
        "dry_run_status": { "$ref": "#/$defs/status" },
        "dry_run_blockers": { "type": "array", "items": { "type": "string" } },
        "dryRunReadyEquationAuthorityRecordOnly": { "type": "boolean" },
        "plannedExecutorKey": { "type": "string" },
        "plannedWriteTarget": { "type": "string" },
        "plannedContractVersion": { "type": "string" },
        "plannedAuthorityDecision": { "type": "string" },
        "plannedAuthorityState": { "type": "string" },
        "plannedEquationAuthorityRecord": { "type": "object" },
        "equationAuthorityRecordWrite": { "const": false },
        "authorityPolicyCreated": { "const": false },
        "equationIdentityPromoted": { "const": false },
        "equationHashPromoted": { "const": false },
        "equationArtifactCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "sourceSpanMutated": { "const": false },
        "runtimeVisible": { "const": false },
        "answerIntegrationVisible": { "const": false },
        "parserRoutingChanged": { "const": false },
        "answerIntegrationChanged": { "const": false },
        "databaseMutation": { "const": false },
        "indexMutation": { "const": false },
        "vaultScan": { "const": false },
        "reindexOrReembed": { "const": false },
        "canonicalParsedArtifactsWritten": { "const": false },
        "manifestWrite": { "const": false },
        "policyMatrix": { "$ref": "#/$defs/noMutationPolicyMatrix" },
        "recommended_action": { "type": "string" }
      }
    }
