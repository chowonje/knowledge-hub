{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-source-alias-normalization-report.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "scope",
    "caseRows",
    "shortAliasCaseRows",
    "blockedShortAliasRows",
    "conceptOnlyRows",
    "discoverOnlyRows",
    "contextualAliasResolvedRows",
    "explicitIdResolvedRows",
    "explicitTitleContextRows",
    "unsafeDirectAliasRows",
    "expectationFailureRows",
    "rows",
    "mutationCounters",
    "schemaViolationCount",
    "privatePathLeakRows",
    "warnings",
    "schemaErrors"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.source-alias-normalization-report.v1" },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "aliasPolicy",
        "runtimeWiringChanged",
        "visualLayoutBranchDeferred",
        "strictEvidencePromotionRows",
        "runtimeAnswerVisibleExposureRows"
      ],
      "properties": {
        "writes": { "const": "report_only" },
        "aliasPolicy": { "const": "source_alias_normalization_text_v0_1" },
        "runtimeWiringChanged": { "const": false },
        "visualLayoutBranchDeferred": { "const": true },
        "strictEvidencePromotionRows": { "const": 0 },
        "runtimeAnswerVisibleExposureRows": { "const": 0 }
      }
    },
    "caseRows": { "type": "integer", "minimum": 0 },
    "shortAliasCaseRows": { "type": "integer", "minimum": 0 },
    "blockedShortAliasRows": { "type": "integer", "minimum": 0 },
    "conceptOnlyRows": { "type": "integer", "minimum": 0 },
    "discoverOnlyRows": { "type": "integer", "minimum": 0 },
    "contextualAliasResolvedRows": { "type": "integer", "minimum": 0 },
    "explicitIdResolvedRows": { "type": "integer", "minimum": 0 },
    "explicitTitleContextRows": { "type": "integer", "minimum": 0 },
    "unsafeDirectAliasRows": { "const": 0 },
    "expectationFailureRows": { "const": 0 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "caseId",
          "query",
          "queryHash",
          "shortAlias",
          "shortAliasPresent",
          "description",
          "family",
          "disposition",
          "expectedDisposition",
          "expectationMet",
          "sourceResolutionPolicy",
          "directShortAliasResolutionAllowed",
          "contextSignals",
          "contextTerms",
          "explicitPaperId",
          "explicitTitle",
          "queryPlan",
          "queryPlanResolvedPaperIdRows",
          "unsafeDirectAliasResolution",
          "blockerReason",
          "runtimeWiringChangedRows",
          "strictEvidencePromotionRows",
          "runtimeAnswerVisibleExposureRows"
        ],
        "properties": {
          "schema": { "const": "knowledge-hub.paper.source-alias-normalization-case.v1" },
          "caseId": { "type": "string", "minLength": 1 },
          "query": { "type": "string", "minLength": 1 },
          "queryHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "shortAlias": { "enum": ["RAG", "GPT", "CNN", "VLM"] },
          "shortAliasPresent": { "type": "boolean" },
          "description": { "type": "string" },
          "family": { "type": "string" },
          "disposition": { "type": "string" },
          "expectedDisposition": { "type": "string" },
          "expectationMet": { "const": true },
          "sourceResolutionPolicy": { "type": "string" },
          "directShortAliasResolutionAllowed": { "type": "boolean" },
          "contextSignals": { "type": "array", "items": { "type": "string" } },
          "contextTerms": { "type": "array", "items": { "type": "string" } },
          "explicitPaperId": { "type": "string" },
          "explicitTitle": { "type": "string" },
          "queryPlan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "entities", "expandedTerms", "resolvedPaperIds", "answerMode"],
            "properties": {
              "family": { "type": "string" },
              "entities": { "type": "array", "items": { "type": "string" } },
              "expandedTerms": { "type": "array", "items": { "type": "string" } },
              "resolvedPaperIds": { "type": "array", "items": { "type": "string" } },
              "answerMode": { "type": "string" }
            }
          },
          "queryPlanResolvedPaperIdRows": { "type": "integer", "minimum": 0 },
          "unsafeDirectAliasResolution": { "const": false },
          "blockerReason": { "type": "string" },
          "runtimeWiringChangedRows": { "const": 0 },
          "strictEvidencePromotionRows": { "const": 0 },
          "runtimeAnswerVisibleExposureRows": { "const": 0 }
        }
      }
    },
    "mutationCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalParsedArtifactWriteRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "externalDownloadRows",
        "runtimeWiringChangedRows",
        "strictEvidencePromotionRows",
        "runtimeAnswerVisibleExposureRows"
      ],
      "properties": {
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "runtimeWiringChangedRows": { "const": 0 },
        "strictEvidencePromotionRows": { "const": 0 },
        "runtimeAnswerVisibleExposureRows": { "const": 0 }
      }
    },
    "schemaViolationCount": { "const": 0 },
    "privatePathLeakRows": { "const": 0 },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "schemaErrors": { "type": "array", "items": { "type": "string" } }
  }
}
