{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-hub.paper.complex-qa-strict-evidence-answer-quality-dry-run.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "generatedAt",
    "runner",
    "inputs",
    "counts",
    "policy",
    "warnings",
    "semanticViolations",
    "rows"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.complex-qa-strict-evidence-answer-quality-dry-run.v1" },
    "status": { "type": "string", "enum": ["ok", "blocked"] },
    "generatedAt": { "type": "string" },
    "runner": {
      "type": "object",
      "required": ["name", "version", "mode", "purpose", "nextRecommendedTranche"],
      "properties": {
        "name": { "const": "complex-qa-strict-evidence-answer-quality-dry-run" },
        "version": { "type": "string" },
        "mode": { "const": "report_only_answer_quality_planning_dry_run" },
        "purpose": { "type": "string" },
        "nextRecommendedTranche": { "const": "complex QA strict-evidence supplied answer-quality grader design" }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "required": [
        "comparisonReport",
        "comparisonReportSchema",
        "comparisonStatus",
        "comparisonQuestionRows",
        "comparisonReadyRows"
      ],
      "properties": {
        "comparisonReport": { "type": "string" },
        "comparisonReportSchema": { "const": "knowledge-hub.paper.complex-qa-structured-evidence-comparison-runner.v1" },
        "comparisonStatus": { "type": "string", "enum": ["ok", "blocked", ""] },
        "comparisonQuestionRows": { "type": "integer", "minimum": 0 },
        "comparisonReadyRows": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "required": [
        "questionRows",
        "comparisonRows",
        "comparisonReadyRows",
        "strictEvidenceAvailableRows",
        "structuredEvidenceRefRows",
        "plannedAnswerQualityDryRunRows",
        "readyForAnswerQualityComparisonRows",
        "stableExpectedNoAnswerRows",
        "blockedMissingStrictEvidenceRows",
        "answerGeneratedRows",
        "answerQualityScoreComputedRows",
        "llmCallRows",
        "judgeModelCallRows",
        "answerPathInvokedRows",
        "unsafeAnsweredRows",
        "databaseMutationRows",
        "indexMutationRows",
        "vaultScanRows",
        "runtimeEvidenceCreatedRows",
        "citationEvidenceCreatedRows",
        "strictEvidenceCreatedRows",
        "reindexOrReembedRows",
        "schemaViolationCount",
        "plannedAnswerQualityDryRunRate",
        "unsafeAnswerRate",
        "byQuestionCategory",
        "byAnswerabilityExpectation",
        "byAnswerQualityDryRunVerdict",
        "byExpectedEvidenceType"
      ],
      "properties": {
        "questionRows": { "type": "integer", "minimum": 0 },
        "comparisonRows": { "type": "integer", "minimum": 0 },
        "comparisonReadyRows": { "type": "integer", "minimum": 0 },
        "strictEvidenceAvailableRows": { "type": "integer", "minimum": 0 },
        "structuredEvidenceRefRows": { "type": "integer", "minimum": 0 },
        "plannedAnswerQualityDryRunRows": { "type": "integer", "minimum": 0 },
        "readyForAnswerQualityComparisonRows": { "type": "integer", "minimum": 0 },
        "stableExpectedNoAnswerRows": { "type": "integer", "minimum": 0 },
        "blockedMissingStrictEvidenceRows": { "type": "integer", "minimum": 0 },
        "answerGeneratedRows": { "const": 0 },
        "answerQualityScoreComputedRows": { "const": 0 },
        "llmCallRows": { "const": 0 },
        "judgeModelCallRows": { "const": 0 },
        "answerPathInvokedRows": { "const": 0 },
        "unsafeAnsweredRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "runtimeEvidenceCreatedRows": { "const": 0 },
        "citationEvidenceCreatedRows": { "const": 0 },
        "strictEvidenceCreatedRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "schemaViolationCount": { "const": 0 },
        "plannedAnswerQualityDryRunRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "unsafeAnswerRate": { "const": 0 },
        "byQuestionCategory": { "type": "object" },
        "byAnswerabilityExpectation": { "type": "object" },
        "byAnswerQualityDryRunVerdict": { "type": "object" },
        "byExpectedEvidenceType": { "type": "object" }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": [
        "reportOnly",
        "dryRunOnly",
        "answerQualityPlanningOnly",
        "strictEvidenceReadOnly",
        "questionExecutionRun",
        "answerGenerationRun",
        "answerQualityScoringRun",
        "llmCalls",
        "judgeModelCalls",
        "answerPathChanged",
        "answerPathInvoked",
        "searchIndexQueried",
        "databaseMutation",
        "indexMutation",
        "reindexOrReembed",
        "vaultScan",
        "runtimeEvidenceCreated",
        "citationEvidenceCreated",
        "strictEvidenceCreated",
        "parserRoutingChanged",
        "canonicalParsedArtifactsWritten"
      ],
      "properties": {
        "reportOnly": { "const": true },
        "dryRunOnly": { "const": true },
        "answerQualityPlanningOnly": { "const": true },
        "strictEvidenceReadOnly": { "const": true },
        "questionExecutionRun": { "const": false },
        "answerGenerationRun": { "const": false },
        "answerQualityScoringRun": { "const": false },
        "llmCalls": { "const": false },
        "judgeModelCalls": { "const": false },
        "answerPathChanged": { "const": false },
        "answerPathInvoked": { "const": false },
        "searchIndexQueried": { "const": false },
        "databaseMutation": { "const": false },
        "indexMutation": { "const": false },
        "reindexOrReembed": { "const": false },
        "vaultScan": { "const": false },
        "runtimeEvidenceCreated": { "const": false },
        "citationEvidenceCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "parserRoutingChanged": { "const": false },
        "canonicalParsedArtifactsWritten": { "const": false }
      },
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "semanticViolations": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "questionId",
          "paperIds",
          "questionCategory",
          "expectedEvidenceType",
          "answerabilityExpectation",
          "comparisonVerdict",
          "strictEvidenceAvailable",
          "structuredEvidenceRefs",
          "readyForAnswerQualityComparison",
          "answerQualityDryRunVerdict",
          "plannedAnswerQualityDryRun",
          "plannedAnswerQualityChecks",
          "plannedAnswerQualityContract",
          "dryRunBlockers",
          "answerGenerated",
          "answerQualityScoreComputed",
          "llmCall",
          "judgeModelCall",
          "answerPathInvoked",
          "unsafeAnswered",
          "riskNotes"
        ],
        "properties": {
          "questionId": { "type": "string", "minLength": 1 },
          "paperIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "questionCategory": {
            "type": "string",
            "enum": [
              "table_numeric_qa",
              "equation_citation_qa",
              "figure_caption_qa",
              "method_comparison_qa",
              "limitation_qa",
              "appendix_table_lookup_qa"
            ]
          },
          "expectedEvidenceType": {
            "type": "string",
            "enum": [
              "table_cell_numeric",
              "equation_source_span",
              "figure_caption_source_span",
              "cross_paper_method_spans",
              "limitation_section_span",
              "appendix_table_cell"
            ]
          },
          "answerabilityExpectation": {
            "type": "string",
            "enum": [
              "answerable",
              "expected_no_answer",
              "blocked_until_structured_evidence"
            ]
          },
          "comparisonVerdict": {
            "type": "string",
            "enum": [
              "stable_expected_no_answer",
              "still_blocked_missing_strict_structured_evidence",
              "candidate_answerable_with_strict_structured_evidence",
              "answerable_seed_blocked_missing_strict_evidence",
              "schema_violation_unknown_answerability"
            ]
          },
          "strictEvidenceAvailable": { "type": "boolean" },
          "structuredEvidenceRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "readyForAnswerQualityComparison": { "type": "boolean" },
          "answerQualityDryRunVerdict": {
            "type": "string",
            "enum": [
              "planned_strict_evidence_answer_quality_dry_run",
              "stable_expected_no_answer_no_quality_run",
              "blocked_missing_strict_structured_evidence",
              "schema_violation_unknown_comparison_verdict"
            ]
          },
          "plannedAnswerQualityDryRun": { "type": "boolean" },
          "plannedAnswerQualityChecks": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "plannedAnswerQualityContract": { "type": "object" },
          "dryRunBlockers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "answerGenerated": { "const": false },
          "answerQualityScoreComputed": { "const": false },
          "llmCall": { "const": false },
          "judgeModelCall": { "const": false },
          "answerPathInvoked": { "const": false },
          "unsafeAnswered": { "const": false },
          "riskNotes": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "reportPaths": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": true
}
