{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-hub.paper.parsed-artifact-manual-lookup-source-recovery-decision-file-human-review.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "generatedAt",
    "report",
    "inputDecisionFileValidation",
    "inputDecisionFile",
    "counts",
    "coverageTarget",
    "remainingBlockerClosure",
    "textSourceHoldoutPaperIds",
    "textSourceHoldouts",
    "humanReviewRows",
    "gate",
    "mutationPolicy",
    "mutationCounters",
    "operatorInstructions",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "knowledge-hub.paper.parsed-artifact-manual-lookup-source-recovery-decision-file-human-review.v1"
    },
    "status": {
      "type": "string",
      "enum": ["decision_file_human_review_ready", "blocked"]
    },
    "generatedAt": { "type": "string" },
    "report": {
      "type": "object",
      "required": ["name", "selectionRule", "nonScope"],
      "properties": {
        "name": { "type": "string" },
        "inputDecisionFileValidationReportPath": { "type": "string" },
        "inputDecisionFilePath": { "type": "string" },
        "inputReviewPackReportPath": { "type": "string" },
        "inputSourceRecoveryFeasibilityReportPath": { "type": "string" },
        "selectionRule": { "type": "string" },
        "nonScope": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "inputDecisionFileValidation": {
      "type": "object",
      "required": ["schemaValidation", "schema", "status", "validRows"],
      "properties": {
        "schemaValidation": { "$ref": "#/$defs/validation" },
        "schema": { "type": "string" },
        "status": { "type": "string" },
        "validRows": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "inputDecisionFile": {
      "type": "object",
      "required": ["draftOnly", "decisionRows"],
      "properties": {
        "draftOnly": { "type": "boolean" },
        "decisionRows": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "required": [
        "manualReviewRows",
        "needsReviewRows",
        "nonNeedsReviewRows",
        "validValidationRows",
        "textSourceHoldoutRows",
        "unexpectedBlockerCount",
        "unsafeUpstreamFlagCount",
        "decisionTaxonomy",
        "validationStatusTaxonomy"
      ],
      "properties": {
        "manualReviewRows": { "type": "integer", "minimum": 0 },
        "needsReviewRows": { "type": "integer", "minimum": 0 },
        "nonNeedsReviewRows": { "type": "integer", "minimum": 0 },
        "validValidationRows": { "type": "integer", "minimum": 0 },
        "textSourceHoldoutRows": { "type": "integer", "minimum": 0 },
        "unexpectedBlockerCount": { "type": "integer", "minimum": 0 },
        "unsafeUpstreamFlagCount": { "type": "integer", "minimum": 0 },
        "decisionTaxonomy": { "$ref": "#/$defs/taxonomy" },
        "validationStatusTaxonomy": { "$ref": "#/$defs/taxonomy" },
        "externalLookupRows": { "const": 0 },
        "sourceDownloadRows": { "const": 0 },
        "sourcePathRewriteRows": { "const": 0 },
        "sourceRegistrationMutationRows": { "const": 0 },
        "parsedArtifactWriteRows": { "const": 0 },
        "parserRoutingRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationEvidenceRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultReadRows": { "const": 0 },
        "vaultWriteRows": { "const": 0 },
        "answerIntegrationRows": { "const": 0 },
        "manualBlockerResolutionRows": { "const": 0 },
        "runManifestWriteRows": { "const": 0 },
        "decisionFileMutationRows": { "const": 0 },
        "humanDecisionRecordingRows": { "const": 0 }
      },
      "additionalProperties": true
    },
    "coverageTarget": { "type": "object" },
    "remainingBlockerClosure": {
      "type": "object",
      "required": [
        "automatedRecoveryTranchesClosed",
        "missingParsedArtifactsRemaining",
        "blockerTaxonomy",
        "unexpectedBlockerReasons",
        "unexpectedBlockerCount"
      ],
      "properties": {
        "automatedRecoveryTranchesClosed": { "type": "boolean" },
        "missingParsedArtifactsRemaining": { "type": "integer", "minimum": 0 },
        "blockerTaxonomy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason", "count", "workflow"],
            "properties": {
              "reason": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 },
              "workflow": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "unexpectedBlockerReasons": { "type": "array", "items": { "type": "string" } },
        "unexpectedBlockerCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "textSourceHoldoutPaperIds": { "type": "array", "items": { "type": "string" } },
    "textSourceHoldouts": { "type": "array", "items": { "type": "object" } },
    "humanReviewRows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "humanReviewRowId",
          "sourceReviewCardId",
          "paperId",
          "currentDecision",
          "allowedDecisions",
          "validationStatus",
          "reportOnly"
        ],
        "properties": {
          "humanReviewRowId": { "type": "string" },
          "sourceReviewCardId": { "type": "string" },
          "paperId": { "type": "string" },
          "paperTitle": { "type": "string" },
          "manualLookupMode": { "type": "string" },
          "lookupPriority": { "type": "string" },
          "lookupQueries": { "type": "object" },
          "preferredReviewOrder": { "type": "array" },
          "currentDecision": { "type": "string" },
          "allowedDecisions": { "type": "array", "items": { "type": "string" } },
          "validationStatus": { "type": "string" },
          "validationBlockers": { "type": "array", "items": { "type": "string" } },
          "reviewPrompt": { "type": "string" },
          "decisionEditTarget": { "type": "string" },
          "decisionScope": { "type": "string" },
          "evidenceTier": { "type": "string" },
          "reportOnly": { "const": true },
          "externalLookupAttempted": { "const": false },
          "sourceDownloadAttempted": { "const": false },
          "sourceRegistrationMutationAttempted": { "const": false },
          "parsedArtifactWriteAttempted": { "const": false },
          "strictEligible": { "const": false },
          "citationGrade": { "const": false },
          "runtimeEvidence": { "const": false },
          "answerIntegration": { "const": false }
        },
        "additionalProperties": true
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "humanReviewSheetReady",
        "automatedBlockerTrancheClosed",
        "containsOnlyNeedsReviewDecisions",
        "containsNonNeedsReviewDecisions",
        "applyReady",
        "sourceRegistrationMutationReady",
        "parsedArtifactMaterializationReady",
        "parserRoutingReady",
        "strictEvidenceReady",
        "answerIntegrationReady",
        "decision",
        "schemaViolations",
        "unsafeUpstreamFlags",
        "recommendedNextTranche"
      ],
      "properties": {
        "humanReviewSheetReady": { "type": "boolean" },
        "automatedBlockerTrancheClosed": { "type": "boolean" },
        "containsOnlyNeedsReviewDecisions": { "type": "boolean" },
        "containsNonNeedsReviewDecisions": { "type": "boolean" },
        "applyReady": { "const": false },
        "sourceRegistrationMutationReady": { "const": false },
        "parsedArtifactMaterializationReady": { "const": false },
        "parserRoutingReady": { "const": false },
        "strictEvidenceReady": { "const": false },
        "answerIntegrationReady": { "const": false },
        "decision": { "type": "string" },
        "schemaViolations": { "type": "array", "items": { "type": "string" } },
        "unsafeUpstreamFlags": { "type": "array", "items": { "type": "string" } },
        "recommendedNextTranche": { "type": "string" }
      },
      "additionalProperties": true
    },
    "mutationPolicy": { "type": "object" },
    "mutationCounters": { "type": "object" },
    "operatorInstructions": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "validation": {
      "type": "object",
      "required": ["ok", "errors"],
      "properties": {
        "ok": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "taxonomy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason", "count"],
        "properties": {
          "reason": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  }
}
