    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "spanRef",
          "citationLabel",
          "sourceId",
          "sourceType",
          "sourceRef",
          "sourceContentHash",
          "contentHash",
          "spanLocator",
          "charStart",
          "charEnd",
          "evidenceKind",
          "candidateRecordId",
          "candidateStoreRef",
          "artifactType",
          "excerptIncludedInReport"
        ],
        "additionalProperties": false,
        "properties": {
          "spanRef": { "type": "string" },
          "citationLabel": { "type": "string" },
          "sourceId": { "type": "string" },
          "sourceType": { "type": "string" },
          "sourceRef": { "type": "string" },
          "sourceContentHash": { "type": "string" },
          "contentHash": { "type": "string" },
          "spanLocator": { "type": "string" },
          "charStart": { "type": ["integer", "null"] },
          "charEnd": { "type": ["integer", "null"] },
          "evidenceKind": { "type": "string" },
          "candidateRecordId": { "type": "string" },
          "candidateStoreRef": { "type": "string" },
          "artifactType": { "type": "string" },
          "excerptIncludedInReport": { "const": false }
        }
      }
    },
