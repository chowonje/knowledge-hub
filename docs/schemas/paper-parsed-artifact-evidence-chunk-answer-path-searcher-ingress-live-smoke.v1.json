      "additionalProperties": false,
      "properties": {
        "readyForDefaultOffNoAnswerRegressionSmoke": { "type": "boolean" },
        "searcherAnswerPathInvoked": { "const": true },
        "queryPlanOptInPreserved": { "type": "boolean" },
        "runtimeAdapterApplied": { "type": "boolean" },
        "answerPayloadStatusOk": { "type": "boolean" },
        "externalModelCallsDisabled": { "const": true },
        "publicDefaultUnchanged": { "const": true },
        "schemaViolations": { "type": "array", "items": { "type": "string" } }
      }
