      "properties": {
        "status": { "type": "string" },
        "paperFamily": { "type": "string" },
        "queryPlanOptInSnake": { "type": "string" },
        "queryPlanOptInCamel": { "type": "string" },
        "answerIncludedInReport": { "const": false },
        "evidenceIncludedInReport": { "const": false }
      }
    },
