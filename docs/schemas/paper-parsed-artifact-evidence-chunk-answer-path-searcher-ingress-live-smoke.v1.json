      "additionalProperties": false,
      "properties": {
        "searcherIngressRows": { "const": 1 },
        "queryPlanForwardedRows": { "type": "integer", "minimum": 0, "maximum": 1 },
        "queryPlanOptInPreservedRows": { "type": "integer", "minimum": 0, "maximum": 1 },
        "resolvedPaperRows": { "type": "integer", "minimum": 0 },
        "adapterCandidateRowsConsidered": { "type": "integer", "minimum": 0 },
        "adapterRowsAdded": { "type": "integer", "minimum": 0 },
        "adapterBlockedRows": { "type": "integer", "minimum": 0 },
        "selectedEvidenceCount": { "type": "integer", "minimum": 0 },
        "citationCount": { "type": "integer", "minimum": 0 },
        "evidencePacketContractSpanRows": { "type": "integer", "minimum": 0 },
        "strictProvenanceSpanRows": { "type": "integer", "minimum": 0 },
        "internalAnswerPayloadRows": { "const": 1 },
        "localFakeLlmCallRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "parserExecutionRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "publicCliFlagRows": { "const": 0 },
        "defaultOnRows": { "const": 0 },
        "externalLlmCallRows": { "const": 0 },
        "modelApiCallRows": { "const": 0 },
        "privatePathLeakRows": { "type": "integer", "minimum": 0 },
        "schemaViolationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "readyForDefaultOffNoAnswerRegressionSmoke",
        "searcherAnswerPathInvoked",
        "queryPlanOptInPreserved",
        "runtimeAdapterApplied",
        "answerPayloadStatusOk",
        "externalModelCallsDisabled",
        "publicDefaultUnchanged",
        "schemaViolations"
