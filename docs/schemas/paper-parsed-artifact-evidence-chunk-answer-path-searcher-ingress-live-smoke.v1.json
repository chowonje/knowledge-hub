      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "status": { "type": "string" },
        "resolvedPaperIds": { "type": "array", "items": { "type": "string" } },
        "candidateRowsConsidered": { "type": "integer", "minimum": 0 },
        "rowsAdded": { "type": "integer", "minimum": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "skippedReason": { "type": "string" },
        "selectedCandidateRecordIds": { "type": "array", "items": { "type": "string" } },
        "blockedReasons": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
