{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-parsed-artifact-evidence-chunk-candidate-runtime-contract-review.v1.json",
  "title": "Parsed Artifact Evidence Chunk Candidate Runtime Contract Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "sourceRuntimeIntegrationDryRun",
    "policy",
    "counts",
    "gate",
    "rows",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "knowledge-hub.paper.parsed-artifact-evidence-chunk-candidate-runtime-contract-review.v1"
    },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": [
        "parsed_artifact_evidence_chunk_candidate_runtime_contract_review_ready",
        "blocked"
      ]
    },
    "nextRecommendedTranche": { "type": "string", "minLength": 1 },
    "sourceRuntimeIntegrationDryRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "decision",
        "nextRecommendedTranche",
        "reportRef",
        "inputRows",
        "runtimeIntegrationDryRunReadyRows",
        "plannedEvidencePacketSpanRows",
        "answerableRows",
        "blockedRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "properties": {
        "schema": {
          "const": "knowledge-hub.paper.parsed-artifact-evidence-chunk-candidate-runtime-integration-dry-run.v1"
        },
        "status": { "enum": ["ready", "blocked"] },
        "decision": {
          "enum": [
            "parsed_artifact_evidence_chunk_candidate_runtime_integration_dry_run_ready",
            "blocked"
          ]
        },
        "nextRecommendedTranche": { "type": "string", "minLength": 1 },
        "reportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
        "inputRows": { "type": "integer", "minimum": 0 },
        "runtimeIntegrationDryRunReadyRows": { "type": "integer", "minimum": 0 },
        "plannedEvidencePacketSpanRows": { "type": "integer", "minimum": 0 },
        "answerableRows": { "const": 0 },
        "blockedRows": { "const": 0 },
        "privatePathLeakRows": { "const": 0 },
        "schemaViolationCount": { "const": 0 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportOnly",
        "runtimeContractReviewOnly",
        "evidencePacketPreviewOnly",
        "allowedArtifactTypes",
        "textPreviewIncluded",
        "candidateStoreWrite",
        "sourceSpanCreated",
        "strictEvidenceCreated",
        "citationGradeEvidenceCreated",
        "runtimeEvidenceCreated",
        "answerVisibleExposure",
        "answerGeneration",
        "answerableRowsAllowedInThisTranche",
        "parserRoutingChanged",
        "answerIntegrationChanged",
        "databaseMutation",
        "vaultScan",
        "reindexOrReembed",
        "parserExecution",
        "canonicalParsedArtifactsWritten",
        "futureRuntimeAdapterRequired",
        "nextGateRequiredBeforeRuntimeUse"
      ],
      "properties": {
        "reportOnly": { "const": true },
        "runtimeContractReviewOnly": { "const": true },
        "evidencePacketPreviewOnly": { "const": true },
        "allowedArtifactTypes": {
          "type": "array",
          "items": { "enum": ["section", "paragraph"] },
          "minItems": 2
        },
        "textPreviewIncluded": { "const": false },
        "candidateStoreWrite": { "const": false },
        "sourceSpanCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "citationGradeEvidenceCreated": { "const": false },
        "runtimeEvidenceCreated": { "const": false },
        "answerVisibleExposure": { "const": false },
        "answerGeneration": { "const": false },
        "answerableRowsAllowedInThisTranche": { "const": false },
        "parserRoutingChanged": { "const": false },
        "answerIntegrationChanged": { "const": false },
        "databaseMutation": { "const": false },
        "vaultScan": { "const": false },
        "reindexOrReembed": { "const": false },
        "parserExecution": { "const": false },
        "canonicalParsedArtifactsWritten": { "const": false },
        "futureRuntimeAdapterRequired": { "const": true },
        "nextGateRequiredBeforeRuntimeUse": { "const": true }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputRows",
        "runtimeDryRunReadyInputRows",
        "contractReviewReadyRows",
        "evidencePacketSpanCompatibleRows",
        "answerContractCitationShapeCompatibleRows",
        "strictProvenanceShapeRows",
        "runtimeAdapterDesignCandidateRows",
        "answerableRows",
        "blockedRows",
        "blockedInputSchemaViolationRows",
        "blockedRuntimePreviewNotReadyRows",
        "blockedSourceIdMismatchRows",
        "blockedHashMismatchRows",
        "blockedLocatorMismatchRows",
        "blockedMissingRequiredFieldRows",
        "blockedPolicyQuarantineRows",
        "candidateStoreWriteRows",
        "sourceSpanCreatedRows",
        "strictEvidenceRows",
        "citationGradeRows",
        "runtimeEvidenceRows",
        "answerVisibleRows",
        "answerGenerationRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "parserExecutionRows",
        "canonicalParsedArtifactWriteRows",
        "vaultScanRows",
        "externalDownloadRows",
        "privatePathLeakRows",
        "schemaViolationCount",
        "byArtifactType",
        "byContractReviewStatus"
      ],
      "properties": {
        "inputRows": { "type": "integer", "minimum": 0 },
        "runtimeDryRunReadyInputRows": { "type": "integer", "minimum": 0 },
        "contractReviewReadyRows": { "type": "integer", "minimum": 0 },
        "evidencePacketSpanCompatibleRows": { "type": "integer", "minimum": 0 },
        "answerContractCitationShapeCompatibleRows": { "type": "integer", "minimum": 0 },
        "strictProvenanceShapeRows": { "type": "integer", "minimum": 0 },
        "runtimeAdapterDesignCandidateRows": { "type": "integer", "minimum": 0 },
        "answerableRows": { "const": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "blockedInputSchemaViolationRows": { "type": "integer", "minimum": 0 },
        "blockedRuntimePreviewNotReadyRows": { "type": "integer", "minimum": 0 },
        "blockedSourceIdMismatchRows": { "type": "integer", "minimum": 0 },
        "blockedHashMismatchRows": { "type": "integer", "minimum": 0 },
        "blockedLocatorMismatchRows": { "type": "integer", "minimum": 0 },
        "blockedMissingRequiredFieldRows": { "type": "integer", "minimum": 0 },
        "blockedPolicyQuarantineRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "answerVisibleRows": { "const": 0 },
        "answerGenerationRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "parserExecutionRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "privatePathLeakRows": { "type": "integer", "minimum": 0 },
        "schemaViolationCount": { "type": "integer", "minimum": 0 },
        "byArtifactType": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byContractReviewStatus": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readyForRuntimeAdapterDesign",
        "readyForRuntimeApply",
        "candidateStoreWriteAllowed",
        "sourceSpanCreationAllowed",
        "runtimeVisibilityAllowed",
        "evidencePromotionAllowed",
        "answerVisibleAllowed",
        "answerableAllowed",
        "schemaViolations"
      ],
      "properties": {
        "readyForRuntimeAdapterDesign": { "type": "boolean" },
        "readyForRuntimeApply": { "const": false },
        "candidateStoreWriteAllowed": { "const": false },
        "sourceSpanCreationAllowed": { "const": false },
        "runtimeVisibilityAllowed": { "const": false },
        "evidencePromotionAllowed": { "const": false },
        "answerVisibleAllowed": { "const": false },
        "answerableAllowed": { "const": false },
        "schemaViolations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "nullableInteger": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "plannedSpan": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sourceType",
        "source_type",
        "sourceId",
        "source_id",
        "sourceRef",
        "source_ref",
        "sourceContentHash",
        "source_content_hash",
        "content_hash",
        "spanLocator",
        "span_locator",
        "charStart",
        "char_start",
        "charEnd",
        "char_end",
        "spanOffsetAvailable",
        "evidenceKind",
        "evidence_kind",
        "derivativeSource",
        "textPreviewIncluded",
        "candidateOnly",
        "runtimeEvidence",
        "answerVisible",
        "answerable",
        "strictEvidence",
        "citationGrade"
      ],
      "properties": {
        "sourceType": { "type": "string" },
        "source_type": { "type": "string" },
        "sourceId": { "type": "string" },
        "source_id": { "type": "string" },
        "sourceRef": { "type": "string", "not": { "pattern": "^/" } },
        "source_ref": { "type": "string", "not": { "pattern": "^/" } },
        "sourceContentHash": { "type": "string" },
        "source_content_hash": { "type": "string" },
        "content_hash": { "type": "string" },
        "spanLocator": { "type": "string" },
        "span_locator": { "type": "string" },
        "charStart": { "$ref": "#/$defs/nullableInteger" },
        "char_start": { "$ref": "#/$defs/nullableInteger" },
        "charEnd": { "$ref": "#/$defs/nullableInteger" },
        "char_end": { "$ref": "#/$defs/nullableInteger" },
        "spanOffsetAvailable": { "type": "boolean" },
        "evidenceKind": { "type": "string" },
        "evidence_kind": { "type": "string" },
        "derivativeSource": { "type": "object" },
        "textPreviewIncluded": { "const": false },
        "candidateOnly": { "const": true },
        "runtimeEvidence": { "const": false },
        "answerVisible": { "const": false },
        "answerable": { "const": false },
        "strictEvidence": { "const": false },
        "citationGrade": { "const": false }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractReviewRowId",
        "sourceRuntimeDryRunRowId",
        "candidateRecordId",
        "sourceCandidateRowId",
        "paperId",
        "artifactType",
        "sourceRef",
        "sourceContentHash",
        "spanLocator",
        "charStart",
        "charEnd",
        "snippetHash",
        "candidateStoreRef",
        "contractReviewStatus",
        "contractReviewBlockers",
        "contractReviewReady",
        "evidencePacketSpanCompatible",
        "answerContractCitationShapeCompatible",
        "strictProvenanceShapePresent",
        "plannedEvidencePacketSpan",
        "runtimeAdapterDesignCandidate",
        "runtimeVisibilityAllowed",
        "answerVisibleAllowed",
        "answerableAllowed",
        "candidateOnly",
        "strictEvidence",
        "citationGrade",
        "runtimeEvidence",
        "answerVisible",
        "answerable",
        "recommendedAction",
        "checks"
      ],
      "properties": {
        "contractReviewRowId": { "type": "string", "minLength": 1 },
        "sourceRuntimeDryRunRowId": { "type": "string" },
        "candidateRecordId": { "type": "string" },
        "sourceCandidateRowId": { "type": "string" },
        "paperId": { "type": "string" },
        "artifactType": { "type": "string" },
        "sourceRef": { "type": "string", "not": { "pattern": "^/" } },
        "sourceContentHash": { "type": "string" },
        "spanLocator": { "type": "string" },
        "charStart": { "$ref": "#/$defs/nullableInteger" },
        "charEnd": { "$ref": "#/$defs/nullableInteger" },
        "snippetHash": { "type": "string" },
        "candidateStoreRef": { "type": "string", "not": { "pattern": "^/" } },
        "contractReviewStatus": { "type": "string", "minLength": 1 },
        "contractReviewBlockers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contractReviewReady": { "type": "boolean" },
        "evidencePacketSpanCompatible": { "type": "boolean" },
        "answerContractCitationShapeCompatible": { "type": "boolean" },
        "strictProvenanceShapePresent": { "type": "boolean" },
        "plannedEvidencePacketSpan": { "$ref": "#/$defs/plannedSpan" },
        "runtimeAdapterDesignCandidate": { "type": "boolean" },
        "runtimeVisibilityAllowed": { "const": false },
        "answerVisibleAllowed": { "const": false },
        "answerableAllowed": { "const": false },
        "candidateOnly": { "const": true },
        "strictEvidence": { "const": false },
        "citationGrade": { "const": false },
        "runtimeEvidence": { "const": false },
        "answerVisible": { "const": false },
        "answerable": { "const": false },
        "recommendedAction": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    }
  }
}
