{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-hub.paper.equation-authority-record.v1",
  "title": "Equation Authority Record",
  "type": "object",
  "required": [
    "schema",
    "equationAuthorityRecordId",
    "runId",
    "plannedWriteTarget",
    "contractVersion",
    "paperId",
    "sourceCandidateId",
    "sourceTexRowId",
    "sourceFile",
    "equationEnvironment",
    "sourceContentHash",
    "equationIdentityDigestSha256",
    "equationHashSha256",
    "equationTextNormalization",
    "hashSource",
    "readinessAuditRowId",
    "hashIdentityDesignRowId",
    "equationAuthorityContractDesignRowId",
    "pdfRegionSnapshot",
    "canonicalAlignmentSnapshot",
    "surroundingContextSnapshot",
    "ambiguitySnapshot",
    "authorityDecision",
    "authorityState",
    "runtimeVisible",
    "answerIntegrationVisible",
    "equationArtifactCreated",
    "strictEvidenceCreated",
    "sourceSpanMutationAllowed",
    "idempotencyKey",
    "provenanceTrace",
    "writePolicy"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.equation-authority-record.v1" },
    "equationAuthorityRecordId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "plannedWriteTarget": { "const": "equation_authority_record_candidate_store" },
    "contractVersion": { "const": "equation_authority_record_contract_v1" },
    "paperId": { "type": "string", "minLength": 1 },
    "sourceCandidateId": { "type": "string" },
    "sourceTexRowId": { "type": "string" },
    "sourceFile": { "type": "string" },
    "equationEnvironment": { "type": "string" },
    "sourceContentHash": { "type": "string", "minLength": 1 },
    "equationIdentityDigestSha256": { "type": "string", "minLength": 1 },
    "equationHashSha256": { "type": "string", "minLength": 1 },
    "equationTextNormalization": { "type": "string" },
    "hashSource": { "type": "string" },
    "readinessAuditRowId": { "type": "string", "minLength": 1 },
    "hashIdentityDesignRowId": { "type": "string", "minLength": 1 },
    "equationAuthorityContractDesignRowId": { "type": "string", "minLength": 1 },
    "pdfRegionSnapshot": { "type": "object" },
    "canonicalAlignmentSnapshot": { "type": "object" },
    "surroundingContextSnapshot": { "type": "object" },
    "ambiguitySnapshot": { "type": "object" },
    "authorityDecision": { "const": "equation_authority_record_contract_candidate_only" },
    "authorityState": { "const": "record_contract_candidate_only" },
    "runtimeVisible": { "const": false },
    "answerIntegrationVisible": { "const": false },
    "equationArtifactCreated": { "const": false },
    "strictEvidenceCreated": { "const": false },
    "sourceSpanMutationAllowed": { "const": false },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "provenanceTrace": {
      "type": "object",
      "required": [
        "equationAuthorityContractDesignRowId",
        "hashIdentityDesignRowId",
        "readinessAuditRowId",
        "sourceCandidateId",
        "sourceContentHash",
        "inputContractStatus",
        "inputDesignStatus",
        "readinessStatus"
      ],
      "properties": {
        "equationAuthorityContractDesignRowId": { "type": "string", "minLength": 1 },
        "hashIdentityDesignRowId": { "type": "string", "minLength": 1 },
        "readinessAuditRowId": { "type": "string", "minLength": 1 },
        "sourceCandidateId": { "type": "string" },
        "sourceContentHash": { "type": "string", "minLength": 1 },
        "inputContractStatus": { "type": "string" },
        "inputDesignStatus": { "type": "string" },
        "readinessStatus": { "type": "string" }
      },
      "additionalProperties": true
    },
    "writePolicy": {
      "type": "object",
      "required": [
        "executorRequired",
        "equationAuthorityRecordWrite",
        "authorityPolicyCreated",
        "equationIdentityPromoted",
        "equationHashPromoted",
        "equationArtifactCreated",
        "strictEvidenceCreated",
        "sourceSpanMutation",
        "runtimeVisible",
        "answerIntegrationVisible",
        "databaseMutation",
        "indexMutation",
        "parserRoutingChanged",
        "answerIntegrationChanged",
        "reindexOrReembed",
        "canonicalParsedArtifactsWritten",
        "manifestWrite",
        "vaultScan"
      ],
      "properties": {
        "executorRequired": { "const": true },
        "equationAuthorityRecordWrite": { "const": false },
        "authorityPolicyCreated": { "const": false },
        "equationIdentityPromoted": { "const": false },
        "equationHashPromoted": { "const": false },
        "equationArtifactCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "sourceSpanMutation": { "const": false },
        "runtimeVisible": { "const": false },
        "answerIntegrationVisible": { "const": false },
        "databaseMutation": { "const": false },
        "indexMutation": { "const": false },
        "parserRoutingChanged": { "const": false },
        "answerIntegrationChanged": { "const": false },
        "reindexOrReembed": { "const": false },
        "canonicalParsedArtifactsWritten": { "const": false },
        "manifestWrite": { "const": false },
        "vaultScan": { "const": false }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
