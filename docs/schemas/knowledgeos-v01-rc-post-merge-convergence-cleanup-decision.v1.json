{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-hub.product.knowledgeos-v01-rc-post-merge-convergence-cleanup-decision.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "inputs",
    "postMergeDecision",
    "counts",
    "gate",
    "checkRows",
    "cleanupRows",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "checkRow": {
      "type": "object",
      "required": ["checkId", "status", "blockers"],
      "additionalProperties": false,
      "properties": {
        "checkId": { "type": "string" },
        "status": { "enum": ["pass", "fail"] },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cleanupRow": {
      "type": "object",
      "required": ["cleanupId", "targetRef", "status", "requiresExplicitApproval", "summary"],
      "additionalProperties": false,
      "properties": {
        "cleanupId": { "type": "string" },
        "targetRef": { "type": "string" },
        "status": { "enum": ["recommended_not_applied", "not_needed"] },
        "requiresExplicitApproval": { "const": true },
        "summary": { "type": "string" }
      }
    }
  },
  "properties": {
    "schema": { "const": "knowledge-hub.product.knowledgeos-v01-rc-post-merge-convergence-cleanup-decision.v1" },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string" },
    "decision": {
      "enum": [
        "knowledgeos_v01_rc_post_merge_convergence_cleanup_decision_ready",
        "knowledgeos_v01_rc_post_merge_convergence_cleanup_decision_blocked"
      ]
    },
    "nextRecommendedTranche": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": [
        "visionBottleneckReportRef",
        "prNumber",
        "headBranch",
        "baseBranch",
        "headShortSha",
        "originMainShortSha",
        "remoteMainShortSha",
        "mergeCommitShortSha"
      ],
      "additionalProperties": false,
      "properties": {
        "visionBottleneckReportRef": { "type": "string" },
        "prNumber": { "type": "integer" },
        "headBranch": { "type": "string" },
        "baseBranch": { "const": "main" },
        "headShortSha": { "type": "string" },
        "originMainShortSha": { "type": "string" },
        "remoteMainShortSha": { "type": "string" },
        "mergeCommitShortSha": { "type": "string" }
      }
    },
    "postMergeDecision": {
      "type": "object",
      "required": [
        "postMergeConvergence",
        "branchCleanupDecision",
        "publicDefaultDecision",
        "generalRcDecision",
        "nextGate"
      ],
      "additionalProperties": false,
      "properties": {
        "postMergeConvergence": { "enum": ["research_preview_rc_merged", "blocked"] },
        "branchCleanupDecision": {
          "enum": ["cleanup_recommended_not_applied", "no_remote_branch_cleanup_needed"]
        },
        "publicDefaultDecision": { "const": "hold_public_default_promotion" },
        "generalRcDecision": { "const": "blocked_pending_corpus_scale_quality_gate" },
        "nextGate": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "postMergeConvergenceRows",
        "prMergedRows",
        "mainMergeCommitMatchRows",
        "remoteMainMatchesLocalOriginRows",
        "ciCheckRows",
        "ciCheckSuccessRows",
        "releaseSmokeCheckedRows",
        "releaseSmokePassedRows",
        "publicHygieneIssueRows",
        "readyForHumanReviewRowsFromVision",
        "publicDefaultPromotionReadyRows",
        "publicDefaultPromotionHeldRows",
        "generalRcReadyRows",
        "corpusScaleClaimProvenRows",
        "researchPreviewRcCandidateRows",
        "remoteFeatureBranchStillExistsRows",
        "branchCleanupRecommendedRows",
        "branchCleanupAppliedRows",
        "blockedRows",
        "candidateStoreWriteRows",
        "sourceSpanCreatedRows",
        "strictEvidenceRows",
        "citationGradeEvidenceRows",
        "runtimeEvidenceRows",
        "parserExecutionRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "canonicalParsedArtifactWriteRows",
        "vaultScanRows",
        "externalDownloadRows",
        "publicCliFlagRows",
        "defaultOnRows",
        "externalLlmCallRows",
        "modelApiCallRows",
        "judgeModelCallRows",
        "githubPrMutationRows",
        "mergeRows",
        "branchDeletionRows",
        "releaseTagRows",
        "packagePublishRows",
        "rawGithubPayloadPersistedRows",
        "defaultMcpToolRows",
        "defaultKhubAskRouteRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "additionalProperties": false,
      "properties": {
        "postMergeConvergenceRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "prMergedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "mainMergeCommitMatchRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "remoteMainMatchesLocalOriginRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "ciCheckRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "ciCheckSuccessRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "releaseSmokeCheckedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "releaseSmokePassedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "publicHygieneIssueRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "readyForHumanReviewRowsFromVision": { "$ref": "#/$defs/nonNegativeInteger" },
        "publicDefaultPromotionReadyRows": { "const": 0 },
        "publicDefaultPromotionHeldRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "generalRcReadyRows": { "const": 0 },
        "corpusScaleClaimProvenRows": { "const": 0 },
        "researchPreviewRcCandidateRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "remoteFeatureBranchStillExistsRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "branchCleanupRecommendedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "branchCleanupAppliedRows": { "const": 0 },
        "blockedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "candidateStoreWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeEvidenceRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "parserExecutionRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "publicCliFlagRows": { "const": 0 },
        "defaultOnRows": { "const": 0 },
        "externalLlmCallRows": { "const": 0 },
        "modelApiCallRows": { "const": 0 },
        "judgeModelCallRows": { "const": 0 },
        "githubPrMutationRows": { "const": 0 },
        "mergeRows": { "const": 0 },
        "branchDeletionRows": { "const": 0 },
        "releaseTagRows": { "const": 0 },
        "packagePublishRows": { "const": 0 },
        "rawGithubPayloadPersistedRows": { "const": 0 },
        "defaultMcpToolRows": { "const": 0 },
        "defaultKhubAskRouteRows": { "const": 0 },
        "privatePathLeakRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "schemaViolationCount": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "postMergeConvergenceReady",
        "prMerged",
        "mainContainsMergeCommit",
        "remoteMainVerified",
        "ciChecksGreen",
        "releaseSmokeReady",
        "publicHygieneReady",
        "branchCleanupRecommended",
        "branchCleanupApplied",
        "publicDefaultPromotionAllowed",
        "generalRcReady",
        "semanticViolations"
      ],
      "additionalProperties": false,
      "properties": {
        "postMergeConvergenceReady": { "type": "boolean" },
        "prMerged": { "type": "boolean" },
        "mainContainsMergeCommit": { "type": "boolean" },
        "remoteMainVerified": { "type": "boolean" },
        "ciChecksGreen": { "type": "boolean" },
        "releaseSmokeReady": { "type": "boolean" },
        "publicHygieneReady": { "type": "boolean" },
        "branchCleanupRecommended": { "type": "boolean" },
        "branchCleanupApplied": { "const": false },
        "publicDefaultPromotionAllowed": { "const": false },
        "generalRcReady": { "const": false },
        "semanticViolations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checkRows": { "type": "array", "items": { "$ref": "#/$defs/checkRow" } },
    "cleanupRows": { "type": "array", "items": { "$ref": "#/$defs/cleanupRow" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
