{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-text-evidence-rc-external-action-preflight.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "scope",
    "inputReports",
    "canonicalCheckout",
    "pullRequest149",
    "readyForUserApproval",
    "blockerRows",
    "blockers",
    "nextAction",
    "mutationCounters",
    "schemaViolationCount",
    "privatePathLeakRows",
    "reportHash",
    "warnings",
    "schemaErrors"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.text-evidence-rc-external-action-preflight.v1" },
    "status": { "enum": ["ready_for_user_approval", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "pullRequestMutationPerformed",
        "canonicalCheckoutEdited",
        "fileContentReadRows",
        "destructiveCleanupRows",
        "vaultScanRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "externalDownloadRows",
        "mergeRows",
        "cherryPickRows",
        "worktreeDeletionRows"
      ],
      "properties": {
        "writes": { "const": "report_only" },
        "pullRequestMutationPerformed": { "const": false },
        "canonicalCheckoutEdited": { "const": false },
        "fileContentReadRows": { "const": 0 },
        "destructiveCleanupRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "mergeRows": { "const": 0 },
        "cherryPickRows": { "const": 0 },
        "worktreeDeletionRows": { "const": 0 }
      }
    },
    "inputReports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalPacketReportRef",
        "approvalPacketStatus",
        "approvalPacketPendingRows",
        "approvalPacketExecutedRows",
        "snapshotDryRunReportRef",
        "snapshotDryRunStatus",
        "snapshotDirtyRows",
        "snapshotStatusFingerprint"
      ],
      "properties": {
        "approvalPacketReportRef": { "const": "text_evidence_rc_external_action_approval_packet.v1.json" },
        "approvalPacketStatus": { "type": "string" },
        "approvalPacketPendingRows": { "type": "integer", "minimum": 0 },
        "approvalPacketExecutedRows": { "type": "integer", "minimum": 0 },
        "snapshotDryRunReportRef": { "const": "text_evidence_canonical_dirty_snapshot_dry_run.v1.json" },
        "snapshotDryRunStatus": { "type": "string" },
        "snapshotDirtyRows": { "type": "integer", "minimum": 0 },
        "snapshotStatusFingerprint": { "type": "string" }
      }
    },
    "canonicalCheckout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "repoRef",
        "branch",
        "head",
        "dirtyRows",
        "statusFingerprint",
        "snapshotFingerprintMatches",
        "dirtyRowsMatchSnapshot"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "repoRef": { "const": "canonical_product_checkout" },
        "branch": { "type": "string" },
        "head": { "type": "string" },
        "dirtyRows": { "type": "integer", "minimum": 0 },
        "statusFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "snapshotFingerprintMatches": { "type": "boolean" },
        "dirtyRowsMatchSnapshot": { "type": "boolean" }
      }
    },
    "pullRequest149": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "state",
        "isDraft",
        "mergeable",
        "mergeStateStatus",
        "headRefName",
        "baseRefName",
        "expectedHoldState"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "state": { "type": "string" },
        "isDraft": { "type": "boolean" },
        "mergeable": { "type": "string" },
        "mergeStateStatus": { "type": "string" },
        "headRefName": { "type": "string" },
        "baseRefName": { "type": "string" },
        "expectedHoldState": { "type": "boolean" }
      }
    },
    "readyForUserApproval": { "type": "boolean" },
    "blockerRows": { "type": "integer", "minimum": 0 },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockerId", "reason"],
        "properties": {
          "blockerId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nextAction": {
      "enum": [
        "request_explicit_user_approval_to_close_pr149_without_merge",
        "refresh_external_action_approval_packet_or_snapshot_dry_run"
      ]
    },
    "mutationCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalPrMutationRows",
        "canonicalCleanupRows",
        "destructiveCleanupRows",
        "canonicalParsedArtifactWriteRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "externalDownloadRows",
        "mergeRows",
        "cherryPickRows",
        "worktreeDeletionRows",
        "runtimeAnswerVisibleExposureRows",
        "strictEvidencePromotionRows"
      ],
      "properties": {
        "externalPrMutationRows": { "const": 0 },
        "canonicalCleanupRows": { "const": 0 },
        "destructiveCleanupRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "mergeRows": { "const": 0 },
        "cherryPickRows": { "const": 0 },
        "worktreeDeletionRows": { "const": 0 },
        "runtimeAnswerVisibleExposureRows": { "const": 0 },
        "strictEvidencePromotionRows": { "const": 0 }
      }
    },
    "schemaViolationCount": { "const": 0 },
    "privatePathLeakRows": { "const": 0 },
    "reportHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "schemaErrors": { "type": "array", "items": { "type": "string" } }
  }
}
