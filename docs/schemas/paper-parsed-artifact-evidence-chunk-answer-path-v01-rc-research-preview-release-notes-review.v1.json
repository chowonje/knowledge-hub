        "releaseNotesReviewRows": { "type": "integer", "minimum": 0 },
        "promotionGateReadyRows": { "type": "integer", "minimum": 0 },
        "releaseNotesDocRows": { "type": "integer", "minimum": 0 },
        "releaseNotesReadyRows": { "type": "integer", "minimum": 0 },
        "requiredPhraseRows": { "type": "integer", "minimum": 0 },
        "requiredPhrasePassRows": { "type": "integer", "minimum": 0 },
        "missingRequiredPhraseRows": { "type": "integer", "minimum": 0 },
