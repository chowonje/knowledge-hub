{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-visual-annotation-expansion-web-upload-bundle.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "uploadBundleId",
    "sourceWebRunBundle",
    "sourceAttachmentPack",
    "uploadRootRef",
    "scope",
    "counts",
    "batchRowsDetail",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.visual-annotation-expansion-web-upload-bundle.v1" },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["ready_for_operator_web_gpt_pro_upload", "blocked"] },
    "nextRecommendedTranche": { "const": "visual_annotation_expansion_manual_output_capture" },
    "uploadBundleId": { "type": "string", "minLength": 1 },
    "sourceWebRunBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "reportRef", "batchRows"],
      "properties": {
        "schema": { "const": "knowledge-hub.paper.visual-annotation-expansion-web-run-bundle.v1" },
        "status": { "enum": ["ready", "blocked"] },
        "reportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
        "batchRows": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceAttachmentPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "reportRef", "attachmentRows"],
      "properties": {
        "schema": { "const": "knowledge-hub.paper.visual-annotation-expansion-attachment-pack.v1" },
        "status": { "enum": ["ready", "blocked"] },
        "reportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
        "attachmentRows": { "type": "integer", "minimum": 0 }
      }
    },
    "uploadRootRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "apiCalls",
        "modelCalls",
        "webModelCalls",
        "manualOperatorWebModelRunRequired",
        "operatorPromptRows",
        "fillTemplateRows",
        "copiedAttachmentRows",
        "vectorIndexing",
        "strictEvidencePromotionRows",
        "runtimeAnswerVisibleExposureRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "externalDownloadRows",
        "answerabilityGateBypassRows",
        "pageImageWriteRows",
        "wholeImageWriteRows",
        "wholeImageGptRows",
        "candidateStoreMutationRows",
        "canonicalParsedArtifactWriteRows"
      ],
      "properties": {
        "writes": { "const": "upload_bundle_files_only" },
        "apiCalls": { "const": false },
        "modelCalls": { "const": false },
        "webModelCalls": { "const": false },
        "manualOperatorWebModelRunRequired": { "const": true },
        "operatorPromptRows": { "type": "integer", "minimum": 0 },
        "fillTemplateRows": { "type": "integer", "minimum": 0 },
        "copiedAttachmentRows": { "type": "integer", "minimum": 0 },
        "vectorIndexing": { "const": false },
        "strictEvidencePromotionRows": { "const": 0 },
        "runtimeAnswerVisibleExposureRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "answerabilityGateBypassRows": { "const": 0 },
        "pageImageWriteRows": { "const": 0 },
        "wholeImageWriteRows": { "const": 0 },
        "wholeImageGptRows": { "const": 0 },
        "candidateStoreMutationRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchRows",
        "operatorPromptRows",
        "fillTemplateRows",
        "copiedAttachmentRows",
        "missingArtifactRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "properties": {
        "batchRows": { "type": "integer", "minimum": 0 },
        "operatorPromptRows": { "type": "integer", "minimum": 0 },
        "fillTemplateRows": { "type": "integer", "minimum": 0 },
        "copiedAttachmentRows": { "type": "integer", "minimum": 0 },
        "missingArtifactRows": { "type": "integer", "minimum": 0 },
        "privatePathLeakRows": { "const": 0 },
        "schemaViolationCount": { "const": 0 }
      }
    },
    "batchRowsDetail": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batchId",
          "batchNumber",
          "rowCount",
          "folderRef",
          "promptRef",
          "fillTemplateRef",
          "attachmentRefs",
          "missingArtifactRows"
        ],
        "properties": {
          "batchId": { "type": "string", "minLength": 1 },
          "batchNumber": { "type": "integer", "minimum": 1 },
          "rowCount": { "type": "integer", "minimum": 0 },
          "folderRef": {
            "type": "string",
            "pattern": "^eval/knowledgeos/reports/visual_annotation_expansion_web_upload_bundle.*?/batch_[0-9]{2}$"
          },
          "promptRef": {
            "type": "string",
            "pattern": "^eval/knowledgeos/reports/visual_annotation_expansion_web_upload_bundle.*?/batch_[0-9]{2}/batch_[0-9]{2}_prompt\\.md$"
          },
          "fillTemplateRef": {
            "type": "string",
            "pattern": "^eval/knowledgeos/reports/visual_annotation_expansion_web_upload_bundle.*?/batch_[0-9]{2}/batch_[0-9]{2}_fill_template\\.v1\\.json$"
          },
          "attachmentRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^eval/knowledgeos/reports/visual_annotation_expansion_web_upload_bundle.*?/batch_[0-9]{2}/.+\\.png$"
            }
          },
          "missingArtifactRows": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
