{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-parsed-artifact-evidence-chunk-candidate-dry-run.v1.json",
  "title": "Parsed Artifact Evidence Chunk Candidate Dry Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "input",
    "policy",
    "sourceContractReview",
    "method",
    "counts",
    "gate",
    "candidateRows",
    "technicalBlockers",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "knowledge-hub.paper.parsed-artifact-evidence-chunk-candidate-dry-run.v1"
    },
    "status": {
      "enum": ["ready", "blocked"]
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": ["parsed_artifact_evidence_chunk_candidate_dry_run_ready", "blocked"]
    },
    "nextRecommendedTranche": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceContractReviewRef", "papersDirRef", "maxRowsPerPaper", "maxTotalRows"],
      "properties": {
        "sourceContractReviewRef": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^/" }
        },
        "papersDirRef": { "const": "papers_dir" },
        "maxRowsPerPaper": { "type": "integer", "minimum": 1 },
        "maxTotalRows": { "type": "integer", "minimum": 1 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dryRunOnly",
        "candidateOnly",
        "runtimeRouteWrite",
        "runtimeConfigMutation",
        "operationalSearchIndexQuery",
        "answerVisibleExposure",
        "answerGeneration",
        "strictEvidenceCreation",
        "citationGradePromotion",
        "runtimeEvidenceCreation",
        "sourceSpanCreation",
        "sourceSpanCandidateCreation",
        "parsedArtifactEvidenceChunkCreation",
        "databaseMutation",
        "indexMutation",
        "reindexOrReembed",
        "parserExecution",
        "canonicalParsedArtifactWrite",
        "vaultScan",
        "externalDownload",
        "branchDeletion",
        "githubMutation"
      ],
      "properties": {
        "dryRunOnly": { "const": true },
        "candidateOnly": { "const": true },
        "runtimeRouteWrite": { "const": false },
        "runtimeConfigMutation": { "const": false },
        "operationalSearchIndexQuery": { "const": false },
        "answerVisibleExposure": { "const": false },
        "answerGeneration": { "const": false },
        "strictEvidenceCreation": { "const": false },
        "citationGradePromotion": { "const": false },
        "runtimeEvidenceCreation": { "const": false },
        "sourceSpanCreation": { "const": false },
        "sourceSpanCandidateCreation": { "const": false },
        "parsedArtifactEvidenceChunkCreation": { "const": false },
        "databaseMutation": { "const": false },
        "indexMutation": { "const": false },
        "reindexOrReembed": { "const": false },
        "parserExecution": { "const": false },
        "canonicalParsedArtifactWrite": { "const": false },
        "vaultScan": { "const": false },
        "externalDownload": { "const": false },
        "branchDeletion": { "const": false },
        "githubMutation": { "const": false }
      }
    },
    "sourceContractReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "decision", "reportRef"],
      "properties": {
        "schema": {
          "const": "knowledge-hub.paper.paper-retrieval-lane-split-parsed-artifact-evidence-chunk-contract-review.v1"
        },
        "status": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "reportRef": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^/" }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "completionBoundary", "nextEvidenceWork"],
      "properties": {
        "name": { "const": "parsed_artifact_evidence_chunk_candidate_dry_run_v1" },
        "completionBoundary": { "const": "candidate_dry_run_report_only" },
        "nextEvidenceWork": { "const": "parsed_artifact_evidence_chunk_candidate_canary_apply_readback" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputContractRows",
        "parsedArtifactRows",
        "missingParsedRootRows",
        "paperRowsWithCandidates",
        "candidateRows",
        "selectedCandidateRows",
        "heldCandidateRows",
        "paragraphCandidateRows",
        "sectionCandidateRows",
        "answerEvidenceCandidateRows",
        "answerabilityCandidateRows",
        "candidateOnlyRows",
        "blockedMissingManifestRows",
        "blockedMissingDocumentJsonRows",
        "blockedMissingDocumentMdRows",
        "blockedMissingSourceHashRows",
        "blockedSourceHashMismatchRows",
        "blockedMissingLocatorRows",
        "blockedRows",
        "privatePathLeakRows",
        "schemaViolationCount",
        "runtimeRouteWriteRows",
        "runtimeConfigMutationRows",
        "operationalSearchIndexQueryRows",
        "runtimeVisibleRows",
        "answerVisibleRows",
        "answerGenerationRows",
        "strictEvidenceRows",
        "citationGradeRows",
        "runtimeEvidenceRows",
        "answerableWithoutTextEvidenceRows",
        "candidateStoreWriteRows",
        "sourceSpanCreatedRows",
        "sourceSpanCandidateCreatedRows",
        "parsedArtifactEvidenceChunkCreatedRows",
        "embeddingCallRows",
        "embeddingVectorWriteRows",
        "vectorIndexWriteRows",
        "productionVectorIndexWriteRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "parserExecutionRows",
        "canonicalParsedArtifactWriteRows",
        "graphDbWriteRows",
        "ontologyWriteRows",
        "memoryCardWriteRows",
        "clusterWriteRows",
        "vaultScanRows",
        "externalDownloadRows",
        "branchDeletionRows",
        "githubPrMutationRows"
      ],
      "properties": {
        "inputContractRows": { "type": "integer", "minimum": 0 },
        "parsedArtifactRows": { "type": "integer", "minimum": 0 },
        "missingParsedRootRows": { "type": "integer", "minimum": 0 },
        "paperRowsWithCandidates": { "type": "integer", "minimum": 0 },
        "candidateRows": { "type": "integer", "minimum": 0 },
        "selectedCandidateRows": { "type": "integer", "minimum": 0 },
        "heldCandidateRows": { "type": "integer", "minimum": 0 },
        "paragraphCandidateRows": { "type": "integer", "minimum": 0 },
        "sectionCandidateRows": { "type": "integer", "minimum": 0 },
        "answerEvidenceCandidateRows": { "type": "integer", "minimum": 0 },
        "answerabilityCandidateRows": { "type": "integer", "minimum": 0 },
        "candidateOnlyRows": { "type": "integer", "minimum": 0 },
        "blockedMissingManifestRows": { "type": "integer", "minimum": 0 },
        "blockedMissingDocumentJsonRows": { "type": "integer", "minimum": 0 },
        "blockedMissingDocumentMdRows": { "type": "integer", "minimum": 0 },
        "blockedMissingSourceHashRows": { "type": "integer", "minimum": 0 },
        "blockedSourceHashMismatchRows": { "type": "integer", "minimum": 0 },
        "blockedMissingLocatorRows": { "type": "integer", "minimum": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "privatePathLeakRows": { "type": "integer", "minimum": 0 },
        "schemaViolationCount": { "type": "integer", "minimum": 0 },
        "runtimeRouteWriteRows": { "const": 0 },
        "runtimeConfigMutationRows": { "const": 0 },
        "operationalSearchIndexQueryRows": { "const": 0 },
        "runtimeVisibleRows": { "const": 0 },
        "answerVisibleRows": { "const": 0 },
        "answerGenerationRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "answerableWithoutTextEvidenceRows": { "const": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "sourceSpanCandidateCreatedRows": { "const": 0 },
        "parsedArtifactEvidenceChunkCreatedRows": { "const": 0 },
        "embeddingCallRows": { "const": 0 },
        "embeddingVectorWriteRows": { "const": 0 },
        "vectorIndexWriteRows": { "const": 0 },
        "productionVectorIndexWriteRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "parserExecutionRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "graphDbWriteRows": { "const": 0 },
        "ontologyWriteRows": { "const": 0 },
        "memoryCardWriteRows": { "const": 0 },
        "clusterWriteRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "branchDeletionRows": { "const": 0 },
        "githubPrMutationRows": { "const": 0 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["passed", "checks"],
      "properties": {
        "passed": { "type": "boolean" },
        "checks": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "candidateRows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "schema",
          "candidateRowId",
          "status",
          "paperId",
          "sourceType",
          "artifactType",
          "sourceRef",
          "sourceContentHash",
          "locator",
          "spanLocator",
          "excerpt",
          "snippetHash",
          "evidenceKind",
          "candidateOnly",
          "answerEvidenceCandidate",
          "answerabilityCandidate",
          "strictEvidence",
          "citationGrade",
          "runtimeEvidence",
          "answerVisible",
          "candidateRowHash"
        ],
        "properties": {
          "schema": {
            "const": "knowledge-hub.paper.parsed-artifact-evidence-chunk-candidate-row.v1"
          },
          "status": { "const": "candidate_ready" },
          "sourceType": { "const": "paper" },
          "artifactType": { "enum": ["section", "paragraph"] },
          "sourceRef": {
            "type": "string",
            "pattern": "^papers_dir/parsed/[^/]+/document\\.md$"
          },
          "sourceContentHash": { "type": "string", "minLength": 1 },
          "locator": { "type": "object" },
          "spanLocator": { "type": "string", "pattern": "^chars:[0-9]+-[0-9]+$" },
          "excerpt": { "type": "string", "minLength": 1 },
          "snippetHash": { "type": "string", "pattern": "^sha256:" },
          "candidateOnly": { "const": true },
          "answerEvidenceCandidate": { "const": true },
          "answerabilityCandidate": { "const": true },
          "strictEvidence": { "const": false },
          "citationGrade": { "const": false },
          "runtimeEvidence": { "const": false },
          "answerVisible": { "const": false }
        }
      }
    },
    "technicalBlockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
