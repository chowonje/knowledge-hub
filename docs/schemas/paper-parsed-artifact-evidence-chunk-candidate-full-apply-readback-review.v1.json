{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-parsed-artifact-evidence-chunk-candidate-full-apply-readback-review.v1.json",
  "title": "Parsed Artifact Evidence Chunk Candidate Full Apply Readback Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "sourceFullApplyExecutorReport",
    "input",
    "scope",
    "policy",
    "counts",
    "gate",
    "rows",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "knowledge-hub.paper.parsed-artifact-evidence-chunk-candidate-full-apply-readback-review.v1"
    },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": [
        "parsed_artifact_evidence_chunk_candidate_full_apply_readback_review_ready",
        "blocked"
      ]
    },
    "nextRecommendedTranche": {
      "const": "parsed_artifact_evidence_chunk_candidate_answerability_policy_gate"
    },
    "sourceFullApplyExecutorReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "decision",
        "nextRecommendedTranche",
        "reportRef",
        "plannedApplyRows",
        "appliedCandidateRecordRows",
        "alreadyCorrectRows",
        "candidateStoreWriteRows",
        "readbackValidatedRows",
        "runManifestWriteRows",
        "blockedRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "properties": {
        "schema": {
          "const": "knowledge-hub.paper.parsed-artifact-evidence-chunk-candidate-full-apply-executor-apply-readback.v1"
        },
        "status": { "enum": ["applied", "ready", "blocked"] },
        "decision": {
          "enum": [
            "parsed_artifact_evidence_chunk_candidate_full_apply_executor_apply_readback_ready",
            "parsed_artifact_evidence_chunk_candidate_full_apply_executor_apply_readback_pending_apply",
            "blocked"
          ]
        },
        "nextRecommendedTranche": { "type": "string", "minLength": 1 },
        "reportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
        "plannedApplyRows": { "type": "integer", "minimum": 0 },
        "appliedCandidateRecordRows": { "type": "integer", "minimum": 0 },
        "alreadyCorrectRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "type": "integer", "minimum": 0 },
        "readbackValidatedRows": { "type": "integer", "minimum": 0 },
        "runManifestWriteRows": { "type": "integer", "minimum": 0 },
        "blockedRows": { "const": 0 },
        "privatePathLeakRows": { "const": 0 },
        "schemaViolationCount": { "const": 0 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["papersDirRef", "candidateStoreRefTemplate"],
      "properties": {
        "papersDirRef": { "const": "papers_dir" },
        "candidateStoreRefTemplate": {
          "const": "papers_dir/structured_evidence_candidates/evidence_chunk/{paperId}.jsonl"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "expectedCandidateRows",
        "candidateStoreWriteRows",
        "sourceSpanCreatedRows",
        "strictEvidenceRows",
        "citationGradeRows",
        "runtimeEvidenceRows",
        "answerVisibleRows",
        "answerGenerationRows",
        "parserExecutionRows",
        "canonicalParsedArtifactWriteRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "externalDownloadRows"
      ],
      "properties": {
        "writes": { "const": "report_only" },
        "expectedCandidateRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "answerVisibleRows": { "const": 0 },
        "answerGenerationRows": { "const": 0 },
        "parserExecutionRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readbackReviewOnly",
        "candidateStoreWrite",
        "sourceSpanCreated",
        "strictEvidenceCreated",
        "citationGradeEvidenceCreated",
        "runtimeEvidenceCreated",
        "answerVisibleExposure",
        "answerGeneration",
        "parserRoutingChanged",
        "answerIntegrationChanged",
        "databaseMutation",
        "vaultScan",
        "reindexOrReembed",
        "parserExecution",
        "canonicalParsedArtifactsWritten",
        "allowedUse",
        "strictEvidence",
        "citationGrade",
        "runtimeVisible",
        "answerVisible",
        "answerabilityPolicyGateRequired"
      ],
      "properties": {
        "readbackReviewOnly": { "const": true },
        "candidateStoreWrite": { "const": false },
        "sourceSpanCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "citationGradeEvidenceCreated": { "const": false },
        "runtimeEvidenceCreated": { "const": false },
        "answerVisibleExposure": { "const": false },
        "answerGeneration": { "const": false },
        "parserRoutingChanged": { "const": false },
        "answerIntegrationChanged": { "const": false },
        "databaseMutation": { "const": false },
        "vaultScan": { "const": false },
        "reindexOrReembed": { "const": false },
        "parserExecution": { "const": false },
        "canonicalParsedArtifactsWritten": { "const": false },
        "allowedUse": { "const": "candidate_store_only" },
        "strictEvidence": { "const": false },
        "citationGrade": { "const": false },
        "runtimeVisible": { "const": false },
        "answerVisible": { "const": false },
        "answerabilityPolicyGateRequired": { "const": true }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAppliedRows",
        "expectedCandidateRows",
        "storeRows",
        "matchingStoreRows",
        "unmatchedStoreRows",
        "readbackValidatedRows",
        "missingStoreRows",
        "duplicateStoreRows",
        "hashMismatchRows",
        "policyViolationRows",
        "blockedRows",
        "candidateStoreWriteRows",
        "sourceSpanCreatedRows",
        "strictEvidenceRows",
        "citationGradeRows",
        "runtimeEvidenceRows",
        "answerVisibleRows",
        "answerGenerationRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "parserExecutionRows",
        "canonicalParsedArtifactWriteRows",
        "vaultScanRows",
        "externalDownloadRows",
        "privatePathLeakRows",
        "schemaViolationCount",
        "byArtifactType",
        "byReadbackStatus"
      ],
      "properties": {
        "sourceAppliedRows": { "type": "integer", "minimum": 0 },
        "expectedCandidateRows": { "type": "integer", "minimum": 0 },
        "storeRows": { "type": "integer", "minimum": 0 },
        "matchingStoreRows": { "type": "integer", "minimum": 0 },
        "unmatchedStoreRows": { "type": "integer", "minimum": 0 },
        "readbackValidatedRows": { "type": "integer", "minimum": 0 },
        "missingStoreRows": { "type": "integer", "minimum": 0 },
        "duplicateStoreRows": { "type": "integer", "minimum": 0 },
        "hashMismatchRows": { "type": "integer", "minimum": 0 },
        "policyViolationRows": { "type": "integer", "minimum": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "answerVisibleRows": { "const": 0 },
        "answerGenerationRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "parserExecutionRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "privatePathLeakRows": { "const": 0 },
        "schemaViolationCount": { "type": "integer", "minimum": 0 },
        "byArtifactType": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byReadbackStatus": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readyForAnswerabilityPolicyGate",
        "candidateStoreWriteAllowed",
        "sourceSpanCreationAllowed",
        "runtimeVisibilityAllowed",
        "evidencePromotionAllowed",
        "answerVisibleAllowed",
        "schemaViolations"
      ],
      "properties": {
        "readyForAnswerabilityPolicyGate": { "type": "boolean" },
        "candidateStoreWriteAllowed": { "const": false },
        "sourceSpanCreationAllowed": { "const": false },
        "runtimeVisibilityAllowed": { "const": false },
        "evidencePromotionAllowed": { "const": false },
        "answerVisibleAllowed": { "const": false },
        "schemaViolations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "readbackReviewRowId",
          "candidateRecordId",
          "sourceCandidateRowId",
          "paperId",
          "artifactType",
          "sourceContentHash",
          "spanLocator",
          "idempotencyKey",
          "readbackValidated",
          "candidateOnly",
          "answerEvidenceCandidate",
          "answerabilityCandidate",
          "strictEvidence",
          "citationGrade",
          "runtimeEvidence",
          "answerVisible",
          "readbackStatus",
          "readbackBlockers",
          "checks"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
