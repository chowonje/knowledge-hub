{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-hub.product.knowledgeos-v01-rc-corpus-scale-answer-quality-controlled-execution.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "inputs",
    "policy",
    "counts",
    "gate",
    "executionRows",
    "checkRows",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "checkRow": {
      "type": "object",
      "required": ["checkId", "status", "blockers"],
      "additionalProperties": false,
      "properties": {
        "checkId": { "type": "string" },
        "status": { "enum": ["pass", "fail"] },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dimensionStatuses": {
      "type": "object",
      "required": [
        "schemaValid",
        "answerability",
        "noAnswerSafety",
        "citationProvenance",
        "sourceCoverage",
        "answerSupport"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaValid": { "type": "boolean" },
        "answerability": { "type": "boolean" },
        "noAnswerSafety": { "type": "boolean" },
        "citationProvenance": { "type": "boolean" },
        "sourceCoverage": { "type": "boolean" },
        "answerSupport": { "type": "boolean" }
      }
    },
    "executionRow": {
      "type": "object",
      "required": [
        "caseIndex",
        "caseId",
        "questionCategory",
        "expectedEvidenceType",
        "answerabilityExpectation",
        "paperIds",
        "questionSha256",
        "observedStatus",
        "observedAnswerable",
        "adapterStatus",
        "adapterRowsAdded",
        "adapterCandidateRowsConsidered",
        "selectedEvidenceCount",
        "citationCount",
        "evidencePacketContractSpanRows",
        "localFakeLlmCallRows",
        "schemaValid",
        "dimensionStatuses",
        "qualityScore",
        "qualityGrade",
        "answerTextIncludedInReport",
        "citationPayloadIncludedInReport",
        "sourcePayloadIncludedInReport",
        "excerptIncludedInReport",
        "pass",
        "failureReasons"
      ],
      "additionalProperties": false,
      "properties": {
        "caseIndex": { "$ref": "#/$defs/nonNegativeInteger" },
        "caseId": { "type": "string" },
        "questionCategory": { "type": "string" },
        "expectedEvidenceType": { "type": "string" },
        "answerabilityExpectation": {
          "enum": ["answerable", "expected_no_answer", "blocked_until_structured_evidence"]
        },
        "paperIds": { "type": "array", "items": { "type": "string" } },
        "questionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "observedStatus": { "type": "string" },
        "observedAnswerable": { "type": "boolean" },
        "adapterStatus": { "type": "string" },
        "adapterRowsAdded": { "$ref": "#/$defs/nonNegativeInteger" },
        "adapterCandidateRowsConsidered": { "$ref": "#/$defs/nonNegativeInteger" },
        "selectedEvidenceCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "citationCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "evidencePacketContractSpanRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "localFakeLlmCallRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "schemaValid": { "type": "boolean" },
        "dimensionStatuses": { "$ref": "#/$defs/dimensionStatuses" },
        "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "qualityGrade": { "enum": ["pass", "partial", "fail"] },
        "answerTextIncludedInReport": { "const": false },
        "citationPayloadIncludedInReport": { "const": false },
        "sourcePayloadIncludedInReport": { "const": false },
        "excerptIncludedInReport": { "const": false },
        "pass": { "type": "boolean" },
        "failureReasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "knowledge-hub.product.knowledgeos-v01-rc-corpus-scale-answer-quality-controlled-execution.v1"
    },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string" },
    "decision": {
      "enum": [
        "knowledgeos_v01_rc_corpus_scale_answer_quality_controlled_execution_ready",
        "knowledgeos_v01_rc_corpus_scale_answer_quality_controlled_execution_blocked"
      ]
    },
    "nextRecommendedTranche": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["liveRunnerDryRunReportRef", "corpusManifestRef", "papersDirRef"],
      "additionalProperties": false,
      "properties": {
        "liveRunnerDryRunReportRef": { "type": "string" },
        "corpusManifestRef": { "type": "string" },
        "papersDirRef": { "const": "papers_dir" }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "labsInternalOnly",
        "localFakeLlmOnly",
        "externalModelCallsAllowed",
        "judgeModelCallsAllowed",
        "answerTextExcludedFromReport",
        "citationPayloadExcludedFromReport",
        "sourcePayloadExcludedFromReport",
        "excerptExcludedFromReport",
        "publicDefaultPromotionAllowed"
      ],
      "additionalProperties": false,
      "properties": {
        "labsInternalOnly": { "const": true },
        "localFakeLlmOnly": { "const": true },
        "externalModelCallsAllowed": { "const": false },
        "judgeModelCallsAllowed": { "const": false },
        "answerTextExcludedFromReport": { "const": true },
        "citationPayloadExcludedFromReport": { "const": true },
        "sourcePayloadExcludedFromReport": { "const": true },
        "excerptExcludedFromReport": { "const": true },
        "publicDefaultPromotionAllowed": { "const": false }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "controlledExecutionRows",
        "inputDryRunRows",
        "dryRunReadyInputRows",
        "inputCaseRows",
        "attemptedCaseRows",
        "executionPassRows",
        "executionFailRows",
        "expectedAnswerableRows",
        "expectedNoAnswerRows",
        "blockedUntilStructuredEvidenceRows",
        "observedAnswerableRows",
        "observedNoEvidenceRows",
        "unexpectedAnswerableRows",
        "noAnswerSafetyPassRows",
        "noAnswerSafetyFailRows",
        "schemaValidRows",
        "averageQualityScore",
        "minQualityScore",
        "adapterRowsAdded",
        "selectedEvidenceCount",
        "citationCount",
        "evidencePacketContractSpanRows",
        "localFakeLlmCallRows",
        "noAnswerOrBlockedLlmCallRows",
        "liveAnswerExecutionRows",
        "answerPathInvokedRows",
        "answerGeneratedRows",
        "answerQualityMeasuredRows",
        "answerQualityScoreComputedRows",
        "publicDefaultPromotionReadyRows",
        "publicDefaultPromotionHeldRows",
        "generalRcReadyRows",
        "blockedRows",
        "candidateStoreWriteRows",
        "sourceSpanCreatedRows",
        "strictEvidenceRows",
        "citationGradeEvidenceRows",
        "runtimeEvidenceRows",
        "parserExecutionRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "canonicalParsedArtifactWriteRows",
        "vaultScanRows",
        "externalDownloadRows",
        "publicCliFlagRows",
        "defaultOnRows",
        "externalLlmCallRows",
        "modelApiCallRows",
        "judgeModelCallRows",
        "githubPrMutationRows",
        "mergeRows",
        "branchDeletionRows",
        "releaseTagRows",
        "packagePublishRows",
        "rawPayloadPersistedRows",
        "defaultMcpToolRows",
        "defaultKhubAskRouteRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "additionalProperties": false,
      "properties": {
        "controlledExecutionRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "inputDryRunRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "dryRunReadyInputRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "inputCaseRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "attemptedCaseRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "executionPassRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "executionFailRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "expectedAnswerableRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "expectedNoAnswerRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "blockedUntilStructuredEvidenceRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "observedAnswerableRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "observedNoEvidenceRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "unexpectedAnswerableRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "noAnswerSafetyPassRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "noAnswerSafetyFailRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "schemaValidRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "averageQualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "minQualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "adapterRowsAdded": { "$ref": "#/$defs/nonNegativeInteger" },
        "selectedEvidenceCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "citationCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "evidencePacketContractSpanRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "localFakeLlmCallRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "noAnswerOrBlockedLlmCallRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "liveAnswerExecutionRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "answerPathInvokedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "answerGeneratedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "answerQualityMeasuredRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "answerQualityScoreComputedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "publicDefaultPromotionReadyRows": { "const": 0 },
        "publicDefaultPromotionHeldRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "generalRcReadyRows": { "const": 0 },
        "blockedRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "candidateStoreWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeEvidenceRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "parserExecutionRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "publicCliFlagRows": { "const": 0 },
        "defaultOnRows": { "const": 0 },
        "externalLlmCallRows": { "const": 0 },
        "modelApiCallRows": { "const": 0 },
        "judgeModelCallRows": { "const": 0 },
        "githubPrMutationRows": { "const": 0 },
        "mergeRows": { "const": 0 },
        "branchDeletionRows": { "const": 0 },
        "releaseTagRows": { "const": 0 },
        "packagePublishRows": { "const": 0 },
        "rawPayloadPersistedRows": { "const": 0 },
        "defaultMcpToolRows": { "const": 0 },
        "defaultKhubAskRouteRows": { "const": 0 },
        "privatePathLeakRows": { "$ref": "#/$defs/nonNegativeInteger" },
        "schemaViolationCount": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "controlledExecutionReady",
        "dryRunReady",
        "allCasesPassed",
        "noAnswerSafetyPassed",
        "unexpectedAnswerableRowsZero",
        "publicDefaultPromotionAllowed",
        "generalRcReady",
        "semanticViolations"
      ],
      "additionalProperties": false,
      "properties": {
        "controlledExecutionReady": { "type": "boolean" },
        "dryRunReady": { "type": "boolean" },
        "allCasesPassed": { "type": "boolean" },
        "noAnswerSafetyPassed": { "type": "boolean" },
        "unexpectedAnswerableRowsZero": { "type": "boolean" },
        "publicDefaultPromotionAllowed": { "const": false },
        "generalRcReady": { "const": false },
        "semanticViolations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "executionRows": { "type": "array", "items": { "$ref": "#/$defs/executionRow" } },
    "checkRows": { "type": "array", "items": { "$ref": "#/$defs/checkRow" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
