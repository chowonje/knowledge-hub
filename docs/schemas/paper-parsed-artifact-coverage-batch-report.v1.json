{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-hub.paper.parsed-artifact-coverage-batch-report.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "generatedAt",
    "batch",
    "baseline",
    "candidatePool",
    "selectedCandidatePaperIds",
    "unselectedEligibleCandidatePaperIds",
    "nextRecommendedCoverageTranche",
    "candidates",
    "blockedMissingParsedArtifacts",
    "dryRunMaterializationReadiness",
    "expectedCoverageChangeIfApplied",
    "mutationPolicy",
    "mutationCounters",
    "dryRunMaterialization",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.parsed-artifact-coverage-batch-report.v1" },
    "status": { "type": "string", "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string" },
    "batch": {
      "type": "object",
      "required": ["name", "limit", "maxSourcePdfBytes", "selectionRule"],
      "properties": {
        "name": { "type": "string" },
        "limit": { "type": "integer", "minimum": 0 },
        "maxSourcePdfBytes": { "type": "integer", "minimum": 0 },
        "selectionRule": { "type": "string" }
      },
      "additionalProperties": true
    },
    "baseline": {
      "type": "object",
      "required": [
        "scannedPapers",
        "reportedPapers",
        "degradedPapers",
        "missingParsedArtifacts",
        "source",
        "inspectedCommandReport",
        "sqliteHashBeforeCliInspection",
        "sqliteHashAfterCliInspection",
        "sqliteHashChangedAfterCliInspection"
      ],
      "properties": {
        "scannedPapers": { "type": "integer", "minimum": 0 },
        "reportedPapers": { "type": "integer", "minimum": 0 },
        "degradedPapers": { "type": "integer", "minimum": 0 },
        "missingParsedArtifacts": { "type": "integer", "minimum": 0 },
        "source": { "type": "string" },
        "inspectedCommandReport": { "type": "object" },
        "sqliteHashBeforeCliInspection": { "type": "string" },
        "sqliteHashAfterCliInspection": { "type": "string" },
        "sqliteHashChangedAfterCliInspection": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "candidatePool": {
      "type": "object",
      "required": [
        "missingParsedArtifacts",
        "eligibleExistingPdf",
        "selectedCandidateCount",
        "unselectedEligibleExistingPdf",
        "sourceArtifactTaxonomy",
        "blockerTaxonomy"
      ],
      "properties": {
        "missingParsedArtifacts": { "type": "integer", "minimum": 0 },
        "eligibleExistingPdf": { "type": "integer", "minimum": 0 },
        "selectedCandidateCount": { "type": "integer", "minimum": 0 },
        "unselectedEligibleExistingPdf": { "type": "integer", "minimum": 0 },
        "sourceArtifactTaxonomy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason", "count"],
            "properties": {
              "reason": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": true
          }
        },
        "blockerTaxonomy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason", "count"],
            "properties": {
              "reason": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "selectedCandidatePaperIds": { "type": "array", "items": { "type": "string" } },
    "unselectedEligibleCandidatePaperIds": { "type": "array", "items": { "type": "string" } },
    "nextRecommendedCoverageTranche": {
      "type": "object",
      "required": ["candidateCount", "paperIds", "rationale"],
      "properties": {
        "candidateCount": { "type": "integer", "minimum": 0 },
        "paperIds": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" }
      },
      "additionalProperties": true
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paperId", "paperTitle", "degradationReasons", "sourceArtifact", "sourceStatus"],
        "properties": {
          "paperId": { "type": "string" },
          "paperTitle": { "type": "string" },
          "degradationReasons": { "type": "array", "items": { "type": "string" } },
          "sourceArtifact": { "$ref": "#/$defs/sourceArtifact" },
          "sourceStatus": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "blockedMissingParsedArtifacts": { "type": "array", "items": { "type": "object" } },
    "dryRunMaterializationReadiness": {
      "type": "object",
      "required": [
        "ready",
        "status",
        "counts",
        "allSelectedPlanned",
        "schemaValidation",
        "applySkippedReason"
      ],
      "properties": {
        "ready": { "type": "boolean" },
        "status": { "type": "string" },
        "counts": { "type": "object" },
        "allSelectedPlanned": { "type": "boolean" },
        "schemaValidation": {
          "type": "object",
          "required": ["ok", "errors"],
          "properties": {
            "ok": { "type": "boolean" },
            "errors": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "applySkippedReason": { "const": "report_only_no_separate_apply_approval" }
      },
      "additionalProperties": true
    },
    "expectedCoverageChangeIfApplied": {
      "type": "object",
      "required": [
        "missingParsedArtifactsBefore",
        "expectedMissingParsedArtifactsReduction",
        "expectedMissingParsedArtifactsAfter"
      ],
      "properties": {
        "missingParsedArtifactsBefore": { "type": "integer", "minimum": 0 },
        "expectedMissingParsedArtifactsReduction": { "type": "integer", "minimum": 0 },
        "expectedMissingParsedArtifactsAfter": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "mutationPolicy": {
      "type": "object",
      "required": [
        "applyRequested",
        "applyPerformed",
        "parserRouting",
        "strictEvidence",
        "citationEvidence",
        "runtimeEvidence",
        "sourceSpanCreated",
        "databaseMutation",
        "indexMutation",
        "reindexOrReembed",
        "vaultScan",
        "vaultWrite",
        "answerIntegration",
        "manualBlockerResolution"
      ],
      "properties": {
        "applyRequested": { "const": false },
        "applyPerformed": { "const": false },
        "parserRouting": { "const": false },
        "strictEvidence": { "const": false },
        "citationEvidence": { "const": false },
        "runtimeEvidence": { "const": false },
        "sourceSpanCreated": { "const": false },
        "databaseMutation": { "const": false },
        "indexMutation": { "const": false },
        "reindexOrReembed": { "const": false },
        "vaultScan": { "const": false },
        "vaultWrite": { "const": false },
        "answerIntegration": { "const": false },
        "manualBlockerResolution": { "const": false }
      },
      "additionalProperties": true
    },
    "mutationCounters": {
      "type": "object",
      "required": [
        "parsedArtifactWriteRows",
        "sourceSpanCreatedRows",
        "strictEvidenceRows",
        "citationEvidenceRows",
        "runtimeEvidenceRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reembedRows",
        "vaultReadRows",
        "vaultWriteRows",
        "answerIntegrationRows",
        "parserRoutingRows",
        "manualBlockerResolutionRows"
      ],
      "properties": {
        "parsedArtifactWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationEvidenceRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reembedRows": { "const": 0 },
        "vaultReadRows": { "const": 0 },
        "vaultWriteRows": { "const": 0 },
        "answerIntegrationRows": { "const": 0 },
        "parserRoutingRows": { "const": 0 },
        "manualBlockerResolutionRows": { "const": 0 }
      },
      "additionalProperties": true
    },
    "dryRunMaterialization": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sourceArtifact": {
      "type": "object",
      "required": ["kind", "exists", "isFile", "sizeBytes", "path"],
      "properties": {
        "kind": { "type": "string" },
        "exists": { "type": "boolean" },
        "isFile": { "type": "boolean" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
