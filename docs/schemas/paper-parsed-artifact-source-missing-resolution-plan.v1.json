{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-hub.paper.parsed-artifact-source-missing-resolution-plan.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "generatedAt",
    "plan",
    "baseline",
    "sourceBlockerSnapshot",
    "candidatePool",
    "selectedCandidatePaperIds",
    "unselectedSourcePdfMissingPaperIds",
    "sourcePdfMissingCandidates",
    "heldOutSourceBlockerPaperIdsByStatus",
    "sourcePdfMissingPaperIdsByResolutionPlanStatus",
    "dryRunMaterializationReadiness",
    "expectedCoverageChangeIfApplied",
    "nextRecommendedCoverageTranche",
    "mutationPolicy",
    "mutationCounters",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.parsed-artifact-source-missing-resolution-plan.v1" },
    "status": { "type": "string", "enum": ["planned_report_only", "no_source_pdf_missing_candidates"] },
    "generatedAt": { "type": "string" },
    "plan": {
      "type": "object",
      "required": ["name", "limit", "sourceBucket", "selectionRule", "nonScope"],
      "properties": {
        "name": { "type": "string" },
        "limit": { "type": "integer", "minimum": 0 },
        "sourceBucket": { "const": "source_pdf_missing" },
        "selectionRule": { "type": "string" },
        "nonScope": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "baseline": {
      "type": "object",
      "required": [
        "scannedPapers",
        "reportedPapers",
        "degradedPapers",
        "missingParsedArtifacts",
        "source",
        "inspectedCommandReport",
        "sqliteHashBeforeCliInspection",
        "sqliteHashAfterCliInspection",
        "sqliteHashChangedAfterCliInspection"
      ],
      "properties": {
        "scannedPapers": { "type": "integer", "minimum": 0 },
        "reportedPapers": { "type": "integer", "minimum": 0 },
        "degradedPapers": { "type": "integer", "minimum": 0 },
        "missingParsedArtifacts": { "type": "integer", "minimum": 0 },
        "source": { "type": "string" },
        "inspectedCommandReport": { "type": "object" },
        "sqliteHashBeforeCliInspection": { "type": "string" },
        "sqliteHashAfterCliInspection": { "type": "string" },
        "sqliteHashChangedAfterCliInspection": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "sourceBlockerSnapshot": {
      "type": "object",
      "required": [
        "missingParsedArtifacts",
        "sourceBlockerRows",
        "eligibleExistingPdfRows",
        "sourcePdfMissingRows",
        "heldOutSourceBlockerRows",
        "sourceArtifactTaxonomy",
        "blockerTaxonomy",
        "heldOutTaxonomy"
      ],
      "properties": {
        "missingParsedArtifacts": { "type": "integer", "minimum": 0 },
        "sourceBlockerRows": { "type": "integer", "minimum": 0 },
        "eligibleExistingPdfRows": { "type": "integer", "minimum": 0 },
        "sourcePdfMissingRows": { "type": "integer", "minimum": 0 },
        "heldOutSourceBlockerRows": { "type": "integer", "minimum": 0 },
        "sourceArtifactTaxonomy": { "$ref": "#/$defs/taxonomy" },
        "blockerTaxonomy": { "$ref": "#/$defs/taxonomy" },
        "heldOutTaxonomy": { "$ref": "#/$defs/taxonomy" }
      },
      "additionalProperties": true
    },
    "candidatePool": {
      "type": "object",
      "required": [
        "totalSourcePdfMissingRows",
        "selectedCandidateCount",
        "unselectedSourcePdfMissingRows",
        "sourceArtifactPresenceTaxonomy",
        "selectedSourceArtifactPresenceTaxonomy"
      ],
      "properties": {
        "totalSourcePdfMissingRows": { "type": "integer", "minimum": 0 },
        "selectedCandidateCount": { "type": "integer", "minimum": 0 },
        "unselectedSourcePdfMissingRows": { "type": "integer", "minimum": 0 },
        "sourceArtifactPresenceTaxonomy": { "$ref": "#/$defs/taxonomy" },
        "selectedSourceArtifactPresenceTaxonomy": { "$ref": "#/$defs/taxonomy" }
      },
      "additionalProperties": true
    },
    "selectedCandidatePaperIds": { "type": "array", "items": { "type": "string" } },
    "unselectedSourcePdfMissingPaperIds": { "type": "array", "items": { "type": "string" } },
    "sourcePdfMissingCandidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceMissingCandidate" }
    },
    "heldOutSourceBlockerPaperIdsByStatus": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/idsByStatus" }
    },
    "sourcePdfMissingPaperIdsByResolutionPlanStatus": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/idsByStatus" }
    },
    "dryRunMaterializationReadiness": {
      "type": "object",
      "required": [
        "ready",
        "dryRunAttempted",
        "status",
        "blockedReason",
        "selectedCandidateCount",
        "applySkippedReason"
      ],
      "properties": {
        "ready": { "const": false },
        "dryRunAttempted": { "const": false },
        "status": { "const": "blocked_before_materialization" },
        "blockedReason": { "type": "string" },
        "selectedCandidateCount": { "type": "integer", "minimum": 0 },
        "applySkippedReason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "expectedCoverageChangeIfApplied": {
      "type": "object",
      "required": [
        "missingParsedArtifactsBefore",
        "expectedMissingParsedArtifactsReduction",
        "expectedMissingParsedArtifactsAfter",
        "potentialMissingParsedArtifactsUnlockedAfterSeparateSourceRecovery"
      ],
      "properties": {
        "missingParsedArtifactsBefore": { "type": "integer", "minimum": 0 },
        "expectedMissingParsedArtifactsReduction": { "const": 0 },
        "expectedMissingParsedArtifactsAfter": { "type": "integer", "minimum": 0 },
        "potentialMissingParsedArtifactsUnlockedAfterSeparateSourceRecovery": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "nextRecommendedCoverageTranche": {
      "type": "object",
      "required": ["name", "candidateCount", "paperIds", "rationale"],
      "properties": {
        "name": { "type": "string" },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "paperIds": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" }
      },
      "additionalProperties": true
    },
    "mutationPolicy": {
      "type": "object",
      "required": [
        "applyRequested",
        "applyPerformed",
        "sourceDownload",
        "sourcePathRewrite",
        "sourceRegistrationMutation",
        "parsedArtifactWrite",
        "parserRouting",
        "strictEvidence",
        "citationEvidence",
        "runtimeEvidence",
        "sourceSpanCreated",
        "databaseMutation",
        "indexMutation",
        "reindexOrReembed",
        "vaultScan",
        "vaultWrite",
        "answerIntegration",
        "manualBlockerResolution"
      ],
      "properties": {
        "applyRequested": { "const": false },
        "applyPerformed": { "const": false },
        "sourceDownload": { "const": false },
        "sourcePathRewrite": { "const": false },
        "sourceRegistrationMutation": { "const": false },
        "parsedArtifactWrite": { "const": false },
        "parserRouting": { "const": false },
        "strictEvidence": { "const": false },
        "citationEvidence": { "const": false },
        "runtimeEvidence": { "const": false },
        "sourceSpanCreated": { "const": false },
        "databaseMutation": { "const": false },
        "indexMutation": { "const": false },
        "reindexOrReembed": { "const": false },
        "vaultScan": { "const": false },
        "vaultWrite": { "const": false },
        "answerIntegration": { "const": false },
        "manualBlockerResolution": { "const": false }
      },
      "additionalProperties": true
    },
    "mutationCounters": {
      "type": "object",
      "required": [
        "parsedArtifactWriteRows",
        "sourceSpanCreatedRows",
        "strictEvidenceRows",
        "citationEvidenceRows",
        "runtimeEvidenceRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reembedRows",
        "vaultReadRows",
        "vaultWriteRows",
        "answerIntegrationRows",
        "parserRoutingRows",
        "manualBlockerResolutionRows",
        "sourceDownloadRows",
        "sourcePathRewriteRows",
        "sourceRegistrationMutationRows"
      ],
      "properties": {
        "parsedArtifactWriteRows": { "const": 0 },
        "sourceSpanCreatedRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationEvidenceRows": { "const": 0 },
        "runtimeEvidenceRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reembedRows": { "const": 0 },
        "vaultReadRows": { "const": 0 },
        "vaultWriteRows": { "const": 0 },
        "answerIntegrationRows": { "const": 0 },
        "parserRoutingRows": { "const": 0 },
        "manualBlockerResolutionRows": { "const": 0 },
        "sourceDownloadRows": { "const": 0 },
        "sourcePathRewriteRows": { "const": 0 },
        "sourceRegistrationMutationRows": { "const": 0 }
      },
      "additionalProperties": true
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "taxonomy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason", "count"],
        "properties": {
          "reason": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "idsByStatus": {
      "type": "object",
      "required": ["count", "paperIds"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "paperIds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "sourceArtifact": {
      "type": "object",
      "required": ["kind", "exists", "isFile", "sizeBytes", "path"],
      "properties": {
        "kind": { "type": "string" },
        "exists": { "type": "boolean" },
        "isFile": { "type": "boolean" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" }
      },
      "additionalProperties": true
    },
    "sourceArtifactPresence": {
      "type": "object",
      "required": [
        "registeredKind",
        "registeredPathPresent",
        "localArtifactExists",
        "localArtifactIsFile",
        "localArtifactSizeBytes"
      ],
      "properties": {
        "registeredKind": { "type": "string" },
        "registeredPathPresent": { "type": "boolean" },
        "localArtifactExists": { "type": "boolean" },
        "localArtifactIsFile": { "type": "boolean" },
        "localArtifactSizeBytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "sourceMissingCandidate": {
      "type": "object",
      "required": [
        "paperId",
        "paperTitle",
        "degradationReasons",
        "sourceArtifact",
        "sourceArtifactPresence",
        "sourceStatus",
        "resolutionPlanStatus",
        "recommendedAction",
        "resolutionMode"
      ],
      "properties": {
        "paperId": { "type": "string" },
        "paperTitle": { "type": "string" },
        "degradationReasons": { "type": "array", "items": { "type": "string" } },
        "sourceArtifact": { "$ref": "#/$defs/sourceArtifact" },
        "sourceArtifactPresence": { "$ref": "#/$defs/sourceArtifactPresence" },
        "sourceStatus": { "const": "source_pdf_missing" },
        "resolutionPlanStatus": { "type": "string" },
        "recommendedAction": { "type": "string" },
        "resolutionMode": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
