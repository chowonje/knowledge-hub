{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-visual-annotation-expansion-web-batch-output-collector.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "collectorId",
    "sourceWebRunBundle",
    "targetOutput",
    "scope",
    "counts",
    "batchOutputRowsDetail",
    "operatorInstructions",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.visual-annotation-expansion-web-batch-output-collector.v1" },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": ["ready_for_combined_manual_output_validation", "blocked_missing_or_invalid_batch_outputs"]
    },
    "nextRecommendedTranche": { "const": "visual_annotation_expansion_manual_output_capture" },
    "collectorId": { "type": "string", "minLength": 1 },
    "sourceWebRunBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "reportRef", "batchRows"],
      "properties": {
        "schema": { "const": "knowledge-hub.paper.visual-annotation-expansion-web-run-bundle.v1" },
        "status": { "enum": ["ready", "blocked"] },
        "reportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
        "batchRows": { "type": "integer", "minimum": 0 }
      }
    },
    "targetOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "reportRef",
        "validationCommand",
        "allowedUse",
        "strictEvidence",
        "citationGrade",
        "answerableWithoutTextEvidence"
      ],
      "properties": {
        "schema": { "const": "knowledge-hub.paper.visual-annotation-web-output.v1" },
        "reportRef": {
          "type": "string",
          "pattern": "^eval/knowledgeos/reports/visual_annotation_expansion_web_output_[0-9]{3}\\.manual\\.json$"
        },
        "validationCommand": {
          "type": "string",
          "pattern": "^PYTHONPATH=\\. python eval/knowledgeos/scripts/validate_visual_annotation_expansion_web_output\\.py"
        },
        "allowedUse": { "const": "retrieval_hint_only" },
        "strictEvidence": { "const": false },
        "citationGrade": { "const": false },
        "answerableWithoutTextEvidence": { "const": false }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "apiCalls",
        "modelCalls",
        "webModelCalls",
        "manualOperatorWebModelRunRequired",
        "manualWebModelOutputRows",
        "combinedOutputWriteRows",
        "vectorIndexing",
        "strictEvidencePromotionRows",
        "runtimeAnswerVisibleExposureRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "externalDownloadRows",
        "answerabilityGateBypassRows",
        "cropWriteRows",
        "pageImageWriteRows",
        "wholeImageWriteRows",
        "wholeImageGptRows",
        "candidateStoreMutationRows",
        "canonicalParsedArtifactWriteRows"
      ],
      "properties": {
        "writes": { "const": "report_only" },
        "apiCalls": { "const": false },
        "modelCalls": { "const": false },
        "webModelCalls": { "const": false },
        "manualOperatorWebModelRunRequired": { "const": true },
        "manualWebModelOutputRows": { "type": "integer", "minimum": 0 },
        "combinedOutputWriteRows": { "const": 0 },
        "vectorIndexing": { "const": false },
        "strictEvidencePromotionRows": { "const": 0 },
        "runtimeAnswerVisibleExposureRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "answerabilityGateBypassRows": { "const": 0 },
        "cropWriteRows": { "const": 0 },
        "pageImageWriteRows": { "const": 0 },
        "wholeImageWriteRows": { "const": 0 },
        "wholeImageGptRows": { "const": 0 },
        "candidateStoreMutationRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedBatchRows",
        "presentBatchRows",
        "missingBatchRows",
        "validBatchRows",
        "invalidBatchRows",
        "expectedOutputRows",
        "collectedOutputRows",
        "matchedOutputRows",
        "missingSourceCandidateIdRows",
        "extraSourceCandidateIdRows",
        "duplicateSourceCandidateIdRows",
        "placeholderRows",
        "policyViolationRows",
        "privatePathLeakRows",
        "schemaViolationCount",
        "combinedOutputWriteRows",
        "blockedRows"
      ],
      "properties": {
        "expectedBatchRows": { "type": "integer", "minimum": 0 },
        "presentBatchRows": { "type": "integer", "minimum": 0 },
        "missingBatchRows": { "type": "integer", "minimum": 0 },
        "validBatchRows": { "type": "integer", "minimum": 0 },
        "invalidBatchRows": { "type": "integer", "minimum": 0 },
        "expectedOutputRows": { "type": "integer", "minimum": 0 },
        "collectedOutputRows": { "type": "integer", "minimum": 0 },
        "matchedOutputRows": { "type": "integer", "minimum": 0 },
        "missingSourceCandidateIdRows": { "type": "integer", "minimum": 0 },
        "extraSourceCandidateIdRows": { "type": "integer", "minimum": 0 },
        "duplicateSourceCandidateIdRows": { "type": "integer", "minimum": 0 },
        "placeholderRows": { "type": "integer", "minimum": 0 },
        "policyViolationRows": { "type": "integer", "minimum": 0 },
        "privatePathLeakRows": { "type": "integer", "minimum": 0 },
        "schemaViolationCount": { "type": "integer", "minimum": 0 },
        "combinedOutputWriteRows": { "const": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 }
      }
    },
    "batchOutputRowsDetail": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batchId",
          "batchNumber",
          "outputRef",
          "present",
          "expectedRows",
          "outputRows",
          "matchedRows",
          "missingRows",
          "extraRows",
          "duplicateRows",
          "placeholderRows",
          "policyViolationRows",
          "privatePathLeakRows",
          "schemaViolationCount",
          "validationStatus",
          "blockerReasons",
          "expectedSourceCandidateIds",
          "missingSourceCandidateIds",
          "extraSourceCandidateIds",
          "duplicateSourceCandidateIds",
          "placeholderSourceCandidateIds"
        ],
        "properties": {
          "batchId": { "type": "string", "minLength": 1 },
          "batchNumber": { "type": "integer", "minimum": 1 },
          "outputRef": {
            "type": "string",
            "pattern": "^eval/knowledgeos/reports/visual_annotation_expansion_web_batch_outputs_002/batch_[0-9]{2}_web_output\\.manual\\.json$"
          },
          "present": { "type": "boolean" },
          "expectedRows": { "type": "integer", "minimum": 0 },
          "outputRows": { "type": "integer", "minimum": 0 },
          "matchedRows": { "type": "integer", "minimum": 0 },
          "missingRows": { "type": "integer", "minimum": 0 },
          "extraRows": { "type": "integer", "minimum": 0 },
          "duplicateRows": { "type": "integer", "minimum": 0 },
          "placeholderRows": { "type": "integer", "minimum": 0 },
          "policyViolationRows": { "type": "integer", "minimum": 0 },
          "privatePathLeakRows": { "type": "integer", "minimum": 0 },
          "schemaViolationCount": { "type": "integer", "minimum": 0 },
          "validationStatus": { "enum": ["ready", "blocked"] },
          "blockerReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "expectedSourceCandidateIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^visual-layout:" }
          },
          "missingSourceCandidateIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^visual-layout:" }
          },
          "extraSourceCandidateIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^visual-layout:" }
          },
          "duplicateSourceCandidateIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^visual-layout:" }
          },
          "placeholderSourceCandidateIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^visual-layout:" }
          }
        }
      }
    },
    "operatorInstructions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
