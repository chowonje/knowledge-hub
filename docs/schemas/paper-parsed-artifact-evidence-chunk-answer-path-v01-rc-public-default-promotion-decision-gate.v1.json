{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-hub.paper.parsed-artifact-evidence-chunk-answer-path-v01-rc-public-default-promotion-decision-gate.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "inputs",
    "policy",
    "promotionDecision",
    "counts",
    "gate",
    "checkRows",
    "nextBlockerRows",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
