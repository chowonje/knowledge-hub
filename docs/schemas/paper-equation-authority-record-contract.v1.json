{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-hub.paper.equation-authority-record-contract.v1",
  "title": "Equation Authority Record Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "input",
    "counts",
    "gate",
    "policy",
    "contractPrinciples",
    "recordSchemaContract",
    "writeTargets",
    "sampleEquationAuthorityRecord",
    "warnings",
    "inputBlockers",
    "rows"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.equation-authority-record-contract.v1" },
    "status": { "type": "string", "enum": ["ok", "blocked"] },
    "generatedAt": { "type": "string" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paperIds",
        "equationAuthorityContractDesignReportPath",
        "equationAuthorityContractDesignReportSchema",
        "equationAuthorityContractDesignReportExists",
        "equationAuthorityContractDesignReportStrictSchemaValid"
      ],
      "properties": {
        "paperIds": { "type": "array", "items": { "type": "string" } },
        "equationAuthorityContractDesignReportPath": { "type": "string" },
        "equationAuthorityContractDesignReportSchema": { "type": "string" },
        "equationAuthorityContractDesignReportExists": { "type": "boolean" },
        "equationAuthorityContractDesignReportStrictSchemaValid": { "type": "boolean" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputRows",
        "targetRows",
        "equationAuthorityRecordContracts",
        "equationAuthorityRecordSchemas",
        "plannedEquationAuthorityRecordRows",
        "equationAuthorityRecordContractCandidateOnlyRows",
        "blockedMissingContractPreviewRows",
        "blockedMissingDesignIdentityRows",
        "blockedMissingDesignHashRows",
        "blockedMissingSourceHashRows",
        "blockedAmbiguousEquationMatchRows",
        "blockedRasterOnlyEquationRows",
        "heldOutNonRecordContractBlockerRows",
        "blockedInputReportMissingRows",
        "blockedInputSchemaViolationRows",
        "executorImplementedRows",
        "authorityPolicyCreatedRows",
        "equationAuthorityRecordWrittenRows",
        "equationArtifactCreatedRows",
        "strictEvidenceCreatedRows",
        "sourceSpanMutatedRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "parserRoutingChangedRows",
        "answerIntegrationChangedRows",
        "canonicalParsedArtifactWriteRows",
        "manifestWriteRows",
        "inputBlockerCount",
        "schemaViolationCount",
        "sampleRecordSchemaValidRows",
        "sampleRecordSemanticViolationRows",
        "byRecordContractStatus",
        "byInputContractStatus",
        "byInputDesignStatus",
        "byReadinessStatus",
        "byPaper",
        "byEnvironment"
      ],
      "properties": {
        "inputRows": { "type": "integer", "minimum": 0 },
        "targetRows": { "type": "integer", "minimum": 0 },
        "equationAuthorityRecordContracts": { "const": 1 },
        "equationAuthorityRecordSchemas": { "const": 1 },
        "plannedEquationAuthorityRecordRows": { "type": "integer", "minimum": 0 },
        "equationAuthorityRecordContractCandidateOnlyRows": { "type": "integer", "minimum": 0 },
        "blockedMissingContractPreviewRows": { "type": "integer", "minimum": 0 },
        "blockedMissingDesignIdentityRows": { "type": "integer", "minimum": 0 },
        "blockedMissingDesignHashRows": { "type": "integer", "minimum": 0 },
        "blockedMissingSourceHashRows": { "type": "integer", "minimum": 0 },
        "blockedAmbiguousEquationMatchRows": { "type": "integer", "minimum": 0 },
        "blockedRasterOnlyEquationRows": { "type": "integer", "minimum": 0 },
        "heldOutNonRecordContractBlockerRows": { "type": "integer", "minimum": 0 },
        "blockedInputReportMissingRows": { "type": "integer", "minimum": 0 },
        "blockedInputSchemaViolationRows": { "type": "integer", "minimum": 0 },
        "executorImplementedRows": { "const": 0 },
        "authorityPolicyCreatedRows": { "const": 0 },
        "equationAuthorityRecordWrittenRows": { "const": 0 },
        "equationArtifactCreatedRows": { "const": 0 },
        "strictEvidenceCreatedRows": { "const": 0 },
        "sourceSpanMutatedRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "parserRoutingChangedRows": { "const": 0 },
        "answerIntegrationChangedRows": { "const": 0 },
        "canonicalParsedArtifactWriteRows": { "const": 0 },
        "manifestWriteRows": { "const": 0 },
        "inputBlockerCount": { "type": "integer", "minimum": 0 },
        "schemaViolationCount": { "type": "integer", "minimum": 0 },
        "sampleRecordSchemaValidRows": { "type": "integer", "minimum": 0 },
        "sampleRecordSemanticViolationRows": { "type": "integer", "minimum": 0 },
        "byRecordContractStatus": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byInputContractStatus": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byInputDesignStatus": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byReadinessStatus": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byPaper": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byEnvironment": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractDesignRows",
        "recordContractRows",
        "writeTargetContractsDefined",
        "equationAuthorityRecordSchemaDefined",
        "executorReady",
        "equationAuthorityRecordWriteReady",
        "equationAuthorityRecordWriteAllowed",
        "equationAuthorityPromotionReady",
        "equationArtifactCreationReady",
        "strictEvidenceReady",
        "sourceSpanMutationReady",
        "parserRoutingReady",
        "answerIntegrationReady",
        "runtimePromotionAllowed",
        "decision",
        "schemaViolations",
        "sampleRecordSemanticViolations",
        "recommendedNextTranche",
        "inputBlockers"
      ],
      "properties": {
        "contractDesignRows": { "type": "boolean" },
        "recordContractRows": { "type": "boolean" },
        "writeTargetContractsDefined": { "const": true },
        "equationAuthorityRecordSchemaDefined": { "const": true },
        "executorReady": { "const": false },
        "equationAuthorityRecordWriteReady": { "const": false },
        "equationAuthorityRecordWriteAllowed": { "const": false },
        "equationAuthorityPromotionReady": { "const": false },
        "equationArtifactCreationReady": { "const": false },
        "strictEvidenceReady": { "const": false },
        "sourceSpanMutationReady": { "const": false },
        "parserRoutingReady": { "const": false },
        "answerIntegrationReady": { "const": false },
        "runtimePromotionAllowed": { "const": false },
        "decision": { "type": "string" },
        "schemaViolations": { "type": "array", "items": { "type": "string" } },
        "sampleRecordSemanticViolations": { "type": "array", "items": { "type": "string" } },
        "recommendedNextTranche": { "type": "string" },
        "inputBlockers": { "type": "array", "items": { "$ref": "#/$defs/inputBlocker" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportOnly",
        "contractOnly",
        "classificationOnly",
        "executorImplemented",
        "authorityPolicyCreated",
        "equationAuthorityRecordWrite",
        "equationIdentityPromoted",
        "equationHashPromoted",
        "equationArtifactCreated",
        "strictEvidenceCreated",
        "sourceSpanMutation",
        "databaseMutation",
        "indexMutation",
        "vaultScan",
        "reindexOrReembed",
        "parserRoutingChanged",
        "answerIntegrationChanged",
        "canonicalParsedArtifactsWritten",
        "manifestWrite",
        "equationInterpretationAllowed"
      ],
      "properties": {
        "reportOnly": { "const": true },
        "contractOnly": { "const": true },
        "classificationOnly": { "const": true },
        "executorImplemented": { "const": false },
        "authorityPolicyCreated": { "const": false },
        "equationAuthorityRecordWrite": { "const": false },
        "equationIdentityPromoted": { "const": false },
        "equationHashPromoted": { "const": false },
        "equationArtifactCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "sourceSpanMutation": { "const": false },
        "databaseMutation": { "const": false },
        "indexMutation": { "const": false },
        "vaultScan": { "const": false },
        "reindexOrReembed": { "const": false },
        "parserRoutingChanged": { "const": false },
        "answerIntegrationChanged": { "const": false },
        "canonicalParsedArtifactsWritten": { "const": false },
        "manifestWrite": { "const": false },
        "equationInterpretationAllowed": { "const": false }
      }
    },
    "contractPrinciples": { "type": "array", "items": { "type": "string" } },
    "recordSchemaContract": {
      "type": "object",
      "required": [
        "recordSchema",
        "contractReference",
        "recordState",
        "recordDecision",
        "contractVersion",
        "requiredRecordFields",
        "idempotencyKeyFields",
        "semanticInvariants",
        "executorImplemented",
        "recordWriteAllowed"
      ],
      "properties": {
        "recordSchema": { "const": "knowledge-hub.paper.equation-authority-record.v1" },
        "contractReference": { "const": "knowledge-hub.paper.equation-authority-record-contract.v1" },
        "recordState": { "const": "record_contract_candidate_only" },
        "recordDecision": { "const": "equation_authority_record_contract_candidate_only" },
        "contractVersion": { "const": "equation_authority_record_contract_v1" },
        "requiredRecordFields": { "type": "array", "items": { "type": "string" } },
        "idempotencyKeyFields": { "type": "array", "items": { "type": "string" } },
        "semanticInvariants": { "type": "array", "items": { "type": "string" } },
        "executorImplemented": { "const": false },
        "recordWriteAllowed": { "const": false }
      },
      "additionalProperties": true
    },
    "writeTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "plannedWriteTarget",
          "contractReference",
          "equationAuthorityRecordSchema",
          "storeKind",
          "storeRootTemplate",
          "recordPathTemplate",
          "runManifestPathTemplate",
          "requiredRecordFields",
          "idempotencyKeyFields",
          "writeSemantics",
          "readbackChecks",
          "rollbackStrategy",
          "rollbackImplemented",
          "executorImplemented",
          "recordWriteAllowed",
          "authorityPolicyMutationAllowed",
          "equationArtifactCreationAllowed",
          "strictEvidenceCreationAllowed",
          "sourceSpanMutationAllowed",
          "runtimeUseAllowed",
          "parserRoutingAllowed",
          "answerIntegrationAllowed",
          "databaseMutationAllowed",
          "indexMutationAllowed",
          "vaultScanAllowed"
        ],
        "properties": {
          "plannedWriteTarget": { "const": "equation_authority_record_candidate_store" },
          "contractReference": { "const": "knowledge-hub.paper.equation-authority-record-contract.v1" },
          "equationAuthorityRecordSchema": { "const": "knowledge-hub.paper.equation-authority-record.v1" },
          "storeKind": { "const": "future_local_papers_dir_jsonl_equation_authority_store" },
          "storeRootTemplate": { "const": "{papers_dir}/structured_evidence/equation_authority" },
          "recordPathTemplate": { "const": "{papers_dir}/structured_evidence/equation_authority/{paper_id}.jsonl" },
          "runManifestPathTemplate": { "const": "{papers_dir}/structured_evidence/runs/{run_id}.json" },
          "requiredRecordFields": { "type": "array", "items": { "type": "string" } },
          "idempotencyKeyFields": { "type": "array", "items": { "type": "string" } },
          "writeSemantics": { "type": "string" },
          "readbackChecks": { "type": "array", "items": { "type": "string" } },
          "rollbackStrategy": { "type": "string" },
          "rollbackImplemented": { "const": false },
          "executorImplemented": { "const": false },
          "recordWriteAllowed": { "const": false },
          "authorityPolicyMutationAllowed": { "const": false },
          "equationArtifactCreationAllowed": { "const": false },
          "strictEvidenceCreationAllowed": { "const": false },
          "sourceSpanMutationAllowed": { "const": false },
          "runtimeUseAllowed": { "const": false },
          "parserRoutingAllowed": { "const": false },
          "answerIntegrationAllowed": { "const": false },
          "databaseMutationAllowed": { "const": false },
          "indexMutationAllowed": { "const": false },
          "vaultScanAllowed": { "const": false }
        },
        "additionalProperties": true
      }
    },
    "sampleEquationAuthorityRecord": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "inputBlockers": { "type": "array", "items": { "$ref": "#/$defs/inputBlocker" } },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/recordContractRow" } }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "equation_authority_record_contract_candidate_only",
        "blocked_missing_contract_preview",
        "blocked_missing_design_identity",
        "blocked_missing_design_hash",
        "blocked_missing_source_hash",
        "blocked_ambiguous_equation_match",
        "blocked_raster_only_equation",
        "held_out_non_record_contract_blocker",
        "blocked_input_report_missing",
        "blocked_input_schema_violation"
      ]
    },
    "inputBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputName", "inputLabel", "path", "record_contract_status", "detail"],
      "properties": {
        "inputName": { "type": "string" },
        "inputLabel": { "type": "string" },
        "path": { "type": "string" },
        "record_contract_status": { "$ref": "#/$defs/status" },
        "detail": { "type": "string" }
      }
    },
    "recordContractRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_contract_row_id",
        "candidate_type",
        "contract_design_row_id",
        "hash_identity_design_row_id",
        "readiness_audit_row_id",
        "paper_id",
        "source_candidate_id",
        "source_file",
        "equation_environment",
        "input_contract_status",
        "input_design_status",
        "readiness_status",
        "sourceContentHash",
        "equation_identity",
        "proposed_identity_design",
        "proposed_hash_design",
        "pdf_region_signal",
        "canonical_text_alignment",
        "surrounding_context",
        "ambiguity",
        "raster_image_only_blocker",
        "planned_record_contract",
        "record_schema_id",
        "planned_write_target",
        "contract_record_preview",
        "equation_authority_record_preview",
        "record_contract_status",
        "blockers",
        "recommended_action",
        "authorityPolicyCreated",
        "equationAuthorityRecordWritten",
        "equationArtifactCreated",
        "strictEvidenceCreated",
        "sourceSpanMutated",
        "databaseMutation",
        "indexMutation",
        "reindexOrReembed",
        "vaultScan",
        "parserRoutingChanged",
        "answerIntegrationChanged"
      ],
      "properties": {
        "record_contract_row_id": { "type": "string" },
        "candidate_type": { "const": "equation_authority_record_contract" },
        "contract_design_row_id": { "type": "string" },
        "hash_identity_design_row_id": { "type": "string" },
        "readiness_audit_row_id": { "type": "string" },
        "paper_id": { "type": "string" },
        "source_candidate_id": { "type": "string" },
        "source_file": { "type": "string" },
        "equation_environment": { "type": "string" },
        "input_contract_status": { "type": "string" },
        "input_design_status": { "type": "string" },
        "readiness_status": { "type": "string" },
        "sourceContentHash": { "type": "string" },
        "equation_identity": { "type": "object" },
        "proposed_identity_design": { "type": "object" },
        "proposed_hash_design": { "type": "object" },
        "pdf_region_signal": { "type": "object" },
        "canonical_text_alignment": { "type": "object" },
        "surrounding_context": { "type": "object" },
        "ambiguity": { "type": "object" },
        "raster_image_only_blocker": { "type": "boolean" },
        "planned_record_contract": { "type": "object" },
        "record_schema_id": { "const": "knowledge-hub.paper.equation-authority-record.v1" },
        "planned_write_target": { "const": "equation_authority_record_candidate_store" },
        "contract_record_preview": { "type": "object" },
        "equation_authority_record_preview": { "type": "object" },
        "record_contract_status": { "$ref": "#/$defs/status" },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "recommended_action": { "type": "string" },
        "authorityPolicyCreated": { "const": false },
        "equationAuthorityRecordWritten": { "const": false },
        "equationArtifactCreated": { "const": false },
        "strictEvidenceCreated": { "const": false },
        "sourceSpanMutated": { "const": false },
        "databaseMutation": { "const": false },
        "indexMutation": { "const": false },
        "reindexOrReembed": { "const": false },
        "vaultScan": { "const": false },
        "parserRoutingChanged": { "const": false },
        "answerIntegrationChanged": { "const": false }
      }
    }
  }
}
