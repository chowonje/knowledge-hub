{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-hub.local/schemas/paper-visual-retrieval-hint-usefulness-eval.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "generatedAt",
    "decision",
    "nextRecommendedTranche",
    "sourceLayoutCandidateReport",
    "sourceDryRunReports",
    "scope",
    "policy",
    "method",
    "counts",
    "typeSummary",
    "evalRowsDetail",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.visual-retrieval-hint-usefulness-eval.v1" },
    "status": { "enum": ["ready", "blocked"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": ["ready_for_targeted_visual_retrieval_hint_search_eval", "blocked"]
    },
    "nextRecommendedTranche": { "const": "targeted_visual_retrieval_hint_search_eval" },
    "sourceLayoutCandidateReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "candidateRows"],
      "properties": {
        "schema": { "const": "knowledge-hub.paper.visual-layout-candidate-list-report.v1" },
        "status": { "enum": ["ready", "blocked"] },
        "candidateRows": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceDryRunReports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "status", "reportRef", "dryRunRows", "blockedRows", "candidateStoreWriteRows"],
        "properties": {
          "schema": {
            "enum": [
              "knowledge-hub.paper.visual-retrieval-hint-candidate-store-dry-run.v1",
              "knowledge-hub.paper.visual-retrieval-hint-candidate-store-expansion-dry-run.v1"
            ]
          },
          "status": { "enum": ["ready", "blocked"] },
          "reportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
          "dryRunRows": { "type": "integer", "minimum": 0 },
          "blockedRows": { "type": "integer", "minimum": 0 },
          "candidateStoreWriteRows": { "const": 0 }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "apiCalls",
        "modelCalls",
        "webModelCalls",
        "inputHintRows",
        "candidateStoreWriteRows",
        "vectorIndexing",
        "indexEligibleRows",
        "runtimeVisibleRows",
        "strictEvidencePromotionRows",
        "runtimeAnswerVisibleExposureRows",
        "databaseMutationRows",
        "indexMutationRows",
        "reindexOrReembedRows",
        "vaultScanRows",
        "externalDownloadRows",
        "answerabilityGateBypassRows",
        "searchIndexQueryRows",
        "answerGenerationRows"
      ],
      "properties": {
        "writes": { "const": "report_only" },
        "apiCalls": { "const": false },
        "modelCalls": { "const": false },
        "webModelCalls": { "const": false },
        "inputHintRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "vectorIndexing": { "const": false },
        "indexEligibleRows": { "const": 0 },
        "runtimeVisibleRows": { "const": 0 },
        "strictEvidencePromotionRows": { "const": 0 },
        "runtimeAnswerVisibleExposureRows": { "const": 0 },
        "databaseMutationRows": { "const": 0 },
        "indexMutationRows": { "const": 0 },
        "reindexOrReembedRows": { "const": 0 },
        "vaultScanRows": { "const": 0 },
        "externalDownloadRows": { "const": 0 },
        "answerabilityGateBypassRows": { "const": 0 },
        "searchIndexQueryRows": { "const": 0 },
        "answerGenerationRows": { "const": 0 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evalKind",
        "allowedUse",
        "doesNotUseOperationalIndex",
        "doesNotWriteCandidateStore",
        "doesNotPromoteEvidence",
        "strictEvidence",
        "citationGrade",
        "answerableWithoutTextEvidence",
        "runtimeVisible",
        "indexEligible"
      ],
      "properties": {
        "evalKind": { "const": "in_memory_proxy_only" },
        "allowedUse": { "const": "retrieval_hint_utility_estimation_only" },
        "doesNotUseOperationalIndex": { "const": true },
        "doesNotWriteCandidateStore": { "const": true },
        "doesNotPromoteEvidence": { "const": true },
        "strictEvidence": { "const": false },
        "citationGrade": { "const": false },
        "answerableWithoutTextEvidence": { "const": false },
        "runtimeVisible": { "const": false },
        "indexEligible": { "const": false }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "limitations"],
      "properties": {
        "name": { "const": "in_memory_text_only_vs_visual_hint_lexical_proxy_v1" },
        "description": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDryRunReportRows",
        "layoutCandidateRows",
        "inputHintRows",
        "evaluatedRows",
        "highUsefulnessRows",
        "mediumUsefulnessRows",
        "lowUsefulnessRows",
        "textOnlyTop5Rows",
        "augmentedTop5Rows",
        "rankImprovedRows",
        "duplicateSourceCandidateIdRows",
        "blockedRows",
        "candidateStoreWriteRows",
        "indexEligibleRows",
        "runtimeVisibleRows",
        "strictEvidenceRows",
        "citationGradeRows",
        "answerableWithoutTextEvidenceRows",
        "privatePathLeakRows",
        "schemaViolationCount"
      ],
      "properties": {
        "sourceDryRunReportRows": { "type": "integer", "minimum": 0 },
        "layoutCandidateRows": { "type": "integer", "minimum": 0 },
        "inputHintRows": { "type": "integer", "minimum": 0 },
        "evaluatedRows": { "type": "integer", "minimum": 0 },
        "highUsefulnessRows": { "type": "integer", "minimum": 0 },
        "mediumUsefulnessRows": { "type": "integer", "minimum": 0 },
        "lowUsefulnessRows": { "type": "integer", "minimum": 0 },
        "textOnlyTop5Rows": { "type": "integer", "minimum": 0 },
        "augmentedTop5Rows": { "type": "integer", "minimum": 0 },
        "rankImprovedRows": { "type": "integer", "minimum": 0 },
        "duplicateSourceCandidateIdRows": { "type": "integer", "minimum": 0 },
        "blockedRows": { "type": "integer", "minimum": 0 },
        "candidateStoreWriteRows": { "const": 0 },
        "indexEligibleRows": { "const": 0 },
        "runtimeVisibleRows": { "const": 0 },
        "strictEvidenceRows": { "const": 0 },
        "citationGradeRows": { "const": 0 },
        "answerableWithoutTextEvidenceRows": { "const": 0 },
        "privatePathLeakRows": { "const": 0 },
        "schemaViolationCount": { "const": 0 }
      }
    },
    "typeSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateType",
          "rows",
          "highUsefulnessRows",
          "mediumUsefulnessRows",
          "lowUsefulnessRows",
          "augmentedTop5Rows",
          "textOnlyTop5Rows"
        ],
        "properties": {
          "candidateType": {
            "enum": ["figure_caption_region", "table_region", "equation_region", "layout_region", "image_region"]
          },
          "rows": { "type": "integer", "minimum": 0 },
          "highUsefulnessRows": { "type": "integer", "minimum": 0 },
          "mediumUsefulnessRows": { "type": "integer", "minimum": 0 },
          "lowUsefulnessRows": { "type": "integer", "minimum": 0 },
          "augmentedTop5Rows": { "type": "integer", "minimum": 0 },
          "textOnlyTop5Rows": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "evalRowsDetail": {
      "type": "array",
      "items": { "$ref": "#/$defs/evalRow" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceBlockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "evalRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "evalRowId",
        "hintCandidateId",
        "sourceCandidateId",
        "paperId",
        "paperRef",
        "sourceContentHash",
        "page",
        "bbox",
        "candidateType",
        "sourceDryRunReportRef",
        "textOnlyContext",
        "visualHint",
        "proxyProbe",
        "usefulness",
        "policy",
        "blockerReason"
      ],
      "properties": {
        "schema": { "const": "knowledge-hub.paper.visual-retrieval-hint-usefulness-eval-row.v1" },
        "evalRowId": { "type": "string", "pattern": "^visual-retrieval-hint-usefulness:" },
        "hintCandidateId": { "type": "string", "pattern": "^visual-retrieval-hint:" },
        "sourceCandidateId": { "type": "string", "pattern": "^visual-layout:" },
        "paperId": { "type": "string", "minLength": 1 },
        "paperRef": { "type": "string", "pattern": "^papers_dir/[^/].*" },
        "sourceContentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "page": { "type": "integer", "minimum": 1 },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "candidateType": {
          "enum": ["figure_caption_region", "table_region", "equation_region", "layout_region", "image_region"]
        },
        "sourceDryRunReportRef": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
        "textOnlyContext": {
          "type": "object",
          "additionalProperties": false,
          "required": ["charCount", "tokenCount", "hasCaptionText"],
          "properties": {
            "charCount": { "type": "integer", "minimum": 0 },
            "tokenCount": { "type": "integer", "minimum": 0 },
            "hasCaptionText": { "type": "boolean" }
          }
        },
        "visualHint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "derivedTextCharCount",
            "visibleTextCharCount",
            "retrievalKeywordCount",
            "novelRetrievalKeywordCount",
            "novelVisualTokenCount",
            "novelVisualTokenSample"
          ],
          "properties": {
            "derivedTextCharCount": { "type": "integer", "minimum": 0 },
            "visibleTextCharCount": { "type": "integer", "minimum": 0 },
            "retrievalKeywordCount": { "type": "integer", "minimum": 0 },
            "novelRetrievalKeywordCount": { "type": "integer", "minimum": 0 },
            "novelVisualTokenCount": { "type": "integer", "minimum": 0 },
            "novelVisualTokenSample": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "proxyProbe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query",
            "textOnlyRank",
            "augmentedRank",
            "rankDelta",
            "textOnlyScore",
            "augmentedScore",
            "textOnlyTop5Hit",
            "augmentedTop5Hit"
          ],
          "properties": {
            "query": { "type": "string" },
            "textOnlyRank": { "type": ["integer", "null"], "minimum": 1 },
            "augmentedRank": { "type": ["integer", "null"], "minimum": 1 },
            "rankDelta": { "type": "integer" },
            "textOnlyScore": { "type": "number" },
            "augmentedScore": { "type": "number" },
            "textOnlyTop5Hit": { "type": "boolean" },
            "augmentedTop5Hit": { "type": "boolean" }
          }
        },
        "usefulness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "recommendation", "reason"],
          "properties": {
            "tier": { "enum": ["high", "medium", "low", "blocked"] },
            "recommendation": {
              "enum": [
                "prioritize_for_targeted_search_eval",
                "include_in_targeted_search_eval",
                "hold_until_more_search_signal",
                "blocked"
              ]
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedUse",
            "strictEvidence",
            "citationGrade",
            "answerableWithoutTextEvidence",
            "runtimeVisible",
            "indexEligible"
          ],
          "properties": {
            "allowedUse": { "const": "retrieval_hint_utility_estimation_only" },
            "strictEvidence": { "const": false },
            "citationGrade": { "const": false },
            "answerableWithoutTextEvidence": { "const": false },
            "runtimeVisible": { "const": false },
            "indexEligible": { "const": false }
          }
        },
        "blockerReason": { "type": "string" }
      }
    }
  }
}
