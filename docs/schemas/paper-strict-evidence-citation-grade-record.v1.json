{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-hub.paper.strict-evidence-citation-grade-record.v1",
  "type": "object",
  "required": [
    "schema",
    "citationGradeRecordId",
    "runId",
    "plannedWriteTarget",
    "paperId",
    "artifactType",
    "strictEvidenceId",
    "sourceSpanId",
    "candidateRecordId",
    "eligibilityRecordId",
    "policyDesignRowId",
    "holdRowId",
    "citationGradePolicyVersion",
    "citationGradeDecision",
    "citationGradeState",
    "strictEvidenceInPlaceMutationAllowed",
    "eligibilityRecordInPlaceMutationAllowed",
    "sourceSpanInPlaceMutationAllowed",
    "citationGradeBooleanMutationAllowed",
    "citationGradeMutationApplied",
    "runtimeEvidence",
    "runtimeVisible",
    "idempotencyKey",
    "provenanceTrace",
    "writePolicy"
  ],
  "properties": {
    "schema": { "const": "knowledge-hub.paper.strict-evidence-citation-grade-record.v1" },
    "citationGradeRecordId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "plannedWriteTarget": { "const": "parsed_artifact_strict_evidence_citation_grade_store" },
    "paperId": { "type": "string", "minLength": 1 },
    "artifactType": { "type": "string", "enum": ["section", "figure"] },
    "strictEvidenceId": { "type": "string", "minLength": 1 },
    "sourceSpanId": { "type": "string", "minLength": 1 },
    "candidateRecordId": { "type": "string", "minLength": 1 },
    "eligibilityRecordId": { "type": "string", "minLength": 1 },
    "policyDesignRowId": { "type": "string", "minLength": 1 },
    "holdRowId": { "type": "string", "minLength": 1 },
    "citationGradePolicyVersion": { "const": "strict_evidence_citation_grade_policy.v1" },
    "citationGradeDecision": { "const": "citation_grade_policy_candidate_only" },
    "citationGradeState": { "const": "citation_grade_candidate_only" },
    "strictEvidenceInPlaceMutationAllowed": { "const": false },
    "eligibilityRecordInPlaceMutationAllowed": { "const": false },
    "sourceSpanInPlaceMutationAllowed": { "const": false },
    "citationGradeBooleanMutationAllowed": { "const": false },
    "citationGradeMutationApplied": { "const": false },
    "runtimeEvidence": { "const": false },
    "runtimeVisible": { "const": false },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "provenanceTrace": {
      "type": "object",
      "required": [
        "strictEvidenceId",
        "sourceSpanId",
        "candidateRecordId",
        "eligibilityRecordId",
        "policyDesignRowId",
        "holdRowId"
      ],
      "properties": {
        "strictEvidenceId": { "type": "string", "minLength": 1 },
        "sourceSpanId": { "type": "string", "minLength": 1 },
        "candidateRecordId": { "type": "string", "minLength": 1 },
        "eligibilityRecordId": { "type": "string", "minLength": 1 },
        "policyDesignRowId": { "type": "string", "minLength": 1 },
        "holdRowId": { "type": "string", "minLength": 1 },
        "citationGradePolicyDesignStatus": { "type": "string" }
      },
      "additionalProperties": true
    },
    "writePolicy": {
      "type": "object",
      "required": [
        "executorRequired",
        "citationGradeRecordWrite",
        "citationGradeBooleanMutation",
        "eligibilityRecordWrite",
        "strictEvidenceStoreWrite",
        "sourceSpanStoreWrite",
        "strictEligibleMutation",
        "runtimeEvidenceCreated",
        "databaseMutation",
        "parserRoutingChanged",
        "answerIntegrationChanged",
        "reindexOrReembed",
        "canonicalParsedArtifactsWritten",
        "manifestWrite"
      ],
      "properties": {
        "executorRequired": { "const": true },
        "citationGradeRecordWrite": { "const": false },
        "citationGradeBooleanMutation": { "const": false },
        "eligibilityRecordWrite": { "const": false },
        "strictEvidenceStoreWrite": { "const": false },
        "sourceSpanStoreWrite": { "const": false },
        "strictEligibleMutation": { "const": false },
        "runtimeEvidenceCreated": { "const": false },
        "databaseMutation": { "const": false },
        "parserRoutingChanged": { "const": false },
        "answerIntegrationChanged": { "const": false },
        "reindexOrReembed": { "const": false },
        "canonicalParsedArtifactsWritten": { "const": false },
        "manifestWrite": { "const": false }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
